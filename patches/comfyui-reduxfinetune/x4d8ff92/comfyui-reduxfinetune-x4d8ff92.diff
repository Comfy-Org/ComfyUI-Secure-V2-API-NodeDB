-    elif mode == "Max":
-        return _basic_fusion(image_feat, text_feat, strength, region_size, "max")
-    elif mode == "Min":
-        return _basic_fusion(image_feat, text_feat, strength, region_size, "min")
-    elif mode == "Random":
