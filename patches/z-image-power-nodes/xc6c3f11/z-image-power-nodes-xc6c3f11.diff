+_ALLOWED_DIALOG_SIZES      = ("small", "default")
+_ALLOWED_DIALOG_VIEW_MODES = ("grid", "list")
+
+def _get_styles_endpoint(version: str) -> str:
+    return f"/zi_power/styles/by_version?v={version}"
