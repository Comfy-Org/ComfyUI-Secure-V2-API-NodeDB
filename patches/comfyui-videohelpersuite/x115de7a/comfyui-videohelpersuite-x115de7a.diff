+            "video/h265-mp4": ("mp4", "hevc"),
+            "video/nvenc_h264-mp4": ("mp4", "h264_nvenc"),
+            "video/nvenc_hevc-mp4": ("mp4", "hevc_nvenc"),
+            "video/nvenc_av1-mp4": ("mp4", "av1_nvenc"),
+            "video/av1-webm": ("webm", "av1"),
+            "video/webm": ("webm", "vp9"),
