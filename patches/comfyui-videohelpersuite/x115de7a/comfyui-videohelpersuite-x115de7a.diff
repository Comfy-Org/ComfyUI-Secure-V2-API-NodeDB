+def _validate_index(index, length, *, is_range=False, allow_negative=False,
+                    allow_missing=False):
+    if index < 0 and allow_negative:
+        index = length + index
+    maximum = length if is_range else length - 1
+    if length and (index < 0 or index > maximum) and not allow_missing:
+        raise IndexError(f"Index '{index}' is out of range for {length} item(s).")
+    return index
+
+
+def _index_int(raw, length=0, *, is_range=False, allow_negative=False,
+               allow_missing=False):
+    try:
+        value = int(raw)
+    except ValueError as exc:
+        raise ValueError(f"Index '{raw}' must be an integer.") from exc
+    return _validate_index(
+        value,
+        length,
+        is_range=is_range,
+        allow_negative=allow_negative,
+        allow_missing=allow_missing,
+    )
+
+
+def convert_str_to_indexes(indexes_str, length=0, allow_missing=False):
+    if not indexes_str:
+        return []
+    available = list(range(length))
+    selected = []
+    for group in (item.strip() for item in indexes_str.split(",")):
+        if ":" not in group:
+            selected.append(_index_int(
+                group,
+                length,
+                allow_negative=length > 0,
+                allow_missing=allow_missing,
+            ))
+            continue
+        fields = [item.strip() for item in group.split(":", 2)]
+        start = _index_int(
+            fields[0], length, is_range=True, allow_negative=length > 0,
+            allow_missing=allow_missing,
+        ) if fields[0] else 0
+        end = _index_int(
+            fields[1], length, is_range=True, allow_negative=length > 0,
+            allow_missing=allow_missing,
+        ) if fields[1] else length
+        step = _index_int(
+            fields[2], length, is_range=True, allow_negative=True,
+            allow_missing=True,
+        ) if len(fields) > 2 and fields[2] else 1
+        if step == 0:
+            raise ValueError("Index range step cannot be zero.")
+        selected.extend(
+            available[start:end][::step]
+            if available else range(start, end, step)
+        )
+    return selected
+
+
+def select_indexes(value, indexes):
+    return value[indexes] if type(value) is Tensor else [value[i] for i in indexes]
+
+
+def select_indexes_from_str(value=None, indexes="", err_if_missing=True,
+                            err_if_empty=True, input_obj=None):
+    value = input_obj if input_obj is not None else value
+    selected = convert_str_to_indexes(
+        indexes, len(value), allow_missing=not err_if_missing)
+    if err_if_empty and not selected:
+        raise ValueError(f"Nothing was selected based on indexes found in '{indexes}'.")
+    return select_indexes(value, selected)
