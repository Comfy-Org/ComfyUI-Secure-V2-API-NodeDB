+   * same `Omit`, so the argument made for them holds verbatim: a pack that
+   * shaped its slots and then stopped saves different bytes than it used to.
+   *
+   * `'default'` clears it back to the renderer's own choice.
+   */
+  shape?: SlotShape
+}
