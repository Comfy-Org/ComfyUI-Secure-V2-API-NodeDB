+def error_of(error):
+    kind = getattr(error, "remote_type", None) or type(error).__name__
+    message = str(error)
+    for prefix in (f"{kind}: ",):
+        while message.startswith(prefix):
+            message = message[len(prefix):]
+    return kind, message.strip()
