+export function applyRotation(panels, rotation) {
+    const transform = {
+        "0": ([x, y]) => [x, y],
+        "90": ([x, y]) => [1 - y, x],
+        "180": ([x, y]) => [1 - x, 1 - y],
+        "270": ([x, y]) => [y, 1 - x],
+    }[String(rotation)] ?? ((point) => point);
+    return panels.map((polygon) => polygon.map(transform));
