+    work = _work.get()
+    if work is None:
+        raise RuntimeError("silence work scope required")
+    windows = max(0, len(segment) - min_silence_len + 1)
+    charged = windows * math.ceil(min_silence_len * segment.frame_rate / 1000) * segment.channels
