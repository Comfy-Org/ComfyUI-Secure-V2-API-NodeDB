+         "BOOLEAN": io.Boolean, "IMAGE": io.Image, "AUDIO": io.Audio,
+         "*": io.AnyType, "TK_IMAGE_LIST": io.Custom("TK_IMAGE_LIST"),
+         "TK_IMAGE_PROMPT_LIST": io.Custom("TK_IMAGE_PROMPT_LIST")}
