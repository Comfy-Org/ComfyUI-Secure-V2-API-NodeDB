+                "dissolve_min_len": ("INT", {"default": 5, "min": 2, "max": 60}),
+                "analysis_width": ("INT", {"default": 160, "min": 64, "max": 640}),
+                "debug_mode": ("BOOLEAN", {"default": False}),
