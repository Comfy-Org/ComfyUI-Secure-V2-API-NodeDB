+NODE_CLASS_MAPPINGS = {node_id: make(source, node_id) for node_id, source in SOURCES.items()}
+NODE_DISPLAY_NAME_MAPPINGS = dict(_algorithms.NODE_DISPLAY_NAME_MAPPINGS)
