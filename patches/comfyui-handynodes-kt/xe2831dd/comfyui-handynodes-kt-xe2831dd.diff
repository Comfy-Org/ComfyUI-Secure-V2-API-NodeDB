+
+    RETURN_TYPES = ("STRING", "INT", "STRING", "INT", "STRING")
+    RETURN_NAMES = ("boundaries_json", "boundary_count", "report", "boundary_frames", "debug_csv")
+    OUTPUT_IS_LIST = (False, False, False, True, False)
+    FUNCTION = "run"
+    CATEGORY = "TKNodes/video"
+
+    def run(
+        self,
+        images,
+        fps,
+        max_segment_seconds,
+        cut_z_thresh,
+        dissolve_dip_ratio,
+        dissolve_min_len,
+        analysis_width,
+        debug_mode,
+    ):
