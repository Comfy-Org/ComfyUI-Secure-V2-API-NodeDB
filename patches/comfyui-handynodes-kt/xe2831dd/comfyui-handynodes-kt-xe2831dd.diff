+  /** Explicit, bounded host file selection, upload, and download. */
+  readonly files: FilesHandle
+  /** Host-owned bounded media decode, sampling, and playback. */
+  readonly media: MediaHandle
+  /** User-gesture-scoped clipboard access. */
