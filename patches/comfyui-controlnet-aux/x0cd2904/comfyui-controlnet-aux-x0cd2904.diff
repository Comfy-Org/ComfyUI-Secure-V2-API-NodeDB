+                'device_correspondence_sha256', 'current_invocation_admission_sha256',
+                'restricted_vendor_source_evidence_sha256', 'fixed_crop_workspace_admission_sha256', 'internal_device_policy_sha256'):
+        if not digest(item.get(key)):
