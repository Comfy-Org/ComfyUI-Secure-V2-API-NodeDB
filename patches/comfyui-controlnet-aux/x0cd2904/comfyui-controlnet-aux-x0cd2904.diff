+BODY_PART_DEFAULT_W_H = {'Head': '256, 256', 'Neck': '100, 100', 'Shoulder': '', 'Torso': '350, 450', 'RArm': '128, 256', 'RForearm': '128, 256', 'LArm': '128, 256', 'LForearm': '128, 256', 'RThigh': '128, 256', 'RLeg': '128, 256', 'LThigh': '128, 256', 'LLeg': '128, 256'}
