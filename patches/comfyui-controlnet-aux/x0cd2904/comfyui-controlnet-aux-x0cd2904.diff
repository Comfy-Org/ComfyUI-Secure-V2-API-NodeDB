+            pts = pose[BODY_PART_INDEXES[part_name], :]
+            x_mid, y_mid = (np.mean(pts[:, 0]), np.mean(pts[:, 1]))
+            xyxy_bboxes[idx] = (x_mid - width / 2, y_mid - height / 2, x_mid + width / 2, y_mid + height / 2)
