+         [0.375 / 3.0, 0.75 / 3.0, 116, 173, 209],
+         [0.75 / 3.0, 1.5 / 3.0, 171, 217, 233],
+         [1.5 / 3.0, 3 / 3.0, 224, 243, 248],
+         [3 / 3.0, 6 / 3.0, 254, 224, 144],
