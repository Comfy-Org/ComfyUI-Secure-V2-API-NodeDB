+        self.window_size2 = window_size2
+        self.avgpool_q = nn.AvgPool2d(kernel_size=window_size1)
+        self.avgpool_k = nn.AvgPool2d(kernel_size=window_size2)
+        self.softmax = nn.Softmax(dim=-1)
+        self.nhead = nhead
