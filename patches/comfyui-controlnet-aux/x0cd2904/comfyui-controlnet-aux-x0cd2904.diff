+            # flow or residual flow
+            flow = flow + flow_pred if flow is not None else flow_pred
+
+            if task == 'stereo':
+                flow = flow.clamp(min=0)  # positive disparity
+
+            # upsample to the original resolution for supervison at training time only
+            if self.training:
