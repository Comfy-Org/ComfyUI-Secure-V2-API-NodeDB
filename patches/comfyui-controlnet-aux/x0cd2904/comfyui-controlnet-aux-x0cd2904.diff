+    exec(compile(ast.fix_missing_locations(ast.Module(body=[annotator, cls], type_ignores=[])),
+                 str(PRISTINE / 'node_wrappers/openpose.py'), 'exec'), ns)
+    return ns['OpenPose_Preprocessor']()
