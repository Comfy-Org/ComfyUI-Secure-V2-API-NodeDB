+class MediapipeFaceDetector:
+    def __call__(self,
+                 input_image: Union[np.ndarray, Image.Image] = None,
+                 max_faces: int = 1,
+                 min_confidence: float = 0.5,
+                 output_type: str = "pil",
+                 detect_resolution: int = 512,
+                 image_resolution: int = 512,
+                 upscale_method="INTER_CUBIC",
+                 **kwargs):
+
