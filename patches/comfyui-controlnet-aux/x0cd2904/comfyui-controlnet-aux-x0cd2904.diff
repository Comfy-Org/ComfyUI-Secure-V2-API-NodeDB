+        # noise_pred = noise_pred / torch.sqrt(1 - t)
+        x_rec = self.pred_x0_from_xt(x_noisy, noise_pred, C_pred, t)       # x_rec:(B, 1, H, W)
+        loss_dict = {}
+        prefix = 'train'
+
+        # elif self.objective == 'pred_KC':
