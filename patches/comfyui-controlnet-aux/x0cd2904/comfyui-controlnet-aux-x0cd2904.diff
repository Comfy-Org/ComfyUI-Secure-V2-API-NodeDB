+            simple_weight2 = 1
+
+        loss_simple += simple_weight1 * self.get_loss(C_pred, target1, mean=False).mean([1, 2, 3]) + \
+                       simple_weight2 * self.get_loss(noise_pred, target2, mean=False).mean([1, 2, 3])
