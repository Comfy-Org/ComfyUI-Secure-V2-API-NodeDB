+
+export interface GraphHandle {
+  readonly id: string
+  node(id: string): NodeHandle | undefined
+  nodes(): readonly NodeHandle[]
+  nodesOfType(type: string): readonly NodeHandle[]
+  /**
+   * One flat query over graph-scoped nodes.
