+        values = locals()
+        return await _wanvideo_execute(
+            base_high=base_high,
+            lightning_high=lightning_high,
+            lightning_low=lightning_low,
+            image_embeds=image_embeds,
+            seed=int(seed),
+            sigma_shift=float(sigma_shift),
+            base_quality_threshold=int(base_quality_threshold),
