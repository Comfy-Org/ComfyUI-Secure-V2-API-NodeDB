+  /** Backend input type, or the choices for a COMBO input. */
+  readonly type: string | readonly (string | number)[]
+  readonly options?: Readonly<Record<string, unknown>>
+}
+
+/** @knipIgnoreUnusedButUsedByCustomNodes */
