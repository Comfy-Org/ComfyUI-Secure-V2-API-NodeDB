+  readonly inputs: SlotCollection<InputSlotHandle>
+  readonly outputs: SlotCollection<OutputSlotHandle>
+  readonly widgets: WidgetCollection
+  snapshot(): Readonly<NodeSnapshot> | undefined
+  remove(): void
+}
