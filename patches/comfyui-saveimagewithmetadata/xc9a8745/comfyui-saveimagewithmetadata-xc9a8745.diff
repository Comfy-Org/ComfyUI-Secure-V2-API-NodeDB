+for key, exts in (('checkpoints', {'.safetensors', '.ckpt'}), ('loras', {'.safetensors'}),
+                  ('vae', {'.safetensors'}), ('embeddings', {'.pt', '.safetensors', '.bin'}),
+                  ('upscale_models', {'.pth', '.safetensors'}), ('diffusion_models', {'.safetensors'}),
