+
+            const link = output.connectTo(supply.to.nodeId, { index:supply.to.input })
+            if (!link) {
+                state.failed = true
+                converted.failed++
+                Logger.log_problem(`Failed to connect ${supply.from.nodeId}[${supply.from.output}] -> ${supply.to.nodeId}[${supply.to.input}]`)
