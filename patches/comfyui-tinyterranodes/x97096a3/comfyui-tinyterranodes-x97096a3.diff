+class ttNl:
+    def __init__(self, input_string):
+        self.header_value = f'{CC.LIGHTGREEN}[ttN] {CC.GREEN}'
+        self.label_value = ''
+        self.title_value = ''
+        self.input_string = f'{input_string}{CC.CLEAN}'
