_eta","EDM_s_churn":"EDM_s_churn","cfg_scale_end":"结束CFG缩放","cfg_scale_start":"起始CFG缩放","control_before_generate":"运行前操作","control_scale_end":"结束控制缩放","control_scale_start":"起始控制缩放","keep_model_loaded":"保持模型加载","restore_cfg":"恢复CFG","s_noise":"噪波量","sampler":"采样器","sampler_tile_size":"采样器分块尺寸","sampler_tile_stride":"采样器分块步长","seed":"随机种","steps":"步数"}},"SUPIR_tiles":{"description":"使用 分块采样器 的方法分块图像。\n\n用于预览分块和反推每个分块（这个功能还在开发）。","inputs":{"image":"图像"},"outputs":{"image_tiles":"分块图像","tile_size":"分块尺寸","tile_stride":"分块步长"},"title":"SUPIR分块图像","widgets":{"tile_size":"分块尺寸","tile_stride":"分块步长"}},"SV3D_BatchSchedule":{"description":"使用插值调度安排 SV3D 的方位角和俯仰角数值。\n\n注意 SV3D 是视频模型，所以调度值必须递进。\n\nhttps://huggingface.co/stabilityai/sv3d","inputs":{"clip_vision":"CLIP视觉","init_image":"图像","vae":"VAE"},"outputs":{"latent":"Latent","negative":"负面条件","positive":"正面条件"},"title":"SV3D_批次调度","widgets":{"azimuth_points_string":"方位角","batch_size":"批次大小","elevation_points_string":"俯仰角","height":"高度","interpolation":"插值方式","width":"宽度"}},"SV3D_Conditioning":{"inputs":{"clip_vision":"CLIP视觉","init_image":"图像","vae":"VAE"},"outputs":{"latent":"Latent","negative":"负面条件","positive":"正面条件"},"title":"SV3D_条件","widgets":{"elevation":"俯仰角","height":"高度","video_frames":"帧数","width":"宽度"}},"SVD_img2vid_Conditioning":{"inputs":{"VAE":"VAE","clip_vision":"CLIP视觉","init_image":"图像"},"outputs":{"latent":"Latent","negative":"负面条件","positive":"正面条件"},"title":"SVD_图像到视频_条件","widgets":{"augmentation_level":"增强","fps":"帧率","height":"高度","motion_bucket_id":"动态bucketID","video_frames":"帧数","width":"宽度"}},"Sam2AutoSegmentation":{"inputs":{"image":"图像","sam2_model":"SAM2"},"outputs":{"bbox":"BBox","mask":"遮罩","segmented_image":"图像"},"title":"SAM2 自动分割","widgets":{"box_nms_thres":"box_nms_thres","crop_n_layers":"裁剪迭代层数","crop_n_points_downscale_factor":"crop_n_points_downscale_factor","crop_nms_thres":"crop_nms_thres","crop_overlap_ratio":"crop_overlap_ratio","keep_model_loaded":"保持模型加载","mask_threshold":"遮罩阈值"