+    INPUT_IS_LIST = True
+    OUTPUT_IS_LIST = (True,)
+
+    def filter_data(self, **kwargs: list[Any]) -> tuple[list[Any]]:
+        values = kwargs.get('value', [])
+        filters = kwargs.get('filter', [])
+
+        # Create a new list with only items where the filter is False
