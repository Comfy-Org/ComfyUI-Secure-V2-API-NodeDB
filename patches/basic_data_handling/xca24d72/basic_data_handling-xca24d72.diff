+  for (const slot of node.inputs.all()) {
+    const match = templateFor(slot.name, templates);
+    if (!match) continue;
+    let item = result.get(match.suffix);
+    if (!item) {
+      item = { suffix: match.suffix, slots: [], active: false };
+      result.set(match.suffix, item);
+    }
