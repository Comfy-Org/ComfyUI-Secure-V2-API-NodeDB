+  items.forEach((item, index) => {
+    for (const { slot, template } of item.slots) {
+      const next = nameFor(template, index);
+      if (slot.name === next) continue;
+      if (template.widget) renameWidget(node, template, slot.name, next);
+      slot.modify({
