+            guide, -1, (size, size), normalize=True,
+            borderType=cv2.BORDER_REFLECT)
+        mean_source = cv2.boxFilter(
+            source, -1, (size, size), normalize=True,
+            borderType=cv2.BORDER_REFLECT)
