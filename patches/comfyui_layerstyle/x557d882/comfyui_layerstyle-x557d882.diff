-    # If preserve_luminosity is True, adjust the RGB values to match the original luminance
-    if preserve_luminosity:
-        current_luminance = 0.2126 * img_copy[..., 0] + 0.7152 * img_copy[..., 1] + 0.0722 * img_copy[..., 2]
