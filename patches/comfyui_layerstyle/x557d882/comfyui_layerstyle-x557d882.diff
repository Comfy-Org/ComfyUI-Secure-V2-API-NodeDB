-    from colour.io.luts.lut import LUT3x1D, LUT3D
-    title = re.sub("_|-|\\.", " ", os.path.splitext(os.path.basename(path))[0])
-    domain_min, domain_max = np.array([0, 0, 0]), np.array([1, 1, 1])
