+class _CubeLUT:
+    """Small Iridas .cube evaluator used by the pack's LUT node."""
+
+    def __init__(self, table, title, domain, comments, dimensions):
+        self.table = np.asarray(table, dtype=np.float32)
+        self.title = title
+        self.domain = np.asarray(domain, dtype=np.float32)
+        self.comments = comments
+        self.dimensions = dimensions
+        self.name = title
+
+    def apply(self, values):
+        values = np.asarray(values, dtype=np.float32)
+        scale = self.domain[1] - self.domain[0]
+        scale = np.where(scale == 0, 1.0, scale)
+        normalized = np.clip(
+            (values[..., :3] - self.domain[0]) / scale, 0.0, 1.0
+        )
+        size = self.table.shape[0]
+        position = normalized * (size - 1)
+        low = np.floor(position).astype(np.int64)
+        high = np.minimum(low + 1, size - 1)
+        fraction = position - low
+
+        if self.dimensions == 1:
+            result = np.empty_like(normalized)
+            for channel in range(3):
+                result[..., channel] = (
+                    self.table[low[..., channel], channel]
+                    * (1.0 - fraction[..., channel])
+                    + self.table[high[..., channel], channel]
+                    * fraction[..., channel]
+                )
+            return result
+
+        r0, g0, b0 = (low[..., index] for index in range(3))
+        r1, g1, b1 = (high[..., index] for index in range(3))
+        rf, gf, bf = (fraction[..., index, None] for index in range(3))
+        c000 = self.table[r0, g0, b0]
+        c100 = self.table[r1, g0, b0]
+        c010 = self.table[r0, g1, b0]
+        c110 = self.table[r1, g1, b0]
+        c001 = self.table[r0, g0, b1]
+        c101 = self.table[r1, g0, b1]
+        c011 = self.table[r0, g1, b1]
+        c111 = self.table[r1, g1, b1]
+        c00 = c000 * (1.0 - rf) + c100 * rf
+        c10 = c010 * (1.0 - rf) + c110 * rf
+        c01 = c001 * (1.0 - rf) + c101 * rf
+        c11 = c011 * (1.0 - rf) + c111 * rf
+        c0 = c00 * (1.0 - gf) + c10 * gf
+        c1 = c01 * (1.0 - gf) + c11 * gf
+        return c0 * (1.0 - bf) + c1 * bf
