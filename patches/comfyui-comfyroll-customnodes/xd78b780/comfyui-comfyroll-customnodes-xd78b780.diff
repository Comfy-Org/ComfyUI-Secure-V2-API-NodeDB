+            rescaled_img = apply_resize_image(tensor2pil(img), original_width, original_height, 8, 'rescale', 'false', rescale_factor, 256, 'lanczos')
+            outlined_img = ImageOps.expand(rescaled_img, outline_thickness, fill='black')
