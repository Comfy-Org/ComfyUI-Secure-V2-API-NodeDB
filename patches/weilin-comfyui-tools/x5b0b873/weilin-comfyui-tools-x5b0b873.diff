+
+
+def prompt_stack(lora_str):
+    return {'1': {'class_type': 'CheckpointLoaderSimple', 'inputs': {'ckpt_name': 'test-ckpt.safetensors'}},
+            '2': {'class_type': 'WeiLinPromptUIOnlyLoraStack', 'inputs': {
