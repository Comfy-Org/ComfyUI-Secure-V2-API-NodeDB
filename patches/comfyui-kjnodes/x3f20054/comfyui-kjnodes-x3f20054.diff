-            feats = torch.stack([
-                rgb_m[0], rgb_m[1], rgb_m[2],
-                rgb_s[0], rgb_s[1], rgb_s[2],
-                rgb_m[0] * rgb_m[1], rgb_m[0] * rgb_m[2], rgb_m[1] * rgb_m[2],
-                one,
-            ])
-            bias = feats @ coef  # (3,)
-            return denoised - strength * bias.view(1, 3, 1, 1)
-
-        m = model.clone()
-        m.set_model_sampler_post_cfg_function(pid_bias_post_cfg)
-        return (m,)
