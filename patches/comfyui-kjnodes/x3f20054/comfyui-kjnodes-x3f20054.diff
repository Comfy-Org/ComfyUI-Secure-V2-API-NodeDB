-    context_img = context[:, :context_img_len]
-    context = context[:, context_img_len:]
-
-    q = self.norm_q(self.q(x)).view(b, s, n, d)
-    k_img = self.norm_k_img(self.k_img(context_img)).view(b, -1, n, d)
