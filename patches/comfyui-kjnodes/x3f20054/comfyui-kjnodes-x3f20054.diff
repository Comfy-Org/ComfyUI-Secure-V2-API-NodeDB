-    @classmethod
-    def execute(cls, vae_1, vae_2, ratio) -> io.NodeOutput:
-        from comfy.sd import VAE
-        sd1 = vae_1.get_sd()
-        sd2 = vae_2.get_sd()
-
-        mismatch = set(sd1.keys()) ^ set(sd2.keys())
-        if mismatch:
-            raise ValueError(
-                "Cannot merge: VAE architectures differ ({} non-matching keys, e.g. {}).".format(
