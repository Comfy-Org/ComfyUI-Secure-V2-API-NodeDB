-def ease_in(t):
-    return t * t
-def ease_out(t):
-    return 1 - (1 - t) * (1 - t)
-def ease_in_out(t):
-    return 3 * t * t - 2 * t * t * t
-def bounce(t):
-    if t < 0.5:
-        return ease_out(t * 2) * 0.5
-    else:
-        return ease_in((t - 0.5) * 2) * 0.5 + 0.5
-def elastic(t):
-    return math.sin(13 * math.pi / 2 * t) * math.pow(2, 10 * (t - 1))
-def glitchy(t):
-    return t + 0.1 * math.sin(40 * t)
-def exponential_ease_out(t):
-    return 1 - (1 - t) ** 4
