-#                    R_mean*G_mean, R_mean*B_mean, G_mean*B_mean, intercept(1.0)]
-# Columns: predicted bias for R, G, B (subtract from x0_pred at step 0).
-PID_BIAS_COEF_FLUX2 = torch.tensor([
-    [-0.130306, +0.127184, +0.014058],  # R_mean
