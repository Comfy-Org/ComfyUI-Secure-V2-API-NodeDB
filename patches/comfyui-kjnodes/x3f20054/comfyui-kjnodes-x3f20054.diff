-
-        new_image[:, top:top + H, left:left + W, :] = image
-
-        if mask is None:
-            new_mask = torch.ones(
-                (B, H + top + bottom, W + left + right),
-                dtype=torch.float32,
-            )
-
-            t = torch.zeros(
