+        if want != got:
+            row["mismatches"] += 1
+            mismatches.append({"case": case, "original": want, "v2": got})
+    for row in by_node.values():
+        row["verdict"] = "EXACT" if not row["mismatches"] else "MISMATCH"
+    return by_node, mismatches, designed
+
+
+def main(argv):
