+
+def compare(plan, original, v2):
+    by_node, mismatches, designed = {}, [], []
+    for case, want, got in zip(plan, original, v2, strict=True):
+        row = by_node.setdefault(case["node"], {"cases": 0, "mismatches": 0, "errors": 0, "designed": 0})
