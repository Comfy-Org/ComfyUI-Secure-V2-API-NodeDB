+class ColorTransfer:
+    """ Methods for color transfer of images. """
+
+    def __init__(self, eps=1e-6, m=6, c=3):
+        """Hyper parameters.
+
+        Attributes:
+            c: dim of rotation matrix, 3 for oridnary img.
+            m: num of random orthogonal rotation matrices.
