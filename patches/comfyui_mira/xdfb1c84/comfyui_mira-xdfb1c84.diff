+    parity = {"status": "PASS" if ok else "FAIL", "pack": PACK_ID, "pin": "dfb1c847097cf1f69055c46c24b723a5a55f2e09",
+              "cases": len(plan), "nodes": by_node, "designed_refusals": designed,
