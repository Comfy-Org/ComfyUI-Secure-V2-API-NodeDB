+    keys = {"Prompt": "prompt", "Workflow": "workflow", "Fileinfo": "fileinfo"}
+    key = keys.get(str(what), "fileinfo")
+    diff = json.dumps(
+        _diff_json(metadata_raw_old.get(key, {}), metadata_raw_new.get(key, {})),
+        indent=2,
