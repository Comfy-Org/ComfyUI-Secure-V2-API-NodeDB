+def _nested_value(data: Any, key: str, default: Any) -> Any:
+    value = data
+    for part in str(key).split("."):
+        if isinstance(value, str):
+            try:
+                value = json.loads(value)
+            except json.JSONDecodeError:
+                return default
+        if not isinstance(value, dict) or part not in value:
+            return default
+        value = value[part]
+    return value
