+def main():
+    cases = json.loads(Path(CASES).read_text())
+    report = {'side': SIDE, 'loaded': bool(loaded), 'pack_path': pack_path, 'output_dir': str(OUTPUT),
+              'pack_ids': PACK_IDS, 'schemas': {node_id: schema_of(node_id) for node_id in PACK_IDS}, 'cases': []}
+    for case in cases:
