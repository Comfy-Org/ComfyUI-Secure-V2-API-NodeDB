+def _parse_color(value: str) -> torch.Tensor:
+    names = {
+        "black": (0, 0, 0),
+        "white": (255, 255, 255),
+        "red": (255, 0, 0),
+        "green": (0, 128, 0),
+        "blue": (0, 0, 255),
+        "yellow": (255, 255, 0),
+        "cyan": (0, 255, 255),
+        "magenta": (255, 0, 255),
+        "gray": (128, 128, 128),
+        "grey": (128, 128, 128),
+        "silver": (192, 192, 192),
+        "orange": (255, 165, 0),
+        "purple": (128, 0, 128),
+        "pink": (255, 192, 203),
+    }
+    text = str(value or "").strip().lower()
+    if text in names:
+        values = names[text]
+    elif text.startswith(("#", "0x")):
+        raw = text[2:] if text.startswith("0x") else text[1:]
+        if len(raw) == 3:
+            raw = "".join(ch * 2 for ch in raw)
+        if len(raw) != 6:
+            raise ValueError(f"Cannot parse pad_color: {value!r}")
+        values = tuple(int(raw[index : index + 2], 16) for index in (0, 2, 4))
