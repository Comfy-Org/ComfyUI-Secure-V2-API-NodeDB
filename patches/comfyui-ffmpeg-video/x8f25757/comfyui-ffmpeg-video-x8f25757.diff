+def _float_rate(value: Any, default: float = 30.0) -> float:
+    try:
+        result = float(value)
+    except (TypeError, ValueError, ZeroDivisionError, OverflowError):
+        result = default
+    return result if math.isfinite(result) and result > 0 else default
