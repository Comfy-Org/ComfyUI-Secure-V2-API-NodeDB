+def _sheet_for_qwen(images: list[Image.Image], labels: list[str]) -> Image.Image:
+    if len(images) == 1:
+        return images[0]
+    sheet = alg._ttp_make_contact_sheet(images, labels, thumb_size=256, columns=2)
+    if sheet is None:
+        raise ValueError("Qwen visual context contains no images")
+    return sheet
+
