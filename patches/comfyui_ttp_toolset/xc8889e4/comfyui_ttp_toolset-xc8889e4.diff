+
+// ─── closedProxy.ts ──────────────────────────────────────────────
+
+/** @knipIgnoreUnusedButUsedByCustomNodes */
+export interface PropSpec<TTarget> {
+  get(target: TTarget): unknown
+  set?(target: TTarget, value: unknown): void
