+def _bound_strings(values):
+    for value in values:
+        if isinstance(value, str) and len(value.encode('utf-8', errors='surrogatepass')) > MAX_TEXT_BYTES:
+            raise ValueError('Wan configuration text exceeds 64 KiB')
