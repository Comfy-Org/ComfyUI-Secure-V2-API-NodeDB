+        return io.NodeOutput(multitalk_embeds, out_audio, actual_num_frames)
+
+NODE_CLASS_MAPPINGS = {'Wav2VecModelLoader': Wav2VecModelLoader, 'MultiTalkWav2VecEmbeds': MultiTalkWav2VecEmbeds}
