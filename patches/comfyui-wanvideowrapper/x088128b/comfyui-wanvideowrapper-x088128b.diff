+    if variant=='missing':return {}
+    if variant=='empty':return {'face_keypoints_2d':[]}
+    if variant=='zero':points[:,:2]=0
+    if variant=='short':points=points[:16]
+    if variant=='nan':points[2,0]=float('nan')
