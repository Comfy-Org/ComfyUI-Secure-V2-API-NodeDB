+def original():
+    tree=ast.parse((PACK/'nodes_utility.py').read_text())
+    cls=next(item for item in tree.body if isinstance(item,ast.ClassDef) and item.name==ID)
+    namespace={'torch':torch,'common_upscale':common_upscale}
