+        return io.NodeOutput(image_embeds, output_path)
+
+
+NODE_CLASS_MAPPINGS = {
+    'WanVideoImageToVideoMultiTalk': WanVideoImageToVideoMultiTalk,
+    'WanVideoImageToVideoSkyreelsv3_audio': WanVideoImageToVideoSkyreelsv3_audio,
