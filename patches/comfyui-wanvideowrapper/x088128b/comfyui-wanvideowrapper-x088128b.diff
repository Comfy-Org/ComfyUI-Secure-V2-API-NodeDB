+            num_refs = 1
+            if ref2 is not None:
+                ref2_latents = vae.encode(ref2 * 2.0 - 1.0, device, tiled=tiled_vae)
+                ref_latents = torch.cat([ref_latents, ref2_latents], dim=2)
