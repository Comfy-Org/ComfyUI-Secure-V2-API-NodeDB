+    @classmethod
+    async def execute(cls, whisper_model, audio_1, normalize_loudness, num_frames, fps, audio_scale, audio_cfg_scale, multi_audio_type, audio_2=None, audio_3=None, audio_4=None, ref_target_masks=None):
