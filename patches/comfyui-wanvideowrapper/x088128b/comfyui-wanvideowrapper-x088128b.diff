+                               options=['sdpa', 'flash_attn_2', 'flash_attn_3', 'sageattn', 'sparse_sage_attention'],
+                               default='sageattn', tooltip='The attention mode for dense attention'),
+                io.Int.Input('dense_blocks', default=1, min=0, max=40, step=1,
