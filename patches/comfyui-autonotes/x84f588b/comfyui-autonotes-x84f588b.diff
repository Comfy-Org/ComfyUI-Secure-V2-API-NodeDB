+   * off an output and then retypes it, so enforcing compatibility mid-move
+   * would reject exactly the case this exists for.
+   */
+  moveLinksTo(target: SlotRef): readonly LinkInfo[]
+  snapshot(): Readonly<SlotSnapshot>
