+    callback: (node: NodeHandle, event: ConnectionChangeEvent) => void
+  ): void // 223 packs
+  onRemoved(callback: (node: NodeHandle) => void): void // 158 packs
+  /**
+   * The node was resized, by the user or by a layout pass.
+   *
