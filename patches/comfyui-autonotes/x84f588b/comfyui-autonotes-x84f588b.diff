+/**
+ * What a resolver may see. Reads only — there is nothing here that writes.
+ *
+ * @knipIgnoreUnusedButUsedByCustomNodes
+ */
+export interface ResolvedNodeView {
+  readonly id: string
+  readonly type: string
+  /**
+   * The node's own properties, frozen.
+   *
