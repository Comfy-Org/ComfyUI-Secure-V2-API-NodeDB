+  readonly life?: number
+}
+
+/** @knipIgnoreUnusedButUsedByCustomNodes */
+interface PlaySoundDef {
+  /**
+   * A browser-readable audio asset. Sandboxed hosts restrict this to pack files.
+   */
+  readonly src: string
+  /** Range 0–1. Defaults to 1. */
+  readonly volume?: number
