+async def _validate_crop(image, crop=None, **_kwargs):
+    dynamic = _dynamic_value(crop)
+    if dynamic.get("data") or dynamic.get("dataUrl") or dynamic.get("imageData"):
+        return True
+    return await _validate_input_image(image)
