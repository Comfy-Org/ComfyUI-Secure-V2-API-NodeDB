+def _clean_text(text: Any) -> str:
+    value = re.sub(r",+", ",", str(text or ""))
+    value = re.sub(r"\s+,", ",", value)
+    value = re.sub(r",(\S)", r", \1", value)
+    value = re.sub(r"\s+", " ", value)
+    value = re.sub(r"\.,|,\.", ".", value)
+    return value.strip().replace(" .", ".")
+
