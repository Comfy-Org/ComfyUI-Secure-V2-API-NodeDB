+  at(index: number): THandle | undefined
+  all(): readonly THandle[]
+  ids(): readonly SlotId[]
+  names(): readonly string[]
+  /**
+   * Adds a slot. 18 packs grow their inputs as the last one fills — the
+   * "Multi" combiner pattern — which needed `node.addInput` until now.
+   *
