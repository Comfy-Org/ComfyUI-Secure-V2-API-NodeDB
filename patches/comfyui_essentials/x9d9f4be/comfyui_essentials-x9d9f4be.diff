+_DOUBLE_PATTERN = re.compile(
+    r"double_blocks\\\.(\d+)\\\.\(img\|txt\)_\(mod\|attn\|mlp\)"
+    r"\\\.\(lin\|qkv\|proj\|0\|2\)\\\.\(weight\|bias\)"
+)
+_SINGLE_PATTERN = re.compile(
