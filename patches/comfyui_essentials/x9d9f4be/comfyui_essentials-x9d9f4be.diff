+async def _rembg_session_v2(cls, model, providers):
+    model_id = model.split(":", 1)[0]
+    allowed_models = {
+        "u2net", "u2netp", "u2net_human_seg", "u2net_cloth_seg",
+        "silueta", "isnet-general-use", "isnet-anime", "sam",
+    }
+    allowed_providers = {
+        "CPU", "CUDA", "ROCM", "DirectML", "OpenVINO", "CoreML",
+        "Tensorrt", "Azure",
+    }
+    if model_id not in allowed_models or providers not in allowed_providers:
+        raise ValueError("unknown background-removal model or provider")
+    return io.NodeOutput({
+        "backend": "rembg",
+        "model": model_id,
+        "provider": providers,
+    })
+
+
+async def _transparent_bg_session_v2(cls, mode, use_jit):
+    if mode not in {"base", "fast", "base-nightly"}:
+        raise ValueError("unknown transparent-background mode")
+    return io.NodeOutput({
+        "backend": "transparent-background",
+        "mode": mode,
+        "use_jit": bool(use_jit),
+    })
+
+
+_BACKGROUND_SESSIONS = {}
+
+
+def _background_processor(configuration):
+    if not isinstance(configuration, dict):
+        raise TypeError("REMBG_SESSION must come from an Essentials session node")
+    backend = configuration.get("backend")
+    key = tuple(sorted(configuration.items()))
+    cached = _BACKGROUND_SESSIONS.get(key)
+    if cached is not None:
+        return cached
+    if backend == "rembg":
+        from rembg import new_session, remove
+
+        model = configuration.get("model")
+        provider = configuration.get("provider")
+        if model not in {
+            "u2net", "u2netp", "u2net_human_seg", "u2net_cloth_seg",
+            "silueta", "isnet-general-use", "isnet-anime", "sam",
+        }:
+            raise ValueError("unknown rembg model")
+        if provider not in {
+            "CPU", "CUDA", "ROCM", "DirectML", "OpenVINO", "CoreML",
+            "Tensorrt", "Azure",
+        }:
+            raise ValueError("unknown rembg provider")
+        session = new_session(
+            model, providers=[provider + "ExecutionProvider"]
+        )
+
+        def process(value):
+            return remove(value, session=session)
+    elif backend == "transparent-background":
+        from transparent_background import Remover
+
+        mode = configuration.get("mode")
+        if mode not in {"base", "fast", "base-nightly"}:
+            raise ValueError("unknown transparent-background mode")
+        session = Remover(mode=mode, jit=bool(configuration.get("use_jit")))
+        process = session.process
+    else:
+        raise ValueError("unknown background-removal backend")
+    _BACKGROUND_SESSIONS[key] = process
+    return process
+
+
+async def _remove_background_v2(cls, rembg_session, image):
+    value = await image.raw()
+    process = _background_processor(rembg_session)
+    output = []
+    for item in value.permute([0, 3, 1, 2]):
+        result = process(T.ToPILImage()(item))
+        output.append(T.ToTensor()(result))
+    output = torch.stack(output, dim=0).permute([0, 2, 3, 1])
+    mask = (
+        output[:, :, :, 3]
+        if output.shape[3] == 4
+        else torch.ones_like(output[:, :, :, 0])
+    )
+    return io.NodeOutput(
+        await sdk.ImageRef._from_raw(output),
+        await sdk.MaskRef._from_raw(mask),
+    )
+
+
+async def _apply_lut_v2(
+    cls, image, lut_file, gamma_correction, clip_values, strength
+):
+    asset = await sdk.ctx().assets.resolve("essentials_luts", lut_file)
+    content = await sdk.ctx().assets.read_bytes(asset)
+    value = await image.raw()
+    with tempfile.NamedTemporaryFile(suffix=".cube") as temporary:
+        temporary.write(content)
+        temporary.flush()
+        result = ImageApplyLUT().execute(
+            value,
+            temporary.name,
+            gamma_correction,
+            clip_values,
+            strength,
+        )
+    return await node_output("ImageApplyLUT+", result)
+
+
+def _annotated_asset(value):
+    for suffix, folder in (
+        ("[output]", "output"),
+        ("[input]", "input"),
+        ("[temp]", "temp"),
+    ):
+        if value.endswith(suffix):
+            return folder, value[:-len(suffix)]
+    return "input", value
+
+
+async def _preview_from_latent_v2(
+    cls, latent, vae, tile_size, image="none", **_hidden
+):
+    mask_value = torch.zeros((64, 64), dtype=torch.float32, device="cpu")
+    if image and image != "none" and image.startswith("clipspace"):
+        folder, name = _annotated_asset(image)
+        asset = await sdk.ctx().assets.resolve(folder, name)
+        content = await sdk.ctx().assets.read_bytes(asset)
+        with Image.open(BytesIO(content)) as opened:
+            opened = ImageOps.exif_transpose(opened)
+            if opened.mode == "I":
+                opened = opened.point(lambda item: item * (1 / 255))
+            rgba = opened.copy()
+        image_value = np.array(rgba.convert("RGB")).astype(np.float32) / 255.0
+        image_value = torch.from_numpy(image_value)[None,]
+        if "A" in rgba.getbands():
+            alpha = np.array(rgba.getchannel("A")).astype(np.float32) / 255.0
+            mask_value = 1.0 - torch.from_numpy(alpha)
+        image_ref = await sdk.ImageRef._from_raw(image_value)
+    elif tile_size > 0:
+        tile_size = max(int(tile_size), 320)
+        image_ref = await vae.decode_tiled(
+            latent,
+            tile_x=tile_size // 8,
+            tile_y=tile_size // 8,
+        )
+        image_value = await image_ref.raw()
+    else:
+        image_ref = await vae.decode(latent)
+        image_value = await image_ref.raw()
+    mask_ref = await sdk.MaskRef._from_raw(mask_value)
+    ui_value = await sdk.ctx().ui.preview_images(image_ref)
+    return io.NodeOutput(
+        image_ref,
+        mask_ref,
+        int(image_value.shape[2]),
+        int(image_value.shape[1]),
+        ui=ui_value,
+    )
+
+
+async def _image_to_device_v2(cls, image, device):
+    return io.NodeOutput(await image.to_device(device))
+
+
+_IMAGE_CUSTOM = {
+    "RemBGSession+": (
+        _rembg_session_v2, "RemBGSessionV2", ()
+    ),
+    "TransparentBGSession+": (
+        _transparent_bg_session_v2, "TransparentBGSessionV2", ()
+    ),
+    "ImageRemoveBackground+": (
+        _remove_background_v2, "ImageRemoveBackgroundV2", ("raw",)
+    ),
+    "ImageApplyLUT+": (
+        _apply_lut_v2, "ImageApplyLUTV2", ("raw", "assets")
+    ),
+    "ImagePreviewFromLatent+": (
+        _preview_from_latent_v2,
+        "ImagePreviewFromLatentV2",
+        ("raw", "ui", "assets"),
+    ),
+    "ImageToDevice+": (
+        _image_to_device_v2, "ImageToDeviceV2", ()
+    ),
+}
