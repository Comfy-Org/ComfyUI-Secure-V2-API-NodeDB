+        return io.NodeOutput(
+            patched, conditioning, latent_ref, audio_latent_ref,
+            await sdk.ValueRef.from_value(guide_data),
+            await sdk.ValueRef.from_value(motion), float(frame_rate), audio_ref,
+        )
