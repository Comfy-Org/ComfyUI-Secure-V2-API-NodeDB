+const directorInstances = new Map();
+const directorKey = (node) => `${node.graphId ?? ''}:${node.id}`;
+const DIRECTOR_DEFAULTS = {
+  global_prompt: "",
+  mainTrackEnabled: true,
+  audioTrackEnabled: true,
+  motionTrackEnabled: true,
+  audioTrackWasEnabledBeforeOverride: false,
+  inpaint_audio: true,
+  override_audio: false,
+  overrideAudio: false,
+  showFilenames: true,
+  use_custom_audio: false,
+  use_custom_motion: true,
+  frame_rate: 24,
+  display_mode: "seconds",
+  custom_width: 0,
+  custom_height: 0,
+  resize_method: "maintain aspect ratio",
+  divisible_by: 32,
+  img_compression: 18,
+  guide_strength: "",
+  local_prompts: "",
+  segment_lengths: "",
+  timeline_data: "{}",
+  epsilon: 0.001,
+  start_second: 0.0,
+  end_second: 5.0,
+  duration_seconds: 5.0,
+  start_frame: 0,
+  end_frame: 120,
+  duration_frames: 120,
+};
+
+function refreshDirector(instance) {
+  const editor = instance.editor;
+  if (!editor) return;
+  editor.timeline = parseInitial(editor.timelineDataWidget?.value);
+  editor.mainTrackEnabled = editor.timeline.mainTrackEnabled !== false;
+  editor.audioTrackEnabled = editor.timeline.audioTrackEnabled !== false;
+  editor.motionTrackEnabled = editor.timeline.motionTrackEnabled !== false;
+  editor.retakeMode = editor.timeline.retakeMode === true;
+  editor.loadMedia();
+  editor.updateRetakeUIState();
+  editor.updateUIFromSelection();
+  editor.syncWidgetsAndUI();
+  editor.syncLayoutToNode();
+  editor.render();
+}
+
+comfy.defs.extend('LTXDirector', (builder) => {
+  for (const name of HIDDEN_WIDGETS) builder.hideWidget(name);
+
+  builder.onCreated((node) => {
+    for (const [name, value] of Object.entries(DIRECTOR_DEFAULTS)) {
+      if (node.getProperty(name) === undefined) node.setProperty(name, value);
+    }
+    for (const name of HIDDEN_WIDGETS) node.widgets.get(name)?.setHidden(true);
+
+    const facade = nodeFacade(node);
+    const instance = { node, facade, editor: null, container: null };
+    directorInstances.set(directorKey(node), instance);
+    node.setSizeConstraints({ minWidth: 720, minHeight: 520 });
+    const size = node.getSize();
+    if (size.width < 1375) node.setSize({ width: 1375, height: Math.max(size.height, 720) });
+
+    node.widgets.mount({
+      name: 'ltx_director_timeline',
+      hideOnZoom: false,
+      render(container) {
+        instance.container = container;
+        container.tabIndex = 0;
+        instance.editor = new TimelineEditor(facade, container, undefined);
+      },
+      destroy() {
+        instance.editor?.destroy();
+        instance.editor = null;
+        instance.container?.replaceChildren();
+        instance.container = null;
+      },
+    });
+  });
+
+  builder.onConfigured((node) => {
+    const instance = directorInstances.get(directorKey(node));
+    if (instance) queueMicrotask(() => refreshDirector(instance));
+  });
+
+  builder.onConnectionsChanged((node) => {
+    const instance = directorInstances.get(directorKey(node));
+    if (instance) refreshDirector(instance);
+  });
+
+  builder.onResized((node, size) => {
+    const instance = directorInstances.get(directorKey(node));
+    if (!instance) return;
+    instance.facade._syncSize(size);
+    requestAnimationFrame(() => instance.editor?.syncLayoutToNode());
+  });
+
+  builder.onSerialize((node) => ({ ...node.getProperties() }));
+
+  builder.onRemoved((node) => {
+    const key = directorKey(node);
+    const instance = directorInstances.get(key);
+    instance?.editor?.destroy();
+    instance?.container?.replaceChildren();
+    directorInstances.delete(key);
+  });
 });
