+
+
+def populate(
+    text: str,
+    seed: int,
+    catalogue: dict[str, tuple[str, ...]],
+    *,
+    style: str,
+) -> str:
+    """Populate inline and named wildcards, including nested replacements."""
+    result = _comment_filter(str(text)) if style == "impact" else str(text)
