+def matrix(
+    text: str,
+    catalogue: dict[str, tuple[str, ...]],
+    offset: int,
+    output_limit: int,
+) -> tuple[list[str], int, list[int]]:
+    """Enumerate Easy Use's independent inline/named wildcard dimensions."""
+    source = str(text)
