+        latent=latent,
+        steps=int(steps),
+        model=model,
+        positive=positive,
+        negative=negative,
+        cfg=float(cfg),
+        sampler_name=str(sampler_name),
+        scheduler=str(scheduler),
+        end_at_step=int(end_at_step),
+        normalize=str(normalize) == "enable",
+    )
+    source["samples"] = result
+    return source, result
