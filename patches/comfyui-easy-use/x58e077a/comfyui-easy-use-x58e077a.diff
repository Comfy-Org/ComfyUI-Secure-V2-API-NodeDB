+
+
+def _decode_file(
+    target: dict[str, tuple[str, ...]], name: str, data: bytes, style: str,
+) -> None:
+    suffix = PurePosixPath(name).suffix.lower()
+    text = _decode_text(data)
+    if suffix == ".txt":
