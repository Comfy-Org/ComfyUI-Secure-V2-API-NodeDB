+async def _compare(a=0, b=0, comparison="a == b", **_kwargs):
+    operations = {
+        "a == b": lambda: a == b,
+        "a != b": lambda: a != b,
+        "a < b": lambda: a < b,
+        "a > b": lambda: a > b,
+        "a <= b": lambda: a <= b,
+        "a >= b": lambda: a >= b,
+        "a > 0": lambda: a > 0,
+        "a <= 0": lambda: a <= 0,
+        "b > 0": lambda: b > 0,
+        "b <= 0": lambda: b <= 0,
+    }
+    return _one(bool(operations[comparison]()))
