+    // no change event, so visibility is recomputed once the node is configured.
+    // The old value setter caught this case.
+    b.onConfigured((node) => {
+        for (const w of node.widgets.all()) {
+            if (!nodeWidgetHandlers[node.comfyClass][w.name]) continue;
+            widgetLogic(node, w);
+        }
+    });
+});
