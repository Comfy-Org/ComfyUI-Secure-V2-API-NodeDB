+  onConfigured?(node: NodeHandle, data: Record<string, unknown>): void
+  onConnectionsChanged?(node: NodeHandle, event: ConnectionChangeEvent): void
+  onPropertyChanged?(node: NodeHandle, event: PropertyChangeEvent): void
