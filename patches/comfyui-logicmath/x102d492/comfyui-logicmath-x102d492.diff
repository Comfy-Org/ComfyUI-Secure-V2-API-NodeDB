+// ─── queueHandle.ts ──────────────────────────────────────────────
+
+/** @knipIgnoreUnusedButUsedByCustomNodes */
+export interface RunOptions {
+  /**
+   * Run only these nodes and whatever feeds them, instead of the whole
+   * workflow. Empty is rejected rather than treated as "everything": a filter
