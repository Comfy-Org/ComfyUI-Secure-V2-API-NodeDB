+    async def execute(cls, images: Any = None, scale_by: float = 0.5) -> io.NodeOutput:
+        tensor = await images.raw()
+        return io.NodeOutput(await sdk.ImageRef.from_value(image_scale_down_by(tensor, scale_by)))
