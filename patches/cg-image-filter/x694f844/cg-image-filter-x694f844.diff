-    find_node(uid) {
-		uid = uid.split('.').pop();
-		
-        const bits = uid.split(':')
-        if (bits.length==1) {
-            return app.graph._nodes_by_id[uid]
-        } else {
-            var graph = app.graph
-            var node
-            bits.forEach((bit)=>{
-                node = graph._nodes_by_id[bit]
-                graph = node.subgraph
-            })
-        }
-        return node
-    }
