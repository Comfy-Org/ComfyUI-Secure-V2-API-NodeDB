+
+/** @knipIgnoreUnusedButUsedByCustomNodes */
+export type SlotDirection = 'none' | 'up' | 'down' | 'left' | 'right' | 'center'
+
+/** @knipIgnoreUnusedButUsedByCustomNodes */
+export interface SlotPosition {
+  readonly x: number
+  readonly y: number
+}
+
+/** @knipIgnoreUnusedButUsedByCustomNodes */
+export interface SlotPatch {
+  name?: string
+  label?: string | undefined
