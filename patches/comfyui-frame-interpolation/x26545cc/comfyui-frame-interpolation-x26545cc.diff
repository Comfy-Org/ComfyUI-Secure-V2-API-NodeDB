+  readonly graph: GraphHandle
+  /** Node definitions, and the replacement for `beforeRegisterNodeDef`. */
+  readonly defs: DefRegistry
+  /** Declaring, reading and writing pack settings. */
+  readonly settings: SettingsHandle
