+  addBadge(badge: BadgeDef | (() => BadgeDef)): Unsubscribe
+  /**
+   * Declares how the node may be sized, instead of re-asserting it per frame.
+   *
+   * 39 packs recompute size inside a draw or resize callback, which is both a
