+  input(ref: string | number): InputRef | undefined
+}
+
+/** @knipIgnoreUnusedButUsedByCustomNodes */
+export interface ResolveView {
+  readonly self: ResolvedNodeView
+  nodesOfType(type: string): readonly ResolvedNodeView[]
+}
