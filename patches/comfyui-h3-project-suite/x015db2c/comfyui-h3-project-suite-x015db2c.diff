+  readonly canvasOnly?: boolean
+  readonly hideInPanel?: boolean
+  readonly nodeType?: string
+  readonly serialize?: boolean
+  readonly values?: unknown
+  readonly iconClass?: string
+  readonly disabled?: boolean
