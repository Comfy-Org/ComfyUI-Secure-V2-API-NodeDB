+        if prefix and suffix:
+            prompts = [f"{prefix},{line},{suffix}" for line in lines]
+            debug = [f"➡️{prefix},{line},{suffix}" for line in lines]
+        elif prefix:
+            prompts = [f"{prefix},{line}" for line in lines]
