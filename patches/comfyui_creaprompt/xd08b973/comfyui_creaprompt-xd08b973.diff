+      state,
+      Object.keys(stored).length > 0
+        ? stored
+        : Object.fromEntries(DEFAULT_CATEGORIES.map((name) => [name, DISABLED])),
+    );
+  });
+
+  builder.onRemoved((node) => states.delete(keyFor(node)));
 });
