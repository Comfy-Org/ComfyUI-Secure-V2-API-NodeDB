+    addButton(node, '🧹 Remove All', (menuEvent) => {
+      if (!menuEvent) return;
+      comfy.ui.showMenu({
+        title: 'Remove every category?',
+        event: menuEvent,
+        items: [{ label: 'Remove all', run: () => replaceCategories(state, {}) }],
