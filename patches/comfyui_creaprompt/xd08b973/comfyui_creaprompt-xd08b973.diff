+export interface WidgetSerializeEvent {
+  readonly context: 'workflow' | 'prompt' | 'embedded'
+  /** What would be written if no handler intervened. */
+  readonly value: WidgetValue
+  setSerializedValue(value: WidgetValue): void
+}
