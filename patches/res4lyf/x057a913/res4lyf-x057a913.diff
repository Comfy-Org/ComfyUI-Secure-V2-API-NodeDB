+                            opt_stop  = row + 1
+                        elif  opt_timing == "late":
+                            opt_start = row + 1
+
+                        for r2 in range(opt_start, opt_stop): 
+                            if r_ != r2:
+                                if   opt_subtype == "a":
+                                    eps_a = eps_[r2]
+                                    eps_b = eps_[r_]
+                                elif opt_subtype == "b":
+                                    eps_a = eps_[r_]
+                                    eps_b = eps_[r2]
+                                
+                                if   opt_type == "ortho":
+                                    eps_ [r_] = get_orthogonal(eps_a, eps_b)
+                                elif opt_type == "collin":
