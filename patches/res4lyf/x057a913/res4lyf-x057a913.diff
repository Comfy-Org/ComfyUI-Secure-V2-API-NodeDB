+    
+    
+    
+    def get_epsilon_anchored(self, x_0:Tensor, denoised:Tensor, sigma:Tensor) -> Tensor:
+        return (x_0 - denoised) / sigma
+    
+    
+    
+    def get_guide_epsilon(self, 
+                            x_0           : Tensor, 
