+def check_projection_consistency(x, W, b):
+    W_pinv = torch.linalg.pinv(W.T)
+    x_proj = (x - b) @ W_pinv     
+    x_recon = x_proj @ W.T + b   
+    error = torch.norm(x - x_recon)
+    in_subspace = error < 1e-3
+    return error, in_subspace
+
