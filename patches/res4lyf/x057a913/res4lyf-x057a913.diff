+def parse_range_string_int(s):
+    if "all" in s:
+        return AlwaysTrueList()
+    
+    result = []
+    for part in s.split(','):
+        if '-' in part:
+            start, end = part.split('-')
+            result.extend(range(int(start), int(end) + 1))
+        elif part.strip() != '':
+            result.append(int(part))
+    return result
