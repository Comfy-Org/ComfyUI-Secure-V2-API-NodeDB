+    for i in range(len(b)): 
+        b[i][0] =        φ(1)     - sum(b[i])
+    return a, b
+
+def gen_first_col_exp_uv(a, b, c, u, v, φ):
+    for i in range(len(c)): 
+        a[i][0] = c[i] * φ(1,i+1) - sum(a[i]) - sum(u[i])
+    for i in range(len(b)): 
+        b[i][0] =        φ(1)     - sum(b[i]) - sum(v[i])
+    return a, b
