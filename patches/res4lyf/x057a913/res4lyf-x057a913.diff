+def mu_numerator(j, cd, ci, ck, cl):
+    if j == 2:
+        numerator = -cd * ck * cl
+    if j == 3:
+        numerator = 2 * (cd * ck + cd * cl + ck * cl)
+    if j == 4:
+        numerator = -6 * (cd + ck + cl)
+    if j == 5:
+        numerator = 24
+    return numerator #/ denominator(ci, cd, ck, cl)
