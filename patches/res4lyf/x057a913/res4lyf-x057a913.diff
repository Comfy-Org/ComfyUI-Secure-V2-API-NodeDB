+        else:
+            raise ValueError(f"get_eps expected 3 or 5 arguments, got {len(args)}")
+
+    def get_epsilon(self,
+                    x_0       : Tensor,
+                    x         : Tensor,
+                    denoised  : Tensor,
+                    sigma     : Tensor,
+                    sub_sigma : Tensor,
+                    ) -> Tensor:
+        
+        eps_anchor   = (x_0 - denoised) / sigma
