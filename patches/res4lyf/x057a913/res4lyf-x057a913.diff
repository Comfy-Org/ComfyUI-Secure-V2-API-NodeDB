+        if rate_factor is None:
+            if "fast" in schedule:
+                rate_factor = 0.25
+            elif "slow" in schedule:
+                rate_factor = 1.0
+            else: # moderate
+                rate_factor = 0.5
+
+        if start_change_factor is None:
