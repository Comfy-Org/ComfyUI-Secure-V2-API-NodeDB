+class VAEEncodeAdvancedV2(io.ComfyNode):
+    """helper_sigma_preview_image_preproc.py:234-317 (VAEEncodeAdvanced.main), line for line."""
+    SDK_REFS = True
+    SDK_PERMISSIONS = ("raw",)
