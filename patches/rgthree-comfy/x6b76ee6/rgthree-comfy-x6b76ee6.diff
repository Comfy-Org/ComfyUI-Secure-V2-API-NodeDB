+
+/** @knipIgnoreUnusedButUsedByCustomNodes */
+export type NodeShape = 'default' | 'box' | 'round' | 'circle' | 'card'
+
+export interface BadgeDef {
+  readonly text: string
+  /** Text colour. Defaults to core's badge foreground. */
