+     "tooltip": "Connect to KSampler steps. More steps can refine detail but do not guarantee better composition."
+    },
+    "io_type": "INT",
+    "kind": "standard"
+   },
+   {
+    "attrs": {
+     "display_name": "conditioning_strength",
+     "id": "output_4",
+     "is_output_list": false,
+     "tooltip": "Connect through Music3 Conditioning Strength after Text Encode. Scales the acoustic plan presented to the DiT."
+    },
+    "io_type": "FLOAT",
+    "kind": "standard"
+   },
+   {
+    "attrs": {
