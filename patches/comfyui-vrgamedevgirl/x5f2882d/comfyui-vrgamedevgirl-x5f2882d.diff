+    # while conv2d offers significant speedups on GPU/CUDA.
+    # We branch to ensure optimal performance on both devices.
+    # BRANCH 1: CPU (Einsum)
+    if image_compute.device.type == "cpu":
+        out = torch.einsum("...chw,oc->...ohw", image_compute, kernel_compute)
+        out = out.contiguous()
