+def load_original():
+    import folder_paths
+    for setter, path in (("set_output_directory", "/tmp/out"), ("set_input_directory", "/tmp/in"), ("set_temp_directory", "/tmp/temp")):
+        os.makedirs(path, exist_ok=True)
