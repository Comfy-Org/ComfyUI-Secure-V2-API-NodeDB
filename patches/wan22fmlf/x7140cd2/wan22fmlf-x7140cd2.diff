+   */
+  duplicate(
+    id: string,
+    position?: { x: number; y: number }
+  ): NodeHandle | undefined
+  /**
+   * Rebuilds a node, optionally as another type, keeping what the user set and
+   * every link that still fits. Replacing with the same type repairs a node
