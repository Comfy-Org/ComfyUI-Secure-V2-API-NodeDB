+const uploadCalls = [];
+const assetUrls = [];
+let selector = null;
+let hiddenByBuilder = null;
+let uploadIndex = 0;
+
+const builder = {
+    hideWidget(name) { hiddenByBuilder = name; },
+    onCreated(callback) { hooks.created = callback; },
+    onConfigured(callback) { hooks.configured = callback; },
+    onRemoved(callback) { hooks.removed = callback; },
+};
