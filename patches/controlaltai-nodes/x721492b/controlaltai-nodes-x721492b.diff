+   * use the pre-hook to refuse an incompatible link or relabel a slot while
+   * the type is still known. Returning `false` refuses.
+   */
+  onBeforeConnect(
+    callback: (node: NodeHandle, event: BeforeConnectEvent) => boolean | void
+  ): void
+  /**
