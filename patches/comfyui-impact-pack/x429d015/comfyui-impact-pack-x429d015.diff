+                result = result[:match.start()] + replacement + result[match.end():]
+                changed = True
+                if len(result) > _MAX_OUTPUT_CHARS:
+                    raise ValueError("populated wildcard prompt exceeds the secure size limit")
+        if not changed:
+            break
