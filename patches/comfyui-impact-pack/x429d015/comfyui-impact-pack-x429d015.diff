+_DETAILER_HOOK_RECIPE_KINDS = frozenset({
+    "BlackPatchRetryHookProvider",
+    "CoreMLDetailerHookProvider",
+    "CustomSamplerDetailerHookProvider",
+    "DenoiseSchedulerDetailerHookProvider",
+    "LamaRemoverDetailerHookProvider",
