+    if not 0 <= threshold <= 255:
+        raise ValueError("LaMa mask_threshold must be in [0, 255]")
+    if not 0 <= blur_radius <= 20:
+        raise ValueError("LaMa gaussblur_radius must be in [0, 20]")
+    if type(skip_sampling) is not bool:
