-async function withRestoreLock(fn) {
-    if (restoreLock) {
-        showToast("Please wait for the current operation to finish", "warn");
-        return;
-    }
-    let resolve;
-    restoreLock = new Promise((r) => { resolve = r; });
-    try {
-        await fn();
-    } finally {
-        setTimeout(() => {
-            restoreLock = null;
-            resolve();
-            if (sidebarRefresh) {
-                sidebarRefresh().catch(() => {});
-            }
-            if (timelineRefresh) {
-                timelineRefresh().catch(() => {});
-            }
-        }, RESTORE_GUARD_MS);
-    }
-}
