+function confirmDialog(message) {
+    return new Promise((resolve) => {
+        let settled = false;
+        let handle;
+        const finish = (answer) => {
+            if (settled) return;
+            settled = true;
+            handle?.close();
+            resolve(answer);
+        };
+        handle = comfy.ui.showDialog({
+            key: `SnapshotManager.confirm.${generatedId("dialog")}`,
+            title: "Snapshot Manager",
+            render(container) {
