-        });
-        if (capturedId) {
-            state.returnRef = { workflowKey, id: capturedId };
-        } else {
-            // Dedup means the live graph already matches the last durable
-            // checkpoint. Use that existing record as the return point.
-            const existingRef = state.activeRef
-                || (lastCapturedIdMap.has(workflowKey)
-                    ? { workflowKey, id: lastCapturedIdMap.get(workflowKey) }
-                    : null);
-            if (existingRef) state.returnRef = existingRef;
