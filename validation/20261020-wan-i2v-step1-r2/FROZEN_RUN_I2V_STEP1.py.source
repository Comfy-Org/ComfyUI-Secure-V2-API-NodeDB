"""UNRUN outside controller: WAN I2V Step 1, synthetic code-path parity plus a T2V regression case (MERVYN m_ac4fbd5c7d /
m_21c672eca8). The Qwen r4 / feta r3 hardening applies.
r2 (MERVYN m_11da48bcaf, review CLEAR_WITH_NOTES):
- comparator rev6;
- CASE and FIXTURE_SPEC are parsed from bytes checked against the pinned SHA256SUMS (L9);
- a host-side scan checks the fixture digest is absent from the candidate tree (L6);
- the comparator inputs are re-hashed right before the comparator (L8).

Run only after a separate Root selection, as root in WSL under the shared lock:
  wsl -d Ubuntu-24.04 -u root -e flock -w 900 /tmp/conversion-tests.lock \
      python3 -I -S -B <packet>/controller/run_i2v_step1.py --config <BOUND-CONFIG.json> --config-sha256 <sha> --authorization-message <m_...>
  python3 -I -S -B run_i2v_step1.py --selftest <fresh dir>   (no docker: argv, gates, integrity/fixture tampers, copy gate)
Stdlib only.

Three containers run one after another:
- fixture, original, converted;
- each as uid/gid 1000 with every capability dropped and no-new-privileges;
- no network, a read-only root, a noexec tmpfs /tmp, and memory = swap = the cap;
- removed by exact ID in finally, with absence checked twice; no retry.

1. fixture binds the capsule, original, native-core and native-site read-only, plus a writable /out. It builds the synthetic i2v
   checkpoint and inputs with the untouched original constructor. The controller then copies each expected output with
   O_NOFOLLOW into <output>/fixture (dir 0755, files 0444). It checks the copies against FIXTURE.json (sha256 and bytes) and
   against the declared architecture.
2. original and 3. converted get the r3 binds (capsule and the six material trees). They also get the verified fixture dir
   (/fixture), the trained 1.3B file and the fixture model file, all read-only; the two model files are single-file binds under
   /models/diffusion_models. /out is the only writable bind.
Integrity: the packet and the six trees are checked before every role. The fixture copy is checked again before original and
converted: every file, no extras, no symlinks.
Comparison: the rev5 comparator (rev4 plus the I2V/seam checks) runs over the O_NOFOLLOW copies and the FIXTURE.json copy.
"""
import argparse
import hashlib
import json
import os
from pathlib import Path
import re
import shutil
import stat
import subprocess
import sys
import time

GiB = 1024 ** 3
MiB = 1024 ** 2
PREPARATION_MAILS = {'m_ac4fbd5c7d', 'm_932f23f1bf', 'm_21c672eca8', 'm_ee3bbeb1e8', 'm_3225c9c5a5', 'm_8f418c201e', 'm_220cfe725d',
                     'm_41c16d8aac', 'm_bfd428076d', 'm_da2498be6b', 'm_435e52ee89', 'm_018dbf44aa', 'm_ee23614b11', 'm_705ac72bf7',
                     'm_011118b38f', 'm_140f2ce7a1', 'm_1d7cb7072f', 'm_80cadbc6a9', 'm_8433d7bfca', 'm_11da48bcaf', 'm_26ae5f1b3d'}
SCHEMA = 'wan-i2v-step1-linux-cpu/1'
USER = '1000:1000'
UID = GID = 1000
PYTHON = '/usr/local/bin/python3.13'
REQUIRED_ENV = {'HOME': '/tmp', 'HF_HUB_OFFLINE': '1', 'TRANSFORMERS_OFFLINE': '1', 'CUDA_VISIBLE_DEVICES': '-1'}
LIMITS = {'container_memory_bytes': 6 * GiB, 'sampled_rss_stop_bytes': 5632 * MiB, 'memavailable_min_bytes': 10 * GiB,
          'disk_free_bytes': 8 * GiB, 'private_max_bytes': 1 * GiB, 'tmpfs_bytes': 3840 * MiB, 'shm_bytes': 128 * MiB,
          'comparator_input_max_bytes': 64 * MiB, 'fixture_model_max_bytes': 64 * MiB, 'fixture_small_max_bytes': 4 * MiB}
PRIVATE_MAX_ENTRIES = 100000
ROLES = ('fixture', 'original', 'converted')
TREES = ('candidate', 'original', 'native-core', 'native-site', 'converted-site', 'inputs')
MOUNTS = {'fixture': (('original', '/original'), ('native-core', '/native-core'), ('native-site', '/native-site')),
          'original': (('candidate', '/candidate'), ('original', '/original'), ('native-core', '/native-core'),
                       ('native-site', '/native-site'), ('converted-site', '/converted-site'), ('inputs', '/inputs')),
          'converted': (('candidate', '/candidate'), ('original', '/original'), ('native-core', '/native-core'),
                        ('native-site', '/native-site'), ('converted-site', '/converted-site'), ('inputs', '/inputs'))}
FIXTURE_LOGS = ('FIXTURE_RESULT.json', 'FIXTURE_CURRENT_PHASE.json')


def require(condition, message):
    if not condition:
        raise RuntimeError(message)


def run(argv, timeout=30, check=True):
    result = subprocess.run(argv, capture_output=True, text=True, timeout=timeout)
    if check and result.returncode != 0:
        raise RuntimeError('%s failed: %s' % (argv[:3], result.stderr.strip()[:400]))
    return result


def digest(path):
    # 1 MiB reads: large 9p (/mnt/c) reads can fail with ENOMEM on high-order allocations under WSL memory pressure.
    value = hashlib.sha256()
    with open(path, 'rb') as stream:
        for block in iter(lambda: stream.read(1024 * 1024), b''):
            value.update(block)
    return value.hexdigest()


def mem_available():
    for line in Path('/proc/meminfo').read_text().splitlines():
        if line.startswith('MemAvailable:'):
            return int(line.split()[1]) * 1024
    raise RuntimeError('MemAvailable not reported')


def parse_size(text):
    match = re.fullmatch(r'([0-9.]+)\s*([KMGT]?i?B)', text.strip())
    require(match is not None, 'Unparsed memory sample: ' + text)
    scale = {'B': 1, 'KiB': 1024, 'MiB': MiB, 'GiB': GiB, 'TiB': 1024 ** 4, 'kB': 1000, 'KB': 1000, 'MB': 1000 ** 2, 'GB': 1000 ** 3}[match.group(2)]
    return int(float(match.group(1)) * scale)


def absent_twice(cid):
    rows = []
    for _ in range(2):
        rows.append(run(['docker', 'container', 'inspect', cid], check=False).returncode != 0)
        time.sleep(1)
    return rows


def dir_usage(root):
    used, entries = 0, 0
    for base, dirs, files in os.walk(root, followlinks=False):
        for name in dirs + files:
            entries += 1
            try:
                used += os.lstat(os.path.join(base, name)).st_blocks * 512
            except OSError:
                continue
    return used, entries


def uid_can(st, owner_bits, group_bits, other_bits):
    if st.st_uid == UID:
        return st.st_mode & owner_bits == owner_bits
    if st.st_gid == GID:
        return st.st_mode & group_bits == group_bits
    return st.st_mode & other_bits == other_bits


def unreadable_for_uid(root, recursive):
    bad = []
    walker = os.walk(root, followlinks=False) if recursive else [(root, [], [])]
    for base, _, files in walker:
        if not uid_can(os.lstat(base), stat.S_IRUSR | stat.S_IXUSR, stat.S_IRGRP | stat.S_IXGRP, stat.S_IROTH | stat.S_IXOTH):
            bad.append(base)
        for name in files:
            st = os.lstat(os.path.join(base, name))
            if stat.S_ISREG(st.st_mode) and not uid_can(st, stat.S_IRUSR, stat.S_IRGRP, stat.S_IROTH):
                bad.append(os.path.join(base, name))
    return bad[:20]


def read_small_regular(path, limit):
    st = os.lstat(path)
    require(stat.S_ISREG(st.st_mode) and st.st_size <= limit, '%s must be a small regular file' % path)
    with open(path, 'rb') as stream:
        return stream.read(limit + 1)


def verify_tree(root, listing, walk_root):
    """Every listed file is a regular file inside root with the listed sha256; walk_root holds nothing unlisted."""
    root_real = os.path.realpath(root)
    for rel, expected in listing.items():
        require(not rel.startswith('/') and '..' not in rel.split('/'), 'Bad listed path ' + rel)
        path = os.path.join(root, rel)
        st = os.lstat(path)
        require(stat.S_ISREG(st.st_mode), 'Listed path is not a regular file: ' + rel)
        require(os.path.realpath(path).startswith(root_real + os.sep), 'Listed path escapes the tree: ' + rel)
        require(digest(path) == expected, 'Tree file differs from its pin: ' + rel)
    seen = set()
    for base, dirs, files in os.walk(walk_root, followlinks=False):
        for name in dirs:
            require(not os.path.islink(os.path.join(base, name)), 'Symlinked dir in tree: ' + os.path.join(base, name))
        for name in files:
            full = os.path.join(base, name)
            require(stat.S_ISREG(os.lstat(full).st_mode), 'Non-regular entry in tree: ' + full)
            seen.add(os.path.relpath(full, root))
    extra = sorted(seen - set(listing))
    require(not extra, 'Unlisted files in tree: %s' % extra[:5])
    return len(listing)


def verify_integrity(config, fixture=None):
    host, pins = config['host'], config['integrity']
    started = time.time()
    sums = read_small_regular(os.path.join(host['packet_root'], 'SHA256SUMS'), 4 * MiB)
    require(hashlib.sha256(sums).hexdigest() == pins['packet_sha256sums_sha256'], 'Packet SHA256SUMS differs from the bound pin')
    listing = {}
    for line in sums.decode('utf-8').splitlines():
        value, _, rel = line.partition('  ')
        require(re.fullmatch('[0-9a-f]{64}', value) is not None and rel and rel not in listing and rel != 'SHA256SUMS', 'Bad SHA256SUMS line')
        listing[rel] = value
    row = {'packet_files': verify_tree(host['packet_root'], dict(listing, SHA256SUMS=hashlib.sha256(sums).hexdigest()), host['packet_root'])}
    materials = read_small_regular(os.path.join(host['materials_root'], 'MATERIALS.json'), 64 * MiB)
    require(hashlib.sha256(materials).hexdigest() == pins['materials_sha256'], 'MATERIALS.json differs from the bound pin')
    trees = json.loads(materials)['trees']
    require(sorted(trees) == sorted(TREES), 'Unexpected material trees')
    for tree in TREES:
        root = os.path.join(host['materials_root'], tree)
        row[tree] = verify_tree(root, {rel: item['sha256'] for rel, item in trees[tree].items()}, root)
    if fixture is not None:
        row['fixture'] = verify_tree(fixture['dir'], fixture['listing'], fixture['dir'])
    row['status'], row['seconds'] = 'VERIFIED', round(time.time() - started, 2)
    return row


def role_argv(role, config, role_out, fixture_dir=None):
    host, limits, box = config['host'], config['limits'], config['container']
    cap = limits['container_memory_bytes']
    argv = ['docker', 'create', '--pull=never', '--name', config['container_prefix'] + '-' + role, '--init',
            '--user', USER, '--cap-drop', 'ALL', '--security-opt', 'no-new-privileges', '--network', 'none', '--read-only',
            '--cpus', str(limits['cpus']), '--memory', str(cap), '--memory-swap', str(cap), '--pids-limit', '256',
            '--shm-size', str(limits['shm_bytes']), '--tmpfs', '/tmp:rw,nosuid,nodev,noexec,size=%d' % limits['tmpfs_bytes'],
            '--workdir', '/tmp', '--mount', 'type=bind,src=%s,dst=/prepared,readonly' % (Path(host['packet_root']) / 'capsule')]
    for tree, dst in MOUNTS[role]:
        argv += ['--mount', 'type=bind,src=%s,dst=%s,readonly' % (Path(host['materials_root']) / tree, dst)]
    if role != 'fixture':
        require(fixture_dir is not None, 'Verified fixture dir required for ' + role)
        argv += ['--mount', 'type=bind,src=%s,dst=/fixture,readonly' % fixture_dir,
                 '--mount', 'type=bind,src=%s,dst=%s,readonly' % (host['model_file'], config['model']['container_path']),
                 '--mount', 'type=bind,src=%s,dst=%s,readonly' % (Path(fixture_dir) / config['fixture']['model_file'],
                                                                   config['fixture']['container_path'])]
    argv += ['--mount', 'type=bind,src=%s,dst=/out' % role_out]
    for key, value in sorted(config['environment'].items()):
        argv += ['--env', '%s=%s' % (key, value)]
    argv += ['--entrypoint', box['python'], config['image']['id'], '-I', '-B', '-X', 'faulthandler', '/prepared/role_entry.py', '--role', role]
    return argv


def safe_copy(role_out, name, dest, limit, mode=0o600):
    """Plain regular file directly under the role dir, realpath inside it, size cap, O_NOFOLLOW read, exclusive create."""
    role_real = os.path.realpath(role_out)
    path = os.path.join(role_out, name)
    st = os.lstat(path)
    require(stat.S_ISREG(st.st_mode), name + ' must be a regular file')
    require(os.path.realpath(path) == os.path.join(role_real, name), name + ' must resolve inside the role dir')
    require(st.st_size <= limit, name + ' above the size cap')
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    try:
        opened = os.fstat(fd)
        require(stat.S_ISREG(opened.st_mode) and (opened.st_dev, opened.st_ino) == (st.st_dev, st.st_ino), name + ' changed')
        chunks, size = [], 0
        while True:
            block = os.read(fd, 1 << 20)
            if not block:
                break
            size += len(block)
            require(size <= limit, name + ' above the size cap')
            chunks.append(block)
    finally:
        os.close(fd)
    data = b''.join(chunks)
    target = os.path.join(dest, name)
    with os.fdopen(os.open(target, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, mode), 'wb') as stream:
        stream.write(data)
    os.chmod(target, mode)
    return {'name': name, 'bytes': len(data), 'sha256': hashlib.sha256(data).hexdigest()}


def fixture_files(spec):
    return ['FIXTURE.json', 'FIXTURE_PARAMETER_SHAPES.json', spec['model_file']] + sorted(item['file'] for item in spec['inputs'].values())


def copy_and_verify_fixture(role_out, fixture_dir, spec, limits):
    """Copy the fixture outputs (0444 in a 0755 dir; uid 1000 must read them) and verify them against FIXTURE.json."""
    present = sorted(os.listdir(role_out))
    expected = sorted(fixture_files(spec) + list(FIXTURE_LOGS))
    require(present == expected, 'Fixture /out holds unexpected entries: %s' % sorted(set(present) ^ set(expected)))
    os.mkdir(fixture_dir, 0o755)
    os.chmod(fixture_dir, 0o755)
    rows = {}
    for name in fixture_files(spec):
        limit = limits['fixture_model_max_bytes'] if name == spec['model_file'] else limits['fixture_small_max_bytes']
        rows[name] = safe_copy(role_out, name, fixture_dir, limit, mode=0o444)
    record = json.loads(read_small_regular(os.path.join(fixture_dir, 'FIXTURE.json'), limits['fixture_small_max_bytes']))
    model = record.get('model') or {}
    require(record.get('format') == 'jack-wan-i2v-fixture/1' and record.get('seed') == spec['seed'], 'Fixture identity')
    require(model.get('file') == spec['model_file'] and model.get('catalogue_name') == spec['catalogue_name'], 'Fixture model name')
    require(model.get('sha256') == rows[spec['model_file']]['sha256'] and model.get('bytes') == rows[spec['model_file']]['bytes'], 'Fixture model digest')
    require(model.get('patch_embedding') == spec['expected_patch_embedding'] and model.get('has_k_img') is True, 'Fixture architecture')
    shapes = json.loads(read_small_regular(os.path.join(fixture_dir, 'FIXTURE_PARAMETER_SHAPES.json'), limits['fixture_small_max_bytes']))
    require(hashlib.sha256(json.dumps(shapes, sort_keys=True).encode()).hexdigest() == model.get('parameter_shapes_sha256')
            and len(shapes) == model.get('parameters'), 'Fixture parameter shapes')
    for name, item in spec['inputs'].items():
        got = (record.get('inputs') or {}).get(name) or {}
        require(got.get('file') == item['file'] and got.get('dtype') == item['dtype'] and got.get('shape') == item['shape'], 'Fixture input spec ' + name)
        require(got.get('sha256') == rows[item['file']]['sha256'] and got.get('bytes') == rows[item['file']]['bytes'], 'Fixture input digest ' + name)
    listing = {name: row['sha256'] for name, row in rows.items()}
    verify_tree(fixture_dir, listing, fixture_dir)
    return {'dir': str(fixture_dir), 'listing': listing, 'copies': sorted(rows.values(), key=lambda r: r['name']),
            'fixture_json_sha256': rows['FIXTURE.json']['sha256'], 'model_sha256': model['sha256'], 'model_bytes': model['bytes'],
            'parameters': model.get('parameters'), 'parameter_elements': model.get('parameter_elements')}


def pinned_capsule_bytes(config, rel):
    """One read, checked against the bound SHA256SUMS pin, then parsed by the caller: no gap between check and use (review L9)."""
    sums = read_small_regular(os.path.join(config['host']['packet_root'], 'SHA256SUMS'), 4 * MiB)
    require(hashlib.sha256(sums).hexdigest() == config['integrity']['packet_sha256sums_sha256'], 'Packet SHA256SUMS differs from the bound pin')
    listing = dict(line.split('  ', 1)[::-1] for line in sums.decode('utf-8').splitlines())
    data = read_small_regular(os.path.join(config['host']['packet_root'], rel), 4 * MiB)
    require(rel in listing and hashlib.sha256(data).hexdigest() == listing[rel], rel + ' differs from the pinned SHA256SUMS')
    return data


def host_digest_absent(root, hex_digest):
    """Host-side counterpart of the in-container scan (review L6): no file under root contains the digest text."""
    needle = hex_digest.encode('ascii')
    for base, dirs, files in os.walk(root, followlinks=False):
        for name in files:
            with open(os.path.join(base, name), 'rb') as stream:
                if needle in stream.read():
                    return False
    return True


def comparator_inputs(case_file, role):
    names = ['%s_RESULT.json' % role.upper()]
    for case in case_file['cases']:
        if case.get('expect') != 'raise':
            names.append('%s-%s-samples.bin' % (role, case['name']))
    return names


def run_role(role, config, out, fixture_dir=None):
    limits = config['limits']
    role_out = out / ('out-' + role)
    role_out.mkdir()
    role_out.chmod(0o777)
    argv = role_argv(role, config, role_out, fixture_dir)
    row = {'role': role, 'create_argv': argv}
    cid = run(argv).stdout.strip()
    require(re.fullmatch('[0-9a-f]{64}', cid) is not None, 'Exact container ID required')
    row['container_id'] = cid
    try:
        run(['docker', 'start', cid])
        started, peak, private_peak, samples = time.monotonic(), 0, 0, []
        while True:
            state = json.loads(run(['docker', 'inspect', '--format', '{{json .State}}', cid]).stdout)
            if state['Status'] in ('exited', 'dead'):
                break
            usage = run(['docker', 'stats', '--no-stream', '--format', '{{.MemUsage}}', cid], timeout=20, check=False).stdout.strip()
            used, entries = dir_usage(role_out)
            private_peak = max(private_peak, used)
            value = parse_size(usage.split('/')[0]) if usage else None
            if value is not None:
                peak = max(peak, value)
            samples.append([round(time.monotonic() - started, 1), value, used, entries])
            stop = None
            if value is not None and value > limits['sampled_rss_stop_bytes']:
                stop = 'sampled memory above stop'
            elif used > limits['private_max_bytes'] or entries > PRIVATE_MAX_ENTRIES:
                stop = '/out above 1 GiB or %d entries' % PRIVATE_MAX_ENTRIES
            elif time.monotonic() - started > limits['role_work_seconds']:
                stop = 'role deadline'
            if stop:
                row.setdefault('fail_stop', stop)
                run(['docker', 'kill', cid], check=False)
            time.sleep(2)
        final = json.loads(run(['docker', 'inspect', '--format', '{{json .State}}', cid]).stdout)
        row.update(exit_code=final['ExitCode'], oom_killed=final['OOMKilled'], seconds=time.monotonic() - started,
                   peak_sampled_bytes=peak, private_peak_bytes=private_peak, private_final=dir_usage(role_out), samples=samples[-400:])
        logs = run(['docker', 'logs', '--tail', '4000', cid], timeout=60, check=False)
        (out / ('LOG-' + role + '.txt')).write_text((logs.stdout + logs.stderr)[-8 * 1024 * 1024:])
    finally:
        row['removed'] = run(['docker', 'rm', '-f', cid], check=False).returncode == 0
        row['absent_twice'] = absent_twice(cid)
    return row, role_out


def check_config(config):
    host = config['host']
    require(config['schema'] == SCHEMA and config['execution_selected'] is True, 'Selected bound config required')
    require(config['container'] == {'python': PYTHON, 'user': USER}, 'Reviewed container identity required')
    require(all(config['environment'].get(k) == v for k, v in REQUIRED_ENV.items()), 'HOME=/tmp and offline env required')
    require(all(config['limits'].get(k) == v for k, v in LIMITS.items()), 'Reviewed I2V Step 1 limits required')
    require(config['limits']['memavailable_min_bytes'] == config['limits']['container_memory_bytes'] + 4 * GiB, 'Gate must be cap + 4 GiB')
    require(config['model']['container_path'].startswith('/models/diffusion_models/'), 'Model container path')
    require(config['fixture']['container_path'] == '/models/diffusion_models/' + config['fixture']['catalogue_name']
            and '/' not in config['fixture']['model_file'] and config['fixture']['catalogue_name'].endswith('/' + config['fixture']['model_file']),
            'Fixture model path')
    for key in ('packet_root', 'materials_root', 'binding_root', 'output_root', 'model_file'):
        require(Path(host[key]).is_absolute() and ',' not in host[key], key + ' must be an absolute path without commas')
    integrity = config.get('integrity') or {}
    for key in ('packet_sha256sums_sha256', 'materials_sha256'):
        require(re.fullmatch('[0-9a-f]{64}', str(integrity.get(key))) is not None, key + ' pin required')


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument('--config', type=Path)
    parser.add_argument('--config-sha256')
    parser.add_argument('--authorization-message')
    parser.add_argument('--selftest')
    args = parser.parse_args()
    if args.selftest:
        return selftest(Path(args.selftest))
    require(re.fullmatch('m_[0-9a-f]+', args.authorization_message or '') is not None
            and args.authorization_message not in PREPARATION_MAILS, 'A separate Root runtime selection is required')
    require(digest(args.config) == args.config_sha256, 'Reviewed bound config required')
    config = json.loads(args.config.read_bytes())
    check_config(config)
    out = Path(config['host']['output_root'])
    require(out.is_absolute() and not out.exists(), 'Fresh output root required')
    out.mkdir(mode=0o700)
    limits, host = config['limits'], config['host']
    receipt = {'status': 'FAILED_I2V_STEP1_NO_RETRY', 'authorization_message': args.authorization_message, 'attempts': 1,
               'automatic_retries': 0, 'started_utc': time.time(), 'roles': {}, 'integrity': {}}
    try:
        available = mem_available()
        receipt['preflight'] = {'MemAvailable_bytes': available, 'required_bytes': limits['memavailable_min_bytes'],
                                'disk_free_bytes': shutil.disk_usage(out).free, 'required_disk_bytes': limits['disk_free_bytes']}
        require(available >= limits['memavailable_min_bytes'], 'MemAvailable below cap + 4 GiB')
        require(receipt['preflight']['disk_free_bytes'] >= limits['disk_free_bytes'], 'Disk below 8 GiB')
        unreadable = {'packet_capsule': unreadable_for_uid(str(Path(host['packet_root']) / 'capsule'), True)}
        for tree in TREES:
            unreadable[tree] = unreadable_for_uid(str(Path(host['materials_root']) / tree), True)
        unreadable['model_file'] = [] if uid_can(os.stat(host['model_file']), stat.S_IRUSR, stat.S_IRGRP, stat.S_IROTH) else [host['model_file']]
        receipt['preflight']['unreadable_for_uid_1000'] = unreadable
        require(not any(unreadable.values()), 'A bind source is not readable by uid 1000')
        image = run(['docker', 'image', 'inspect', '--format', '{{.Id}}', config['image']['id']]).stdout.strip()
        require(image == config['image']['id'], 'Exact pinned image required')
        for role in ROLES:
            require(run(['docker', 'container', 'inspect', config['container_prefix'] + '-' + role], check=False).returncode != 0,
                    'Container name already in use')
        receipt['model'] = {'bytes': os.stat(host['model_file']).st_size, 'sha256': digest(host['model_file'])}
        require(receipt['model'] == {'bytes': config['model']['bytes'], 'sha256': config['model']['sha256']}, 'Pinned model differs')
        capsule = Path(host['packet_root']) / 'capsule'
        # 1. fixture. CASE and FIXTURE_SPEC come from the very bytes checked against the pinned SHA256SUMS, read after the first
        # integrity pass (review L9).
        receipt['integrity']['before_fixture'] = verify_integrity(config)
        case_file = json.loads(pinned_capsule_bytes(config, 'capsule/CASE.json'))
        spec = json.loads(pinned_capsule_bytes(config, 'capsule/FIXTURE_SPEC.json'))
        receipt['roles']['fixture'], fixture_out = run_role('fixture', config, out)
        require(receipt['roles']['fixture']['absent_twice'] == [True, True], 'Container retirement unconfirmed; stop')
        require(receipt['roles']['fixture'].get('exit_code') == 0 and not receipt['roles']['fixture'].get('fail_stop'), 'fixture role failed')
        fixture = copy_and_verify_fixture(fixture_out, out / 'fixture', spec, limits)
        receipt['fixture'] = {k: v for k, v in fixture.items() if k != 'listing'}
        receipt['fixture']['digest_absent_from_candidate_host_scan'] = host_digest_absent(Path(host['materials_root']) / 'candidate',
                                                                                         fixture['model_sha256'])
        require(receipt['fixture']['digest_absent_from_candidate_host_scan'] is True, 'Fixture digest found in candidate bytes')
        receipt['fixture']['result'] = safe_copy(fixture_out, 'FIXTURE_RESULT.json', out, limits['fixture_small_max_bytes'])
        fixture_unreadable = unreadable_for_uid(fixture['dir'], True)
        require(not fixture_unreadable, 'Fixture copy not readable by uid 1000: %s' % fixture_unreadable[:3])
        compare_dir = out / 'compare'
        compare_dir.mkdir(mode=0o700)
        copies = {'fixture': [safe_copy(Path(fixture['dir']), 'FIXTURE.json', compare_dir, limits['fixture_small_max_bytes'])]}
        # 2./3. roles
        for role in ('original', 'converted'):
            receipt['integrity']['before_' + role] = verify_integrity(config, fixture)
            receipt['roles'][role], role_out = run_role(role, config, out, fixture['dir'])
            require(receipt['roles'][role]['absent_twice'] == [True, True], 'Container retirement unconfirmed; stop')
            require(receipt['roles'][role].get('exit_code') == 0 and not receipt['roles'][role].get('fail_stop'), role + ' role failed')
            copies[role] = []
            for name in comparator_inputs(case_file, role):
                if os.path.lexists(os.path.join(role_out, name)) or name.endswith('_RESULT.json'):
                    copies[role].append(safe_copy(role_out, name, compare_dir, limits['comparator_input_max_bytes']))
        receipt['comparator_inputs'] = copies
        for rows in copies.values():  # review L8: drvfs modes are not enforced, so re-hash every copy right before the comparator
            for row in rows:
                require(digest(compare_dir / row['name']) == row['sha256'], 'Comparator input changed after copy: ' + row['name'])
        receipt['comparator_inputs_rehashed'] = True
        result = run([sys.executable, '-I', '-S', '-B', str(capsule / 'compare_slices_rev6.py'),
                      '--out-dir', str(compare_dir), '--prepared-dir', str(capsule)], timeout=300, check=False)
        comparison = compare_dir / 'COMPARISON.json'
        receipt['comparison'] = {'exit_code': result.returncode, 'stdout': result.stdout[-2000:], 'stderr': result.stderr[-4000:],
                                 'sha256': digest(comparison) if comparison.exists() else None}
        status = json.loads(comparison.read_bytes())['status'] if comparison.exists() else 'NO_COMPARISON'
        receipt['comparison']['status'] = status
        if status.startswith(('PASS_SLICES_', 'CLOSED_BY_REVIEWED_NORMALIZATION_SLICES_')):
            receipt['status'] = 'COMPLETED_' + status
    except BaseException as error:
        receipt.update(error_type=type(error).__name__, error=str(error))
    finally:
        receipt['finished_utc'] = time.time()
        (out / 'RECEIPT.json').write_text(json.dumps(receipt, indent=2) + '\n')
    print(json.dumps({'status': receipt['status'], 'error': receipt.get('error')}))
    return 0 if receipt['status'].startswith('COMPLETED_') else 1


def selftest(directory):
    """No docker. Synthetic files only, under a fresh Linux directory."""
    require(not directory.exists(), 'Fresh selftest dir required')
    directory.mkdir()
    checks, controls = {}, {}
    config = {'container_prefix': 'p', 'image': {'id': 'sha256:' + 'a' * 64}, 'container': {'python': PYTHON, 'user': USER},
              'environment': dict(REQUIRED_ENV), 'limits': {**LIMITS, 'cpus': 2, 'role_work_seconds': 420},
              'model': {'container_path': '/models/diffusion_models/x/m.safetensors'},
              'fixture': {'model_file': 's.safetensors', 'catalogue_name': 'synthetic/s.safetensors',
                          'container_path': '/models/diffusion_models/synthetic/s.safetensors'},
              'host': {'packet_root': '/p', 'materials_root': '/m', 'model_file': '/f/m.safetensors'}}
    argv = role_argv('converted', config, Path('/o/out-converted'), '/o/fixture')
    mounts = [argv[i + 1] for i, item in enumerate(argv) if item == '--mount']
    fixture_argv = role_argv('fixture', config, Path('/o/out-fixture'))
    fixture_mounts = [fixture_argv[i + 1] for i, item in enumerate(fixture_argv) if item == '--mount']
    checks['argv_user_caps'] = all(a[a.index('--user') + 1] == USER and a[a.index('--cap-drop') + 1] == 'ALL' and '--cap-add' not in a
                                   and '--privileged' not in a for a in (argv, fixture_argv))
    checks['argv_tmpfs_noexec'] = argv[argv.index('--tmpfs') + 1] == '/tmp:rw,nosuid,nodev,noexec,size=%d' % (3840 * MiB)
    checks['argv_only_out_writable'] = ([m for m in mounts if not m.endswith(',readonly')] == ['type=bind,src=/o/out-converted,dst=/out']
                                        and [m for m in fixture_mounts if not m.endswith(',readonly')] == ['type=bind,src=/o/out-fixture,dst=/out'])
    checks['argv_role_trees_readonly'] = (all('type=bind,src=/m/%s,dst=%s,readonly' % (t, d) in mounts for t, d in MOUNTS['converted'])
                                          and all('type=bind,src=/m/%s,dst=%s,readonly' % (t, d) in fixture_mounts for t, d in MOUNTS['fixture']))
    checks['argv_fixture_role_minimal'] = (len(fixture_mounts) == 5 and not any('/candidate' in m or '/models/' in m or 'dst=/fixture' in m
                                                                               or 'converted-site' in m for m in fixture_mounts))
    checks['argv_models_and_fixture'] = ('type=bind,src=/f/m.safetensors,dst=/models/diffusion_models/x/m.safetensors,readonly' in mounts
                                         and 'type=bind,src=/o/fixture,dst=/fixture,readonly' in mounts
                                         and 'type=bind,src=/o/fixture/s.safetensors,dst=/models/diffusion_models/synthetic/s.safetensors,readonly' in mounts)
    checks['argv_network_memory'] = (argv[argv.index('--network') + 1] == 'none' and '--read-only' in argv
                                     and argv[argv.index('--memory') + 1] == argv[argv.index('--memory-swap') + 1] == str(6 * GiB))
    checks['argv_entrypoint'] = argv[argv.index('--entrypoint') + 1:argv.index('--entrypoint') + 9] == [
        PYTHON, 'sha256:' + 'a' * 64, '-I', '-B', '-X', 'faulthandler', '/prepared/role_entry.py', '--role']
    packet, materials = directory / 'packet', directory / 'materials'
    (packet / 'capsule').mkdir(parents=True)
    (packet / 'capsule/CASE.json').write_text('{}')
    sums = ('%s  capsule/CASE.json\n' % digest(packet / 'capsule/CASE.json')).encode()
    (packet / 'SHA256SUMS').write_bytes(sums)
    trees = {}
    for tree in TREES:
        (materials / tree / 'd').mkdir(parents=True)
        (materials / tree / 'd/f.txt').write_text(tree)
        trees[tree] = {'d/f.txt': {'bytes': len(tree), 'sha256': digest(materials / tree / 'd/f.txt')}}
    mbytes = json.dumps({'trees': trees}).encode()
    (materials / 'MATERIALS.json').write_bytes(mbytes)
    pins = {'packet_sha256sums_sha256': hashlib.sha256(sums).hexdigest(), 'materials_sha256': hashlib.sha256(mbytes).hexdigest()}
    good = {'host': {'packet_root': str(packet), 'materials_root': str(materials)}, 'integrity': pins}
    row = verify_integrity(good)
    checks['integrity_clean'] = row['status'] == 'VERIFIED' and row['packet_files'] == 2 and all(row[t] == 1 for t in TREES)

    def tamper(name, edit, pin_edit=None):
        case_root = directory / ('case-' + name)
        shutil.copytree(packet, case_root / 'packet', symlinks=True)
        shutil.copytree(materials, case_root / 'materials', symlinks=True)
        if edit:
            edit(case_root / 'packet', case_root / 'materials')
        try:
            verify_integrity({'host': {'packet_root': str(case_root / 'packet'), 'materials_root': str(case_root / 'materials')},
                              'integrity': dict(pins, **(pin_edit or {}))})
            controls['integrity_' + name] = 'NOT DETECTED'
        except (RuntimeError, OSError) as error:
            controls['integrity_' + name] = 'REFUSED: ' + str(error)[:70]

    def relink(p, m):
        target = m / 'candidate/d/f.txt'
        target.unlink()
        target.symlink_to(directory / 'materials/candidate/d/f.txt')

    tamper('candidate_byte', lambda p, m: (m / 'candidate/d/f.txt').write_text('x'))
    tamper('extra_core_file', lambda p, m: (m / 'native-core/d/g.py').write_text(''))
    tamper('missing_input', lambda p, m: (m / 'inputs/d/f.txt').unlink())
    tamper('symlinked_tree_file', relink)
    tamper('capsule_byte', lambda p, m: (p / 'capsule/CASE.json').write_text('{"x": 1}'))
    tamper('extra_capsule_file', lambda p, m: (p / 'capsule/evil.py').write_text(''))
    tamper('materials_pin', None, {'materials_sha256': '0' * 64})
    checks['host_digest_scan_clean'] = host_digest_absent(materials / 'candidate', 'f' * 64) is True
    (directory / 'scan/d').mkdir(parents=True)
    (directory / 'scan/d/x.py').write_text('ADMITTED = {"%s": 1}' % ('f' * 64))
    controls['host_digest_scan_finds_digest'] = 'REFUSED: found' if host_digest_absent(directory / 'scan', 'f' * 64) is False else 'NOT DETECTED'
    checks['pinned_case_bytes'] = pinned_capsule_bytes({'host': {'packet_root': str(packet)}, 'integrity': pins}, 'capsule/CASE.json') == b'{}'
    swapped = directory / 'case-pinned'
    shutil.copytree(packet, swapped / 'packet', symlinks=True)
    (swapped / 'packet/capsule/CASE.json').write_text('{"x": 2}')
    try:
        pinned_capsule_bytes({'host': {'packet_root': str(swapped / 'packet')}, 'integrity': pins}, 'capsule/CASE.json')
        controls['case_bytes_swapped'] = 'NOT DETECTED'
    except (RuntimeError, OSError) as error:
        controls['case_bytes_swapped'] = 'REFUSED: ' + str(error)[:70]
    # fixture copy + verification on a synthetic fixture /out
    spec = {'seed': 7, 'model_file': 's.safetensors', 'catalogue_name': 'synthetic/s.safetensors', 'expected_patch_embedding': [192, 36, 1, 2, 2],
            'inputs': {'y': {'file': 'y.bin', 'dtype': 'bfloat16', 'shape': [2]}}}

    def fixture_out(name, mutate=None):
        root = directory / ('fixture-' + name)
        role_out = root / 'out-fixture'
        role_out.mkdir(parents=True)
        model, y = b'model-bytes', b'yy'
        shapes = {'patch_embedding.weight': [192, 36, 1, 2, 2]}
        record = {'format': 'jack-wan-i2v-fixture/1', 'seed': 7,
                  'model': {'file': 's.safetensors', 'catalogue_name': 'synthetic/s.safetensors', 'bytes': len(model),
                            'sha256': hashlib.sha256(model).hexdigest(), 'patch_embedding': [192, 36, 1, 2, 2], 'has_k_img': True,
                            'parameters': 1, 'parameter_shapes_sha256': hashlib.sha256(json.dumps(shapes, sort_keys=True).encode()).hexdigest()},
                  'inputs': {'y': {'file': 'y.bin', 'dtype': 'bfloat16', 'shape': [2], 'bytes': 2, 'sha256': hashlib.sha256(y).hexdigest()}}}
        files = {'s.safetensors': model, 'y.bin': y, 'FIXTURE.json': json.dumps(record).encode(),
                 'FIXTURE_PARAMETER_SHAPES.json': json.dumps(shapes).encode(), 'FIXTURE_RESULT.json': b'{}', 'FIXTURE_CURRENT_PHASE.json': b'{}'}
        for key, data in files.items():
            (role_out / key).write_bytes(data)
        if mutate:
            mutate(role_out)
        return role_out, root / 'fixture'

    role_out, fixture_dir = fixture_out('clean')
    fixture = copy_and_verify_fixture(role_out, fixture_dir, spec, LIMITS)
    checks['fixture_copy_clean'] = (fixture['model_sha256'] == hashlib.sha256(b'model-bytes').hexdigest()
                                    and oct(os.stat(fixture_dir / 's.safetensors').st_mode & 0o777) == '0o444'
                                    and oct(os.stat(fixture_dir).st_mode & 0o777) == '0o755' and len(fixture['listing']) == 4)
    integrity_with_fixture = verify_integrity(good, fixture)
    checks['integrity_with_fixture'] = integrity_with_fixture['fixture'] == 4
    os.chmod(fixture_dir, 0o755)
    try:
        (fixture_dir / 'extra.bin').write_bytes(b'x')
        verify_integrity(good, fixture)
        controls['fixture_extra_file_after_copy'] = 'NOT DETECTED'
    except (RuntimeError, OSError) as error:
        controls['fixture_extra_file_after_copy'] = 'REFUSED: ' + str(error)[:70]
    secret = directory / 'secret.bin'
    secret.write_bytes(b'model-bytes')

    def swap_symlink(out_dir):
        (out_dir / 's.safetensors').unlink()
        (out_dir / 's.safetensors').symlink_to(secret)
    for name, mutate in (('model_byte', lambda o: (o / 's.safetensors').write_bytes(b'model-bytez')),
                         ('model_symlink', swap_symlink),
                         ('extra_out_entry', lambda o: (o / 'evil.py').write_text('')),
                         ('architecture', lambda o: (o / 'FIXTURE.json').write_text((o / 'FIXTURE.json').read_text().replace('[192, 36, 1, 2, 2]', '[192, 16, 1, 2, 2]'))),
                         ('input_byte', lambda o: (o / 'y.bin').write_bytes(b'yz'))):
        role_out, fixture_dir = fixture_out(name, mutate)
        try:
            copy_and_verify_fixture(role_out, fixture_dir, spec, LIMITS)
            controls['fixture_' + name] = 'NOT DETECTED'
        except (RuntimeError, OSError) as error:
            controls['fixture_' + name] = 'REFUSED: ' + str(error)[:70]
    role_out = directory / 'out-original'
    role_out.mkdir()
    (role_out / 'ORIGINAL_RESULT.json').write_text('{"status": "ORIGINAL_SLICES_DONE"}')
    copy_dir = directory / 'compare'
    copy_dir.mkdir()
    copied = safe_copy(role_out, 'ORIGINAL_RESULT.json', copy_dir, 64 * MiB)
    checks['copy_gate_regular_file'] = copied['bytes'] > 0 and oct(os.stat(copy_dir / 'ORIGINAL_RESULT.json').st_mode & 0o777) == '0o600'
    (directory / 'secret.txt').write_text('s')
    (role_out / 'original-t0-samples.bin').symlink_to(directory / 'secret.txt')
    try:
        safe_copy(role_out, 'original-t0-samples.bin', copy_dir, 64 * MiB)
        controls['copy_symlink'] = 'NOT DETECTED'
    except (RuntimeError, OSError) as error:
        controls['copy_symlink'] = 'REFUSED: ' + str(error)[:70]
    (role_out / 'big.bin').write_bytes(b'x' * 2048)
    try:
        safe_copy(role_out, 'big.bin', copy_dir, 1024)
        controls['copy_oversize'] = 'NOT DETECTED'
    except RuntimeError as error:
        controls['copy_oversize'] = 'REFUSED: ' + str(error)[:70]
    names = comparator_inputs({'cases': [{'name': 't0'}, {'name': 'i4', 'expect': 'raise'}]}, 'converted')
    checks['comparator_inputs_expected'] = names == ['CONVERTED_RESULT.json', 'converted-t0-samples.bin']
    base = {'schema': SCHEMA, 'execution_selected': True, 'container': {'python': PYTHON, 'user': USER},
            'environment': dict(REQUIRED_ENV), 'limits': {**LIMITS, 'cpus': 2, 'role_work_seconds': 420},
            'model': {'container_path': '/models/diffusion_models/x/m.safetensors'}, 'integrity': pins,
            'fixture': {'model_file': 's.safetensors', 'catalogue_name': 'synthetic/s.safetensors',
                        'container_path': '/models/diffusion_models/synthetic/s.safetensors'},
            'host': {'packet_root': '/p', 'materials_root': '/m', 'binding_root': '/b', 'output_root': '/o', 'model_file': '/f/m'}}
    check_config(base)
    for name, edit in (('root_user', lambda c: c['container'].update(user='0:0')),
                       ('online', lambda c: c['environment'].update(HF_HUB_OFFLINE='0')),
                       ('bigger_cap', lambda c: c['limits'].update(container_memory_bytes=8 * GiB)),
                       ('no_materials_pin', lambda c: c['integrity'].pop('materials_sha256')),
                       ('fixture_path_escape', lambda c: c['fixture'].update(container_path='/models/other/s.safetensors')),
                       ('unselected', lambda c: c.update(execution_selected=False))):
        bad = json.loads(json.dumps(base))
        edit(bad)
        try:
            check_config(bad)
            controls['config_' + name] = 'NOT DETECTED'
        except RuntimeError as error:
            controls['config_' + name] = 'REFUSED: ' + str(error)[:70]
    try:
        role_argv('original', config, Path('/o/out-original'))
        controls['argv_original_without_fixture'] = 'NOT DETECTED'
    except RuntimeError as error:
        controls['argv_original_without_fixture'] = 'REFUSED: ' + str(error)[:70]
    checks['controls_all_refused'] = all(v.startswith('REFUSED') for v in controls.values())
    record = {'scope': 'no docker, image, model or pack code; synthetic files only', 'checks': checks, 'controls': controls,
              'status': 'PASS_SELFTEST' if all(checks.values()) else 'FAILED_SELFTEST'}
    (directory / 'SELFTEST.json').write_text(json.dumps(record, indent=2) + '\n')
    print(json.dumps({'status': record['status'], 'failed': sorted(k for k, v in checks.items() if not v),
                      'controls': len(controls), 'not_refused': sorted(k for k, v in controls.items() if not v.startswith('REFUSED'))}))
    return 0 if record['status'] == 'PASS_SELFTEST' else 1


if __name__ == '__main__':
    raise SystemExit(main())
