"""ORIGINAL side for WAN r11 wav2vec exists-first r1: the untouched 088128b nodes DownloadAndLoadWav2VecModel.loadmodel,
FantasyTalkingModelLoader.loadmodel and FantasyTalkingWav2VecEmbeds.process (fantasytalking/nodes.py). The modules are checked
against PRISTINE_GIT_BINDINGS, and the three weights against CASE.

The original resolves models/transformers/<repo> and downloads with huggingface_hub.snapshot_download only when that directory is
absent (fantasytalking/nodes.py:52-66). A harness-only counting wrapper replaces huggingface_hub.snapshot_download: it records
each call and raises, so the original's exists branch is proven taken (0 calls) when the model is present, and its download
attempt is recorded (1 call) when it is absent (w3). /models/transformers is the read-only bundle-data tree with the two weight
files bound into it.

Each case seeds and loads afresh. RNG (torch, NumPy, Python) is recorded after the seed, the loader and the case.
"""
import gc
import json
import os
from pathlib import Path
import sys
import time
import traceback

sys.path.insert(0, '/prepared')
import common  # noqa: E402
import w2v_common  # noqa: E402

REPORT = {'status': 'RUNNING', 'route': 'original_native', 'cases': {}}
phase = common.Phases(REPORT, 'ORIGINAL')
MODULES = ('fantasytalking.nodes', 'fantasytalking.model', 'multitalk.wav2vec2')


def main():
    case_file = common.load_json('/prepared/CASE.json')
    phase('setup')
    sys.path[:0] = ['/native-site', '/native-core', '/original']
    from comfy.cli_args import args, LatentPreviewMethod
    args.cpu = True
    args.disable_dynamic_vram = True
    args.preview_method = LatentPreviewMethod.NoPreviews
    import torch
    torch.set_num_threads(1)
    import folder_paths
    for setter, name in [('set_user_directory', 'user'), ('set_input_directory', 'input'),
                         ('set_output_directory', 'output'), ('set_temp_directory', 'temp')]:
        path = Path('/tmp/original-' + name)
        path.mkdir(parents=True, exist_ok=True)
        getattr(folder_paths, setter)(str(path))
    folder_paths.folder_names_and_paths['diffusion_models'] = (['/models/diffusion_models'], {'.safetensors'})
    folder_paths.filename_list_cache.pop('diffusion_models', None)
    import asyncio
    import server
    from app.assets.manager import default_asset_manager
    args.front_end_root = '/tmp/original-headless-web'
    Path(args.front_end_root).mkdir(exist_ok=True)
    loop = asyncio.new_event_loop()
    asyncio.set_event_loop(loop)
    server.PromptServer(loop, default_asset_manager())
    REPORT['versions'] = common.versions(case_file['vendor_versions'])
    REPORT['cpu'] = {'torch': torch.__version__, 'threads': torch.get_num_threads(), 'capability': torch.backends.cpu.get_cpu_capability()}
    REPORT['numeric_env'] = w2v_common.numeric_env()
    import importlib
    bound = {row['path']: row['sha256'] for row in common.load_json('/original/PRISTINE_GIT_BINDINGS.json')['files']}
    modules = {}
    REPORT['original_module_sha256'] = {}
    for name in MODULES:
        module = importlib.import_module('wan_original.' + name)
        rel = os.path.relpath(module.__file__, '/original/wan_original')
        digest = common.sha_file(module.__file__)
        assert digest == bound[rel], rel
        REPORT['original_module_sha256'][rel] = digest
        modules[name] = module
    REPORT['weights'] = {key: common.sha_file(spec['container_paths']['original']) for key, spec in case_file['models'].items()}
    import huggingface_hub
    calls = []

    def counting_snapshot_download(*args_, **kwargs):
        calls.append({'args': [str(a) for a in args_], 'kwargs': {k: str(v) for k, v in sorted(kwargs.items())}})
        raise RuntimeError('harness: original snapshot_download called (no network in this test)')
    huggingface_hub.snapshot_download = counting_snapshot_download
    REPORT['seam'] = 'huggingface_hub.snapshot_download replaced by a counting wrapper after all imports'
    nodes = modules['fantasytalking.nodes']
    present_models_dir = '/models'
    empty_models_dir = Path('/tmp/original-empty-models')
    empty_models_dir.mkdir(exist_ok=True)
    for case in case_file['cases']:
        name = case['name']
        if case.get('converted_only'):
            REPORT['cases'][name] = {'not_applicable': 'converted-only control on the published bytes'}
            continue
        phase('original-' + name)
        w2v_common.seed_all(case['seed'])
        record = {'rng_after_seed': w2v_common.rng_state()}
        started = time.monotonic()
        del calls[:]
        folder_paths.models_dir = str(empty_models_dir) if case['item'] == 'absent' else present_models_dir
        value = None
        try:
            value, = nodes.DownloadAndLoadWav2VecModel().loadmodel(model=case['model'], base_precision=case['base_precision'],
                                                                   load_device=case['load_device'])
            record['outcome'] = {'raised': False}
        except Exception as error:
            record['outcome'] = w2v_common.error_outcome(error)
            del error
        finally:
            folder_paths.models_dir = present_models_dir
        record['download_calls_loader'] = list(calls)
        record['rng_after_loader'] = w2v_common.rng_state()
        if value is not None and case['item'] == 'loader':
            record['state'], record['stated'] = w2v_common.wav2vec_state(value)
        if value is not None and case['item'] == 'embeds':
            ft, = nodes.FantasyTalkingModelLoader().loadmodel(model=case_file['models']['fantasytalking']['catalogue_name'],
                                                             base_precision=case['fantasytalking_precision'])
            inputs = w2v_common.audio(case['audio'])
            record['inputs'] = {'waveform': common.tensor_meta(inputs['waveform']), 'sample_rate': inputs['sample_rate']}
            del calls[:]
            out, = nodes.FantasyTalkingWav2VecEmbeds().process(wav2vec_model=value, fantasytalking_model=ft, fps=case['fps'],
                                                               num_frames=case['num_frames'], audio_scale=case['audio_scale'],
                                                               audio_cfg_scale=case['audio_cfg_scale'], audio=inputs)
            record['download_calls_embeds'] = list(calls)
            record['outputs'] = w2v_common.embeds_meta(out, 'original', name)
            del out, ft, inputs
        record['rng_after_case'] = w2v_common.rng_state()
        record['seconds'] = round(time.monotonic() - started, 3)
        REPORT['cases'][name] = record
        del value
        gc.collect()
    REPORT['numeric_env_final'] = w2v_common.numeric_env()
    REPORT['status'] = 'ORIGINAL_W2V_DONE'


try:
    main()
except BaseException:
    REPORT['status'] = 'FAIL'
    REPORT['traceback'] = traceback.format_exc()
    print(REPORT['traceback'], file=sys.stderr)
finally:
    REPORT['pid'] = os.getpid()
    REPORT['proc_memory_final'] = common.proc_memory()
    common.save('ORIGINAL_RESULT.json', REPORT)
    print(json.dumps({'status': REPORT['status']}))
if REPORT['status'] != 'ORIGINAL_W2V_DONE':
    raise SystemExit(1)
