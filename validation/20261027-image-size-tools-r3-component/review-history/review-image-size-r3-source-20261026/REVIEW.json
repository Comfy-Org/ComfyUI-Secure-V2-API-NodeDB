      "file": "packet/consumer/image_size_fixture.py",
      "finding": "RAW_PERMISSION_DENIAL and PARTIAL are initialized before dispatch; requested/granted permissions and dispatch count are saved before actual session.execute. The finally path persists counters, input fingerprint and cached-PID limitation even on early guard failure. Success still requires real wire/phase/frame, exact contract, empty grant, unchanged input and explicit ref release/clear.",
      "id": "F2",
      "line": 326
    },
    {
      "disposition": "CLEAR",
      "file": "operator-scripts/sdk_image_size_tools_outer_r2.py",
