// LoRA Manager rev 10 unit tests against hermetic guest fakes (MERVYN m_6934bd4d0f; run approved in m_8fa000143e).
// Only converted code runs: the assembled rev 10 secure_web (main a45522ff plus the candidate overlay) and, for the
// before/after contrasts, main's own secure_web copies. The original TriggerWord serializer is a checked transcription
// (original_serializer_transcribed.mjs). No network, no installs, nothing loaded from the corpus.
//
// usage: node run_rev10_tests.mjs <assembled secure_web dir> <base secure_web dir> <original trigger_word_toggle.js> <out.json>
import assert from 'node:assert/strict';
import { createHash } from 'node:crypto';
import fs from 'node:fs';
import path from 'node:path';
import { Worker } from 'node:worker_threads';
import { fileURLToPath, pathToFileURL } from 'node:url';
import { createHost } from './fakes.mjs';
import { SOURCE, originalSerializeValue } from './original_serializer_transcribed.mjs';

const HERE = path.dirname(fileURLToPath(import.meta.url));
const ROOT = path.dirname(HERE); // the rev 10 workspace
const [assembledDir, baseDir, originalFile, outFile] = process.argv.slice(2).map(arg => path.resolve(arg));
if (!outFile) { console.error('usage: node run_rev10_tests.mjs <assembled> <base> <original trigger_word_toggle.js> <out.json>'); process.exit(64); }
const rel = file => path.relative(ROOT, file).split(path.sep).join('/');
const sha256 = data => createHash('sha256').update(data).digest('hex');
const fileSha = file => sha256(fs.readFileSync(file));

// ---- Preconditions: the transcription is byte-faithful and the inputs are the pinned ones. ----
function transcriptionCheck() {
  const original = fs.readFileSync(originalFile);
  const lines = original.toString('utf8').split('\n');
  const span = (from, to) => lines.slice(from - 1, to).join('\n') + '\n';
  const transcribed = fs.readFileSync(path.join(HERE, 'original_serializer_transcribed.mjs'), 'utf8').split('\n');
  const begin = transcribed.indexOf('// BEGIN BODY'), end = transcribed.indexOf('// END BODY');
  const body = transcribed.slice(begin + 1, end).join('\n') + '\n';
  const check = {
    originalFile: rel(originalFile),
    fileSha256: sha256(original), expectedFileSha256: SOURCE.fileSha256,
    linesSha256: sha256(span(SOURCE.lines[0], SOURCE.lines[1])), expectedLinesSha256: SOURCE.linesSha256,
    sourceBodySha256: sha256(span(SOURCE.bodyLines[0], SOURCE.bodyLines[1])),
    transcribedBodySha256: sha256(body), expectedBodySha256: SOURCE.bodySha256,
    noCarriageReturns: !original.includes(13),
    firstLine: lines[SOURCE.lines[0] - 1].trim(), lastLine: lines[SOURCE.lines[1] - 1].trim(),
  };
  check.ok = check.fileSha256 === check.expectedFileSha256 && check.linesSha256 === check.expectedLinesSha256 &&
    check.sourceBodySha256 === check.expectedBodySha256 && check.transcribedBodySha256 === check.expectedBodySha256 &&
    check.noCarriageReturns && check.firstLine === 'result.widget.serializeValue = function() {' && check.lastLine === '};';
  return check;
}
const transcription = transcriptionCheck();
if (!transcription.ok) {
  fs.writeFileSync(outFile, JSON.stringify({ refused: 'transcription check failed', transcription }, null, 2) + '\n');
  console.error('REFUSED: the TriggerWord transcription does not match its pinned source');
  process.exit(2);
}

// The pack's own example workflows, saved by the original: data only, copied with tests/fixtures/example_workflows/FIXTURES.tsv.
const WORKFLOW_FIXTURES = Object.freeze({
  'Lora_Manager_Basic.json': 'a57824e8379759b0caf4f336c6e11fcb3173f480eaf02f669764fc066c38d782',
  'nunchaku-flux.1-dev.json': 'a3bcedf53fdbf3093bed0ed70d1829e5144ccdd920143b119ae09a949ae5ff35',
  'wanvideo_1_3B_control_lora_example_01.json': '14ffb5c5fa4ddb6611cc49226006e9d574de78d2cb683ff6f280cf152e14fd43',
});
const workflows = {};
for (const [name, expected] of Object.entries(WORKFLOW_FIXTURES)) {
  const bytes = fs.readFileSync(path.join(HERE, 'fixtures', 'example_workflows', name));
  if (sha256(bytes) !== expected) {
    fs.writeFileSync(outFile, JSON.stringify({ refused: `fixture ${name} does not match its recorded sha256` }, null, 2) + '\n');
    console.error(`REFUSED: fixture ${name} changed`);
    process.exit(2);
  }
  workflows[name] = JSON.parse(bytes.toString('utf8'));
}
const nodeOf = (workflow, id) => structuredClone(workflow.nodes.find(node => node.id === id));

const listFiles = dir => fs.readdirSync(dir).filter(name => fs.statSync(path.join(dir, name)).isFile()).sort();
const manifest = dir => Object.fromEntries(listFiles(dir).map(name => [name, fileSha(path.join(dir, name))]));
const inputs = {
  node: process.version, platform: process.platform,
  assembled: { dir: rel(assembledDir), files: manifest(assembledDir) },
  base: { dir: rel(baseDir), files: manifest(baseDir) },
  tests: Object.fromEntries(['fakes.mjs', 'entry_worker.mjs', 'original_serializer_transcribed.mjs', 'run_rev10_tests.mjs']
    .map(name => [name, fileSha(path.join(HERE, name))])),
  transcription,
  workflowFixtures: WORKFLOW_FIXTURES,
};

// ---- Harness ----
const unhandled = [];
process.on('unhandledRejection', reason => { unhandled.push(String(reason?.stack ?? reason).slice(0, 600)); });
const wait = ms => new Promise(resolve => setTimeout(resolve, ms));
const settle = async (rounds = 4) => { for (let i = 0; i < rounds; i++) await wait(0); };
const quiesce = async () => { await settle(); await wait(200); await settle(); }; // past the native 80 ms debounce
const results = [];
async function test(id, title, fn) {
  const logs = [];
  const saved = {};
  for (const level of ['log', 'info', 'warn', 'error']) {
    saved[level] = console[level];
    console[level] = (...args) => logs.push({ level, text: args.map(arg => String(arg?.stack ?? arg)).join(' ').slice(0, 400) });
  }
  const unhandledBefore = unhandled.length;
  const result = { id, title };
  try {
    result.evidence = await fn(logs);
    await settle();
    if (unhandled.length > unhandledBefore) throw new Error('unhandled rejection: ' + unhandled.slice(unhandledBefore).join(' | '));
    result.pass = true;
  } catch (error) {
    await settle();
    result.pass = false;
    result.error = String(error?.stack ?? error).slice(0, 2000);
  } finally {
    for (const level of Object.keys(saved)) console[level] = saved[level];
  }
  result.logs = logs;
  results.push(result);
  saved.log(`${result.pass ? 'PASS' : 'FAIL'} ${id} ${title}`);
}
const load = (dir, file) => import(pathToFileURL(path.join(dir, file)).href);
const runWorker = data => new Promise((resolve, reject) => {
  const worker = new Worker(new URL('./entry_worker.mjs', import.meta.url), { workerData: data });
  let message = null;
  worker.once('message', value => { message = value; });
  worker.once('error', reject);
  worker.once('exit', code => (code === 0 && message ? resolve(message) : reject(new Error(`worker exit ${code}`))));
});

const rev10 = await load(assembledDir, 'lm_frontends.js');
const triggerLogic = await load(assembledDir, 'trigger_logic.js');
const { mergeLoras } = await load(assembledDir, 'stacker_merge.js');
const { normalizeRows } = await load(assembledDir, 'catalogue_selection.js');
const base = {
  prompt: await load(baseDir, 'prompt_inputs.js'),
  stack: await load(baseDir, 'stack_inputs.js'),
  save: await load(baseDir, 'save_image_extra_output.js'),
  metadata: await load(baseDir, 'metadata_display.js'),
  hook: await load(baseDir, 'create_hook_lora.js'),
};

const TYPES = {
  prompt: 'Prompt (LoraManager)', combiner: 'Lora Stack Combiner (LoraManager)', save: 'Save Image (LoraManager)',
  metadata: 'Debug Metadata (LoraManager)', loader: 'Lora Loader (LoraManager)', stacker: 'Lora Stacker (LoraManager)',
  hook: 'Create Hook LoRA (LoraManager)', wan: 'WanVideo Lora Select (LoraManager)', text: 'Text (LoraManager)',
  randomizer: 'Lora Randomizer (LoraManager)',
};
const FRONTEND_NAMES = ['widgetTypes', 'promptInputs', 'stackInputs', 'saveImage', 'metadataDisplay', 'textRowSync', 'createHook', 'savedLayouts'];
const WIDGET_TYPES = ['LORAS', 'AUTOCOMPLETE_TEXT_LORAS', 'AUTOCOMPLETE_TEXT_PROMPT'];
const LORAS_PLACEHOLDER = 'Search LoRAs to add...';
const PROMPT_PLACEHOLDER = 'Enter prompt... /character, /artist, /wildcard for quick search';
// Input declarations as in v2/secure-nodes.json (a45522ff): the Loader declares model, text, loras and the optional clip and
// lora_stack; the Stacker, Create Hook and WanVideo Lora Select declare text and loras (WanVideo also two BOOLEANs).
const lorasInputs = ({ text, loras, lead = [], tail = [] } = {}) => [
  ...lead,
  { name: 'text', type: 'AUTOCOMPLETE_TEXT_LORAS', options: { placeholder: LORAS_PLACEHOLDER }, ...(text !== undefined ? { value: text } : {}) },
  { name: 'loras', type: 'LORAS', options: {}, ...(loras !== undefined ? { value: loras } : {}) },
  ...tail,
];
const loaderInputs = values => lorasInputs({ ...values, lead: [{ name: 'model', type: 'MODEL' }],
  tail: [{ name: 'clip', type: 'CLIP', optional: true }, { name: 'lora_stack', type: 'LORA_STACK', optional: true }] });
const wanInputs = () => lorasInputs({ lead: [{ name: 'low_mem_load', type: 'BOOLEAN', value: false }, { name: 'merge_loras', type: 'BOOLEAN', value: true }] });
const promptInputs = () => [
  { name: 'text', type: 'AUTOCOMPLETE_TEXT_PROMPT,STRING', widgetType: 'AUTOCOMPLETE_TEXT_PROMPT', options: { placeholder: PROMPT_PLACEHOLDER } },
  { name: 'clip', type: 'CLIP' },
  { name: 'trigger_words1', type: 'STRING', forceInput: true, optional: true },
];
const saveInputs = () => [
  { name: 'images', type: 'IMAGE' },
  { name: 'filename_prefix', type: 'STRING', value: 'ComfyUI_%date:yyyy-MM-dd%' },
  { name: 'file_format', type: 'COMBO', value: 'png' },
  { name: 'lossless_webp', type: 'BOOLEAN', value: false },
  { name: 'quality', type: 'INT', value: 100 },
  { name: 'webp_method', type: 'INT', value: 6 },
  { name: 'jpeg_subsampling', type: 'COMBO', value: '4:2:0' },
];
const slotNames = entry => entry.slots.map(slot => slot.name);
const renderOf = (entry, name) => entry.widgetTypeRenders.find(render => render.name === name)?.container ?? null;
const valueOf = (entry, name) => entry.node.widgets.get(name)?.getValue();
const press = (container, label) => {
  const element = container.byLabel(label);
  assert.ok(element, `no element labelled ${label}`);
  element.dispatch('click');
};
const typeInto = (container, label, text) => {
  const element = container.byLabel(label);
  assert.ok(element, `no element labelled ${label}`);
  element.dispatch('input', { value: text });
};
const changeInput = (container, label, text) => {
  const element = container.byLabel(label);
  assert.ok(element, `no element labelled ${label}`);
  element.dispatch('change', { value: text });
};
function disposeAll(registered) {
  const outcome = {};
  for (const [name, value] of Object.entries(registered)) {
    try {
      if (typeof value === 'function') value();
      else if (value && typeof value.dispose === 'function') value.dispose();
      outcome[name] = 'ok';
    } catch (error) { outcome[name] = 'threw ' + (error?.name ?? 'Error') + ': ' + error?.message; }
  }
  return outcome;
}
const rowsSummary = rows => (rows || []).map(row => `${row.name}:${row.strength}:${row.clipStrength}:${row.active ? 'on' : 'off'}`);

// =====================================================================================================================
// E: the self-registering entry, loaded in a fresh worker realm per host model.
// =====================================================================================================================
const EXPECTED_EXTENDS = [[TYPES.prompt], [TYPES.combiner], [TYPES.save], [TYPES.metadata], [TYPES.loader, TYPES.stacker], [TYPES.hook], [TYPES.text], [TYPES.wan]];
for (const [id, model, defineVariant] of [['E1', 'live', 'throw'], ['E2', 'live', 'reject'], ['E3', 'r4a', undefined]]) {
  await test(id, `entry: lm_frontends.js self-registers once on ${model}${defineVariant ? ` (defineWidgetType ${defineVariant})` : ''}`, async () => {
    const out = await runWorker({ secureWeb: assembledDir, model, defineVariant });
    assert.equal(out.workerError, undefined, out.workerError);
    assert.deepEqual(out.frontendOrder, FRONTEND_NAMES);
    assert.deepEqual(out.first.failed, {});
    assert.deepEqual(Object.keys(out.first.registered), FRONTEND_NAMES);
    assert.deepEqual(out.extendCalls, EXPECTED_EXTENDS);
    assert.deepEqual(out.defineCalls, WIDGET_TYPES);
    const types = out.first.registered.widgetTypes;
    if (model === 'live') {
      assert.equal(types.available, false);
      assert.deepEqual(out.widgetTypesRegistered, []);
      for (const result of types.results) {
        assert.equal(result.registered, false);
        if (defineVariant === 'throw') assert.match(result.reason, /^DataCloneError: /);
        else assert.equal(result.reason, 'no widget-type bridge');
      }
    } else {
      assert.equal(types.available, true);
      assert.deepEqual(types.results, WIDGET_TYPES.map(type => ({ type, registered: true })));
      assert.deepEqual(out.widgetTypesRegistered, WIDGET_TYPES);
    }
    assert.deepEqual(out.secondLoad, { extendCallsAdded: 0, defineCallsAdded: 0, sameState: true });
    assert.deepEqual(out.markDescriptor, { configurable: false, writable: false, enumerable: false });
    assert.equal(out.deleteMark, 'threw: TypeError');
    assert.deepEqual(out.packerrors, []);
    assert.deepEqual(out.unhandled, []);
    assert.deepEqual(out.logs, []);
    return { widgetTypes: types, secondLoad: out.secondLoad, markDescriptor: out.markDescriptor };
  });
}

// =====================================================================================================================
// L: (a) frontends on the live guest model; (b) inert there.
// =====================================================================================================================
await test('L1', 'live: Prompt trigger_words sockets grow, shrink and renumber', async () => {
  const host = createHost({ model: 'live' });
  const { failed } = rev10.registerLoraManagerFrontends(host.comfy);
  assert.deepEqual(failed, {});
  const node = host.createNode(TYPES.prompt, { inputs: promptInputs() });
  const trace = [slotNames(node)];
  assert.deepEqual(trace[0], ['text', 'clip', 'trigger_words1']); // live: no AUTOCOMPLETE_TEXT_PROMPT widget, so a socket
  host.connect(node, 'trigger_words1', true); trace.push(slotNames(node));
  assert.deepEqual(trace.at(-1), ['text', 'clip', 'trigger_words1', 'trigger_words2']);
  host.connect(node, 'trigger_words2', true); trace.push(slotNames(node));
  assert.deepEqual(trace.at(-1), ['text', 'clip', 'trigger_words1', 'trigger_words2', 'trigger_words3']);
  host.connect(node, 'trigger_words1', false); trace.push(slotNames(node));
  assert.deepEqual(trace.at(-1), ['text', 'clip', 'trigger_words1', 'trigger_words2']);
  assert.deepEqual(node.slots.map(slot => slot.connected), [false, false, true, false]);
  assert.deepEqual(host.record.packerrors, []);
  return { trace };
});

await test('L2', 'live: Lora Stack Combiner lora_stackN sockets grow, shrink, renumber; legacy and empty nodes', async () => {
  const host = createHost({ model: 'live' });
  rev10.registerLoraManagerFrontends(host.comfy);
  const stackInput = name => ({ name, type: 'LORA_STACK', optional: true });
  const node = host.createNode(TYPES.combiner, { inputs: [stackInput('lora_stack1'), stackInput('lora_stack2')] });
  const trace = [slotNames(node)];
  host.connect(node, 'lora_stack2', true); trace.push(slotNames(node));
  host.connect(node, 'lora_stack3', true); trace.push(slotNames(node));
  host.connect(node, 'lora_stack2', false); trace.push(slotNames(node));
  assert.deepEqual(trace, [
    ['lora_stack1', 'lora_stack2'],
    ['lora_stack1', 'lora_stack2', 'lora_stack3'],
    ['lora_stack1', 'lora_stack2', 'lora_stack3', 'lora_stack4'],
    ['lora_stack1', 'lora_stack2', 'lora_stack3'],
  ]);
  assert.deepEqual(node.slots.map(slot => slot.connected), [false, true, false]);
  const empty = host.createNode(TYPES.combiner, { inputs: [] });
  assert.deepEqual(slotNames(empty), ['lora_stack1', 'lora_stack2']);
  const legacy = host.createNode(TYPES.combiner, { inputs: [stackInput('lora_stack_a'), stackInput('lora_stack_b')] });
  assert.deepEqual(slotNames(legacy), ['lora_stack_a', 'lora_stack_b']);
  assert.deepEqual(host.record.packerrors, []);
  return { trace, empty: slotNames(empty), legacy: slotNames(legacy) };
});

await test('L3', 'live: Save Image toggles webp/jpeg widgets; serialization sends the widget value unchanged (G1)', async () => {
  const host = createHost({ model: 'live' });
  rev10.registerLoraManagerFrontends(host.comfy);
  const node = host.createNode(TYPES.save, { inputs: saveInputs() });
  const state = name => { const widget = node.widgetStates.get(name); return { disabled: widget.disabled, hidden: widget.hidden }; };
  const trace = [{ format: 'png', webp: state('webp_method'), jpeg: state('jpeg_subsampling') }];
  for (const format of ['webp', 'jpeg', 'png']) {
    node.node.widgets.get('file_format').setValue(format);
    trace.push({ format, webp: state('webp_method'), jpeg: state('jpeg_subsampling') });
  }
  const hidden = { disabled: true, hidden: true }, shown = { disabled: false, hidden: false };
  assert.deepEqual(trace.map(step => [step.webp, step.jpeg]), [[hidden, hidden], [shown, hidden], [hidden, shown], [hidden, hidden]]);
  const values = host.serialize(node);
  assert.equal(values.filename_prefix, 'ComfyUI_%date:yyyy-MM-dd%');
  assert.deepEqual(host.record.packerrors, []);
  return { trace, serializedFilenamePrefix: values.filename_prefix };
});

await test('L4', 'live: Debug Metadata panel mounts without a value cell (R6-4) and shows execution metadata', async () => {
  const host = createHost({ model: 'live' });
  rev10.registerLoraManagerFrontends(host.comfy);
  const node = host.createNode(TYPES.metadata, { inputs: [{ name: 'images', type: 'IMAGE' }] });
  const panel = node.mountedRenders.find(render => render.name === 'metadata')?.container;
  assert.ok(panel, 'metadata panel mounted');
  const placeholder = panel.text();
  assert.match(placeholder, /No metadata available/);
  host.execute(node, { metadata: [{ seed: 42, steps: 30, loras: '<lora:a:1.00>' }] });
  const shown = panel.text();
  assert.match(shown, /"seed": 42/);
  assert.match(shown, /"loras": "<lora:a:1\.00>"/);
  host.execute(node, { metadata: ['{"cfg": 7}'] });
  assert.match(panel.text(), /"cfg": 7/);
  host.execute(node, { other: true }); // no metadata key: unchanged, as native
  assert.match(panel.text(), /"cfg": 7/);
  host.serialize(node);
  assert.deepEqual(host.record.packerrors, []);
  return { placeholder, shown };
});

await test('L5', 'live: Loader, Stacker, WanVideo Lora Select, Text, Randomizer stay sockets; nothing wired', async () => {
  const host = createHost({ model: 'live' });
  rev10.registerLoraManagerFrontends(host.comfy);
  const loader = host.createNode(TYPES.loader, { inputs: loaderInputs() });
  const stacker = host.createNode(TYPES.stacker, { inputs: lorasInputs() });
  const wan = host.createNode(TYPES.wan, { inputs: wanInputs() });
  const text = host.createNode(TYPES.text, { inputs: [promptInputs()[0]] });
  const randomizer = host.createNode(TYPES.randomizer, { inputs: [{ name: 'randomizer_config', type: 'RANDOMIZER_CONFIG' }, { name: 'loras', type: 'LORAS' }] });
  const evidence = {};
  for (const [name, entry] of Object.entries({ loader, stacker, wan, text, randomizer })) {
    const widgets = entry.node.widgets.names();
    assert.ok(!widgets.includes('text') && !widgets.includes('loras'), name + ' has no text/loras widget');
    assert.equal(entry.node.serializingWidgets, false, name + ' untouched');
    assert.equal(entry.widgetTypeRenders.length, 0);
    evidence[name] = slotNames(entry);
  }
  assert.deepEqual(evidence.loader, ['model', 'text', 'loras', 'clip', 'lora_stack']);
  assert.deepEqual(evidence.stacker, ['text', 'loras']); // no lora_stack added on live: (b) is inert
  assert.deepEqual(host.record.packerrors, []);
  return evidence;
});

await test('L6', 'live: Create Hook LoRA adds prev_hooks and stays inert without its widgets', async logs => {
  const host = createHost({ model: 'live' });
  rev10.registerLoraManagerFrontends(host.comfy);
  const node = host.createNode(TYPES.hook, { inputs: lorasInputs() });
  assert.deepEqual(node.slots.map(slot => [slot.name, slot.type, slot.shape]),
    [['text', 'AUTOCOMPLETE_TEXT_LORAS', 'default'], ['loras', 'LORAS', 'default'], ['prev_hooks', 'HOOKS', 'optional']]);
  assert.ok(logs.some(entry => entry.level === 'warn' && /text\/loras widgets not found for Create Hook LoRA/.test(entry.text)));
  assert.deepEqual(host.record.packerrors, []);
  return { slots: slotNames(node) };
});

await test('L7', 'live: dispose never throws (extend returns a Promise) and leaves the hooks inert', async () => {
  const host = createHost({ model: 'live' });
  const { registered } = rev10.registerLoraManagerFrontends(host.comfy);
  const prompt = host.createNode(TYPES.prompt, { inputs: promptInputs() });
  const first = disposeAll(registered);
  const second = disposeAll(registered);
  assert.deepEqual(first, Object.fromEntries(FRONTEND_NAMES.map(name => [name, 'ok'])));
  assert.deepEqual(second, first);
  host.connect(prompt, 'trigger_words1', true);
  assert.deepEqual(slotNames(prompt), ['text', 'clip', 'trigger_words1']); // disposed: no socket added
  const combiner = host.createNode(TYPES.combiner, { inputs: [] });
  assert.deepEqual(slotNames(combiner), []);
  return { first, afterDispose: { prompt: slotNames(prompt), combiner: slotNames(combiner) } };
});

await test('L8', 'live: one refused frontend is logged and does not stop the others', async logs => {
  const host = createHost({ model: 'live' });
  const extend = host.comfy.defs.extend;
  host.comfy.defs.extend = (selector, apply) => {
    if (selector === TYPES.save) throw new Error('host refused Save Image');
    return extend(selector, apply);
  };
  const { registered, failed } = rev10.registerLoraManagerFrontends(host.comfy);
  assert.deepEqual(failed, { saveImage: 'host refused Save Image' });
  assert.deepEqual(Object.keys(registered), FRONTEND_NAMES.filter(name => name !== 'saveImage'));
  assert.ok(logs.some(entry => entry.level === 'error' && /the saveImage frontend was not registered/.test(entry.text)));
  const prompt = host.createNode(TYPES.prompt, { inputs: promptInputs() });
  host.connect(prompt, 'trigger_words1', true);
  assert.deepEqual(slotNames(prompt), ['text', 'clip', 'trigger_words1', 'trigger_words2']);
  return { failed };
});

await test('L9', 'live: a rejected extend acknowledgement and a rejected defineWidgetType leave no unhandled rejection', async logs => {
  const host = createHost({ model: 'live', defineVariant: 'reject' });
  const extend = host.comfy.defs.extend;
  host.comfy.defs.extend = (selector, apply) => {
    const sent = extend(selector, apply);
    return selector === TYPES.metadata ? Promise.reject(new Error('host refused the definition hook')) : sent;
  };
  const { registered, failed } = rev10.registerLoraManagerFrontends(host.comfy);
  assert.deepEqual(failed, {});
  assert.deepEqual(registered.widgetTypes.results.map(result => result.reason), WIDGET_TYPES.map(() => 'no widget-type bridge'));
  await settle();
  assert.ok(logs.some(entry => entry.level === 'error' && /a node definition hook was refused by the host/.test(entry.text)));
  return { widgetTypes: registered.widgetTypes.results };
});

// =====================================================================================================================
// B: main's (rev 9) modules on the live guest model, for contrast: the failures the rev 10 edits remove.
// =====================================================================================================================
await test('B1', 'contrast: main prompt_inputs/stack_inputs throw at registration on live; rev 10 does not', async () => {
  const host = createHost({ model: 'live' });
  assert.throws(() => base.prompt.registerPromptInputs(host.comfy), /Definition unsubscribe contract is unavailable/);
  assert.throws(() => base.stack.registerStackInputs(host.comfy), /Definition unsubscribe contract is unavailable/);
  const fresh = createHost({ model: 'live' });
  const { failed } = rev10.registerLoraManagerFrontends(fresh.comfy);
  assert.deepEqual(failed, {});
  return { main: 'throws Error: Definition unsubscribe contract is unavailable', rev10: 'registered' };
});

