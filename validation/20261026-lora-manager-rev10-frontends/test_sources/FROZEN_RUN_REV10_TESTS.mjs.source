await test('L10', 'live: Create Hook, Text and Wan loads are inert (no widget types): no writes, no errors', async logs => {
  const host = createHost({ model: 'live' });
  rev10.registerLoraManagerFrontends(host.comfy);
  const hook = await host.load(TYPES.hook, { inputs: lorasInputs() }, derived(TYPES.hook, [{ ...META }, BASIC_TEXT, BASIC_ROWS]));
  const text = await host.load(TYPES.text, { inputs: textInputs() }, derived(TYPES.text, [{ ...META }, PROMPT_TEXT]));
  const wan = await host.load(TYPES.wan, { inputs: wanInputs() }, derived(TYPES.wan, [WAN_LOW_MEM, true, { ...META }, WAN_TEXT, WAN_ROWS]));
  await quiesce();
  assert.deepEqual(hook.node.widgets.names(), []);
  assert.deepEqual(slotNames(hook), ['text', 'loras', 'prev_hooks']);
  assert.deepEqual(text.node.widgets.names(), []);
  assert.deepEqual(wan.node.widgets.names(), ['low_mem_load', 'merge_loras']);
  assert.deepEqual([valueOf(wan, 'low_mem_load'), valueOf(wan, 'merge_loras')], [WAN_LOW_MEM, true]);
  noWrites(wan, 'live Wan');
  assert.ok(logs.some(entry => entry.level === 'warn' && /text\/loras widgets not found for Create Hook LoRA/.test(entry.text)));
  assert.deepEqual(host.record.packerrors, []);
  return { hook: slotNames(hook), wan: wan.node.widgets.names() };
});

// =====================================================================================================================
// T: TriggerWord Toggle: can a #11 widget type reproduce the original serializer byte for byte?
// =====================================================================================================================
const { reconcileTags, applyHighlightTags, collectHighlightTokens, serializeTags } = triggerLogic;
const withStrength = (tags, strengths) => tags.map((tag, index) => (index in strengths ? { ...tag, strength: strengths[index] } : tag));
// Real trigger-word strings from the pack's own tests (v2/tests/nodes/test_trigger_word_toggle.py and
// v2/tests/frontend/components/triggerWords.escaping.test.js); tag values are built with the converted reconcileTags.
const FIXTURES = [
  { id: 'F1', source: 'test_trigger_words_same_as_original_processes_toggle', mode: 'tags, no strength',
    tags: () => reconcileTags([], 'word1, word2', false, true, false).map((tag, i) => ({ ...tag, active: i === 0 })) },
  { id: 'F2', source: 'test_group_mode_preserves_parenthesized_groups', mode: 'tags, strengths adjusted',
    tags: () => withStrength(reconcileTags([], 'flat color, dark theme, (a, really, long, test, trigger, word:1.06), (sinozick style:0.94)', false, true, true), { 0: 1.2, 3: 1.1 }) },
  { id: 'F3', source: 'test_duplicate_words_preserve_strength_per_instance', mode: 'duplicate tags, per-instance strengths',
    tags: () => reconcileTags([
      { text: '(A:0.50)', active: false, strength: 0.5, highlighted: false },
      { text: 'A', active: true, strength: 1.2, highlighted: false },
      { text: '(A:0.75)', active: true, strength: 0.75, highlighted: false },
    ], 'A, A, A', false, true, true) },
  { id: 'F4', source: 'test_group_mode_keeps_group_strength_when_individual_tags_are_excluded', mode: 'group with items and a group strength',
    tags: () => reconcileTags([{ text: '(outfit red, outfit blue, smiling:1.15)', active: true, strength: 1.15, highlighted: false,
      items: [{ text: 'outfit red', active: true, highlighted: false }, { text: 'outfit blue', active: false, highlighted: false }, { text: 'smiling', active: true, highlighted: false }] }],
    'outfit red, outfit blue, smiling', true, true, true) },
  { id: 'F5', source: 'test_group_mode_omits_group_when_all_children_are_disabled', mode: 'groups, no strength',
    tags: () => reconcileTags([], 'A, B,, C, D', true, true, false).map((tag, i) => (i === 0 ? { ...tag, items: tag.items.map(item => ({ ...item, active: false })) } : tag)) },
  { id: 'F6', source: 'triggerWords.escaping.test.js + test_trigger_words_override_different_from_original', mode: 'markup characters, highlight, one strength',
    tags: () => withStrength(applyHighlightTags(reconcileTags([], '<style>guangying</style>, fym <artist>, 69yottea_style_illu', false, true, true),
      collectHighlightTokens(['69yottea_style_illu'])), { 1: 0.8 }) },
  { id: 'F7', source: 'test_trigger_words_override_with_new_format', mode: 'group, default inactive, highlight, group strength',
    tags: () => withStrength(applyHighlightTags(reconcileTags([], 'masterpiece, best quality, very aesthetic, absurdres', true, false, true),
      collectHighlightTokens(['best quality'])), { 0: 1.05 }) },
];
const tagDiffs = (left, right) => left.flatMap((tag, index) => (JSON.stringify(tag) === JSON.stringify(right[index]) ? [] :
  [{ index, original: tag.text, widgetType: right[index]?.text, strength: right[index]?.strength }]));
const triggerWord = { fixtures: [] };
await test('T1', 'TriggerWord: the converted serializeTags equals the transcribed original serializer on every fixture', async () => {
  for (const fixture of FIXTURES) {
    const tags = fixture.tags();
    const original = originalSerializeValue.call({ value: structuredClone(tags) });
    const converted = serializeTags(structuredClone(tags));
    assert.equal(JSON.stringify(converted), JSON.stringify(original), fixture.id);
  }
  return { fixtures: FIXTURES.length };
});
await test('T2', 'TriggerWord: a #11 type serializing its one value cannot match the original prompt bytes (stays under (c))', async () => {
  for (const fixture of FIXTURES) {
    const tags = fixture.tags();
    const value = structuredClone(tags);
    const originalPrompt = JSON.stringify(originalSerializeValue.call({ value: structuredClone(tags) }));
    const originalValue = JSON.stringify(value); // what the original widget holds (and LiteGraph saves as widgets_values)
    const widgetTypeSent = JSON.stringify(structuredClone(tags)); // a #11 type: core serializes the stored value as-is
    const promptForm = JSON.parse(originalPrompt); // the alternative: store the prompt form as the value
    const hasStrength = tags.some(tag => tag.strength !== undefined && tag.strength !== null);
    const record = {
      id: fixture.id, source: fixture.source, mode: fixture.mode, tags: tags.length,
      sha256: { originalPrompt: sha256(originalPrompt), originalValue: sha256(originalValue), widgetTypeSent: sha256(widgetTypeSent) },
      bytes: { originalPrompt: Buffer.byteLength(originalPrompt), widgetTypeSent: Buffer.byteLength(widgetTypeSent) },
      rawValueMatchesOriginalPrompt: widgetTypeSent === originalPrompt,
      rawValueMatchesOriginalValue: widgetTypeSent === originalValue,
      promptFormMatchesOriginalValue: JSON.stringify(promptForm) === originalValue,
      differingTags: tagDiffs(JSON.parse(originalPrompt), JSON.parse(widgetTypeSent)),
    };
    assert.equal(record.rawValueMatchesOriginalPrompt, !hasStrength, fixture.id + ' prompt match iff no strength');
    assert.equal(record.rawValueMatchesOriginalValue, true);
    assert.equal(record.promptFormMatchesOriginalValue, !hasStrength);
    triggerWord.fixtures.push(record);
  }
  triggerWord.exact = triggerWord.fixtures.every(record => record.rawValueMatchesOriginalPrompt && record.promptFormMatchesOriginalValue);
  assert.equal(triggerWord.exact, false);
  return { exact: triggerWord.exact, differing: triggerWord.fixtures.filter(record => record.differingTags.length).map(record => record.id) };
});

// ---- Report ----
await settle();
const summary = { total: results.length, passed: results.filter(result => result.pass).length };
summary.failed = summary.total - summary.passed;
const report = { suite: 'lora-rev10-frontends unit tests (hermetic guest fakes)', inputs, summary, triggerWord, unhandled, results };
fs.writeFileSync(outFile, JSON.stringify(report, null, 2) + '\n');
console.log(`${summary.passed}/${summary.total} passed; TriggerWord exact: ${triggerWord.exact}; report ${rel(outFile)} sha256 ${fileSha(outFile)}`);
process.exitCode = summary.failed ? 1 : 0;
