  typeInto(panel, 'text', 'a cat, (masterpiece:1.2)');
  await settle();
  assert.equal(valueOf(node, 'text'), 'a cat, (masterpiece:1.2)');
  node.node.widgets.get('text').setValue('loaded prompt');
  await settle();
  assert.equal(textarea.value, 'loaded prompt');
  assert.equal(textarea.textContent, 'loaded prompt');
  typeInto(panel, 'text', 'x'.repeat(262145));
  await settle();
  assert.equal(valueOf(node, 'text'), 'loaded prompt');
  assert.match(panel.text(), /262144-byte owned profile/);
  host.connect(node, 'trigger_words1', true);
  assert.deepEqual(slotNames(node), ['clip', 'trigger_words1', 'trigger_words2']);
  assert.equal(host.serialize(node).text, 'loaded prompt');
  return { slots: slotNames(node) };
});

