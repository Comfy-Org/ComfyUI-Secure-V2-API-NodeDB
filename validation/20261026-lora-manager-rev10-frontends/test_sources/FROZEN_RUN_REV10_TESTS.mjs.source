// =====================================================================================================================
// R: (b) on the r4a/#11 model. The text <-> rows tests run with synchronous and asynchronous change delivery.
// =====================================================================================================================
await test('R0', 'r4a: the three widget types register with closed definitions', async () => {
  const host = createHost({ model: 'r4a' });
  const { registered, failed } = rev10.registerLoraManagerFrontends(host.comfy);
  assert.deepEqual(failed, {});
  assert.equal(registered.widgetTypes.available, true);
  assert.deepEqual([...host.widgetTypes.keys()], WIDGET_TYPES);
  const defs = Object.fromEntries([...host.widgetTypes].map(([type, def]) => [type,
    Object.fromEntries(Object.entries(def).map(([key, value]) => [key, typeof value === 'function' ? 'function' : value]))]));
  assert.deepEqual(defs, {
    LORAS: { defaultValue: [], minHeight: 160, serialize: true, render: 'function' },
    AUTOCOMPLETE_TEXT_LORAS: { defaultValue: '', minHeight: 56, serialize: true, render: 'function' },
    AUTOCOMPLETE_TEXT_PROMPT: { defaultValue: '', minHeight: 56, serialize: true, render: 'function' },
  });
  // A second registration in the same host (no entry guard) is refused per type and recorded, not thrown.
  const again = rev10.registerLoraManagerFrontends(host.comfy).registered.widgetTypes;
  assert.equal(again.available, false);
  assert.ok(again.results.every(result => !result.registered && /already registered/.test(result.reason)));
  return { defs, secondRegistration: again.results };
});

for (const delivery of ['sync', 'async']) {
  await test(`R1.${delivery}`, `r4a (${delivery}): Loader rows editor adds a LoRA; the text follows after the debounce`, async () => {
    const host = createHost({ model: 'r4a', delivery });
    rev10.registerLoraManagerFrontends(host.comfy);
    const node = host.createNode(TYPES.loader, { inputs: loaderInputs() });
    // clip and lora_stack are declared: the socket check finds them and adds nothing.
    assert.deepEqual(node.slots.map(slot => [slot.name, slot.type, slot.shape]),
      [['model', 'MODEL', 'default'], ['clip', 'CLIP', 'optional'], ['lora_stack', 'LORA_STACK', 'optional']]);
    assert.deepEqual(node.node.widgets.names(), ['text', 'loras']);
    assert.equal(node.node.serializingWidgets, true);
    await settle(); // catalogue refresh
    assert.equal(host.record.modelsListCalls, 1);
    const rows = renderOf(node, 'loras');
    press(rows, 'loras.add.a.safetensors');
    await quiesce();
    assert.equal(valueOf(node, 'text'), '<lora:a:1.00>');
    assert.deepEqual(rowsSummary(valueOf(node, 'loras')), ['a:1:1:on']);
    assert.equal(valueOf(node, 'loras')[0].selected, true);
    press(renderOf(node, 'loras'), 'loras.add.b.safetensors');
    await quiesce();
    assert.equal(valueOf(node, 'text'), '<lora:a:1.00> <lora:b:1.00>');
    press(renderOf(node, 'loras'), 'loras.remove.a');
    await quiesce();
    assert.equal(valueOf(node, 'text'), '<lora:b:1.00>');
    assert.deepEqual(rowsSummary(valueOf(node, 'loras')), ['b:1:1:on']);
    const textarea = renderOf(node, 'text').byLabel('text');
    assert.equal(textarea.value, '<lora:b:1.00>');
    assert.equal(textarea.getAttribute('placeholder'), LORAS_PLACEHOLDER);
    const serialized = host.serialize(node);
    assert.deepEqual(Object.keys(serialized), ['text', 'loras']);
    assert.deepEqual(host.record.packerrors, []);
    return { text: valueOf(node, 'text'), rows: valueOf(node, 'loras') };
  });

  await test(`R2.${delivery}`, `r4a (${delivery}): typed Loader text merges into rows without rewriting the text; a row edit rewrites it`, async () => {
    const host = createHost({ model: 'r4a', delivery });
    rev10.registerLoraManagerFrontends(host.comfy);
    const node = host.createNode(TYPES.loader, { inputs: loaderInputs() });
    await settle();
    const typed = '<lora:b:0.8> sunset,, glow';
    typeInto(renderOf(node, 'text'), 'text', typed);
    await quiesce();
    assert.equal(valueOf(node, 'text'), typed, 'own merge echo must not rewrite typed text');
    assert.deepEqual(rowsSummary(valueOf(node, 'loras')), ['b:0.8:0.8:on']);
    changeInput(renderOf(node, 'loras'), 'loras.strength.b', '0.5');
    await quiesce();
    assert.equal(valueOf(node, 'text'), '<lora:b:0.50> sunset, glow'); // native applyLoraValuesToText cleanup
    assert.deepEqual(rowsSummary(valueOf(node, 'loras')), ['b:0.50:0.50:on']);
    typeInto(renderOf(node, 'text'), 'text', '<lora:b:0.50> sunset, glow <lora:c:1.2:0.9>');
    await quiesce();
    assert.deepEqual(rowsSummary(valueOf(node, 'loras')), ['b:0.50:0.50:on', 'c:1.2:0.9:on']);
    assert.equal(valueOf(node, 'loras')[1].expanded, true);
    assert.equal(valueOf(node, 'text'), '<lora:b:0.50> sunset, glow <lora:c:1.2:0.9>');
    assert.deepEqual(host.record.packerrors, []);
    return { text: valueOf(node, 'text'), rows: rowsSummary(valueOf(node, 'loras')) };
  });

  await test(`R3.${delivery}`, `r4a (${delivery}): workflow restore re-merges saved text into saved rows without rewriting the text`, async () => {
    const host = createHost({ model: 'r4a', delivery });
    rev10.registerLoraManagerFrontends(host.comfy);
    const savedText = '<lora:a:0.6> <lora:b:1.2:0.9>';
    const savedRows = [{ name: 'a', strength: 0.6, clipStrength: 0.6, active: false, expanded: false }];
    const node = host.createNode(TYPES.loader, { inputs: loaderInputs({ text: savedText, loras: savedRows }) });
    host.configure(node);
    await quiesce();
    assert.equal(valueOf(node, 'text'), savedText);
    assert.deepEqual(rowsSummary(valueOf(node, 'loras')), ['a:0.6:0.6:off', 'b:1.2:0.9:on']);
    assert.ok(renderOf(node, 'loras').byLabel('loras.select.b'), 'restored row b rendered');
    assert.deepEqual(host.record.packerrors, []);
    return { text: valueOf(node, 'text'), rows: rowsSummary(valueOf(node, 'loras')) };
  });

  await test(`R4.${delivery}`, `r4a (${delivery}): Create Hook LoRA text/rows sync and active names`, async () => {
    const host = createHost({ model: 'r4a', delivery });
    const { registered } = rev10.registerLoraManagerFrontends(host.comfy);
    const node = host.createNode(TYPES.hook, { inputs: lorasInputs() });
    assert.deepEqual(slotNames(node), ['prev_hooks']);
    await settle();
    typeInto(renderOf(node, 'text'), 'text', '<lora:c:0.7>');
    await quiesce();
    assert.deepEqual(rowsSummary(valueOf(node, 'loras')), ['c:0.7:0.7:on']);
    assert.deepEqual([...registered.createHook.activeNames(node.node)], ['c']);
    press(renderOf(node, 'loras'), 'loras.active.c');
    await quiesce();
    assert.deepEqual(rowsSummary(valueOf(node, 'loras')), ['c:0.7:0.7:off']);
    assert.equal(valueOf(node, 'text'), '<lora:c:0.70>');
    assert.deepEqual([...registered.createHook.activeNames(node.node)], []);
    assert.deepEqual(host.record.packerrors, []);
    return { text: valueOf(node, 'text'), rows: rowsSummary(valueOf(node, 'loras')) };
  });
}

