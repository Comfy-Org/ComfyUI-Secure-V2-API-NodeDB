await test('R8', 'r4a: comfy.models.list refused (G6): rows still render and sync; the refusal is shown', async () => {
  const host = createHost({ model: 'r4a', refuseModelsList: true });
  rev10.registerLoraManagerFrontends(host.comfy);
  const node = host.createNode(TYPES.loader, { inputs: loaderInputs({ text: '<lora:a:0.6>', loras: [{ name: 'a', strength: 0.6, clipStrength: 0.6, active: true }] }) });
  await quiesce();
  const panel = renderOf(node, 'loras');
  const shownAfterMount = panel.text();
  assert.match(shownAfterMount, /comfy\.models\.list is not a declared path/);
  assert.ok(panel.byLabel('loras.select.a'));
  assert.equal(panel.findAll(element => /^loras\.add\./.test(element.getAttribute('aria-label') ?? '')).length, 0);
  typeInto(renderOf(node, 'text'), 'text', '<lora:a:0.6> <lora:b:1>');
  await quiesce();
  assert.deepEqual(rowsSummary(valueOf(node, 'loras')), ['a:0.6:0.6:on', 'b:1:1:on']);
  // Retained row_editor.js semantics: a value change revalidates the rows and clears the shown error.
  const shownAfterEdit = panel.text();
  assert.doesNotMatch(shownAfterEdit, /not a declared path/);
  assert.deepEqual(host.record.packerrors, []);
  return { shownAfterMount, shownAfterEdit, modelsListCalls: host.record.modelsListCalls };
});

await test('R9', 'r4a: dispose unregisters the widget types and stops the sync', async () => {
  const host = createHost({ model: 'r4a' });
  const { registered } = rev10.registerLoraManagerFrontends(host.comfy);
  const node = host.createNode(TYPES.loader, { inputs: loaderInputs() });
  await settle();
  const outcome = disposeAll(registered);
  assert.deepEqual(outcome, Object.fromEntries(FRONTEND_NAMES.map(name => [name, 'ok'])));
  assert.deepEqual(host.record.unregistered, WIDGET_TYPES);
  assert.equal(host.widgetTypes.size, 0);
  press(renderOf(node, 'loras'), 'loras.add.a.safetensors'); // the mounted editor lives until the node goes
  await quiesce();
  assert.deepEqual(rowsSummary(valueOf(node, 'loras')), ['a:1:1:on']);
  assert.equal(valueOf(node, 'text'), '', 'sync disposed: text not rewritten');
  const later = host.createNode(TYPES.loader, { inputs: loaderInputs() });
  assert.deepEqual(slotNames(later), ['model', 'text', 'loras', 'clip', 'lora_stack']); // types gone: sockets again
  assert.deepEqual(disposeAll(registered), outcome);
  host.remove(node);
  assert.equal(renderOf(node, 'loras').children.length, 0);
  return { unregistered: host.record.unregistered };
});

await test('R10', 'r4a: a reconstructed Stacker lora_stack socket is kept; an incompatible one refuses visibly and wires nothing', async () => {
  const host = createHost({ model: 'r4a' });
  rev10.registerLoraManagerFrontends(host.comfy);
  // A workflow saved by the original carries the frontend-added lora_stack socket; reconstruction restores it first.
  const kept = host.createNode(TYPES.stacker, { inputs: lorasInputs({ tail: [{ name: 'lora_stack', type: 'LORA_STACK', optional: true }] }) });
  assert.deepEqual(kept.slots.map(slot => [slot.name, slot.type]), [['lora_stack', 'LORA_STACK']]);
  const bad = host.createNode(TYPES.stacker, { inputs: lorasInputs({ tail: [{ name: 'lora_stack', type: 'MODEL', optional: true }] }) });
  assert.equal(host.record.packerrors.length, 1);
  assert.equal(host.record.packerrors[0].hook, `onCreated:${TYPES.stacker}`);
  assert.match(host.record.packerrors[0].error, /Existing lora_stack socket is ambiguous\/incompatible/);
  assert.deepEqual(bad.slots.map(slot => [slot.name, slot.type]), [['lora_stack', 'MODEL']]);
  assert.equal(bad.node.serializingWidgets, false);
  await settle();
  typeInto(renderOf(bad, 'text'), 'text', '<lora:a:0.5>');
  await quiesce();
  assert.deepEqual(valueOf(bad, 'loras'), []); // not wired
  return { kept: slotNames(kept), refused: host.record.packerrors[0].error.split('\n')[0] };
});

await test('R11', 'r4a: values shifted by the original autocomplete-metadata slot are refused visibly, not converted or overwritten', async () => {
  // No-migration control. The current original saves the Loader as [{version:1,textWidgetName:'text'}, text, rows]
  // (hidden widget __lm_autocomplete_meta_text). Core places widgets_values by position (host-stack r4a W1), so rev 10's
  // [text, loras] receive the metadata object and the text string. Without the saved array in onConfigured's data there is
  // nothing to migrate from: the shift is refused visibly. The M tests below cover the migration itself.
  const host = createHost({ model: 'r4a' });
  rev10.registerLoraManagerFrontends(host.comfy);
  const meta = { version: 1, textWidgetName: 'text' };
  const shiftedText = '<lora:illustrious_all_rated_v1:0.60> <lora:69yottea_illu_v2:0.40>';
  const node = host.createNode(TYPES.loader, { inputs: loaderInputs({ text: meta, loras: shiftedText }) });
  host.configure(node);
  await quiesce();
  assert.match(renderOf(node, 'text').text(), /LoRA text requires a string within the 262144-byte owned profile/);
  assert.equal(renderOf(node, 'loras').findAll(element => /^loras\.select\./.test(element.getAttribute('aria-label') ?? '')).length, 0);
  assert.deepEqual(valueOf(node, 'text'), meta); // nothing converted or overwritten
  assert.equal(valueOf(node, 'loras'), shiftedText);
  const prompt = host.createNode(TYPES.prompt, { inputs: [{ ...promptInputs()[0], value: meta }, ...promptInputs().slice(1)] });
  assert.match(renderOf(prompt, 'text').text(), /262144-byte owned profile/);
  assert.deepEqual(host.record.packerrors, []);
  return { loaderText: renderOf(node, 'text').text(), rowsRendered: 0 };
});

// =====================================================================================================================
// M: the onConfigured migration of original-format saves (MERVYN m_42dcac33a1), on the pack's own example workflows.
// =====================================================================================================================
const META = Object.freeze({ version: 1, textWidgetName: 'text' });
const sinceLoad = (entry, name) => entry.widgetStates.get(name).writes.slice(entry.placedWrites[name]);
async function resaveIsIdempotent(host, type, inputs, saved, entry) {
  const resave = host.save(entry);
  const again = await host.load(type, { inputs }, { ...saved, widgets_values: resave.widgets_values });
  await quiesce();
  for (const name of Object.keys(again.placedWrites)) assert.deepEqual(sinceLoad(again, name), [], `loading the re-save wrote ${name}`);
  assert.deepEqual(host.save(again).widgets_values, resave.widgets_values, 'a second save equals the first');
  return resave.widgets_values;
}

for (const delivery of ['sync', 'async']) {
  await test(`M1.${delivery}`, `r4a (${delivery}): original-format Loader (Lora_Manager_Basic.json node 56) re-placed by name; re-save idempotent`, async () => {
    const saved = nodeOf(workflows['Lora_Manager_Basic.json'], 56);
    const [meta, text, rows] = saved.widgets_values;
    assert.deepEqual(meta, META);
    const host = createHost({ model: 'r4a', delivery });
    rev10.registerLoraManagerFrontends(host.comfy);
    const entry = await host.load(TYPES.loader, { inputs: loaderInputs() }, saved);
    assert.deepEqual(entry.placed, { text: meta, loras: text }, 'before: core placed by position (the R11 shift)');
    await quiesce();
    assert.equal(valueOf(entry, 'text'), text);
    assert.deepEqual(valueOf(entry, 'loras'), rows, 'after: rows as saved, flags and strengths included');
    assert.deepEqual(sinceLoad(entry, 'loras'), [rows], 'rows written once, never rebuilt from the text');
    assert.deepEqual(sinceLoad(entry, 'text'), [text], 'text written once and not rewritten');
    assert.equal(renderOf(entry, 'text').byLabel('text').value, text);
    assert.doesNotMatch(renderOf(entry, 'text').text(), /owned profile/);
    for (const row of rows) assert.ok(renderOf(entry, 'loras').byLabel('loras.select.' + row.name), 'row rendered: ' + row.name);
    const resaved = await resaveIsIdempotent(host, TYPES.loader, loaderInputs(), saved, entry);
    assert.deepEqual(resaved, [text, rows], 'the next save is the converted layout');
    assert.deepEqual(host.record.packerrors, []);
    return { placedText: entry.placed.text, rows: rowsSummary(valueOf(entry, 'loras')), resaved: resaved.length };
  });

  await test(`M2.${delivery}`, `r4a (${delivery}): original-format Prompts (Lora_Manager_Basic.json nodes 78, 79) re-placed by name; re-save idempotent`, async () => {
    const host = createHost({ model: 'r4a', delivery });
    rev10.registerLoraManagerFrontends(host.comfy);
    const evidence = {};
    for (const id of [78, 79]) {
      const saved = nodeOf(workflows['Lora_Manager_Basic.json'], id);
      const [meta, text] = saved.widgets_values;
      assert.deepEqual(meta, META);
      const entry = await host.load(TYPES.prompt, { inputs: promptInputs() }, saved);
      assert.deepEqual(entry.placed, { text: meta }, 'before: shifted');
      await quiesce();
      assert.equal(valueOf(entry, 'text'), text);
      assert.deepEqual(sinceLoad(entry, 'text'), [text]);
      assert.equal(renderOf(entry, 'text').byLabel('text').value, text);
      assert.deepEqual(await resaveIsIdempotent(host, TYPES.prompt, promptInputs(), saved, entry), [text]);
      evidence[id] = text.length;
    }
    assert.deepEqual(host.record.packerrors, []);
    return { textLengths: evidence };
  });

  await test(`M3.${delivery}`, `r4a (${delivery}): current-format Stacker (derived: nunchaku-flux.1-dev.json node 55 with the metadata slot) re-placed`, async () => {
    // The pack's examples hold no current-format Stacker; this prepends the original's metadata value to its older save.
    const older = nodeOf(workflows['nunchaku-flux.1-dev.json'], 55);
    const [text, rows] = older.widgets_values;
    const saved = { ...older, widgets_values: [{ ...META }, text, rows] };
    const host = createHost({ model: 'r4a', delivery });
    rev10.registerLoraManagerFrontends(host.comfy);
    const entry = await host.load(TYPES.stacker, { inputs: lorasInputs() }, saved);
    assert.deepEqual(entry.placed, { text: META, loras: text });
    await quiesce();
    const expected = normalizeRows(mergeLoras(text, normalizeRows(rows))); // the native load re-merge of the saved rows
    assert.equal(valueOf(entry, 'text'), text);
    assert.deepEqual(valueOf(entry, 'loras'), expected);
    assert.deepEqual(sinceLoad(entry, 'loras'), [expected], 'rows written once');
    assert.deepEqual(rowsSummary(expected), ['FLUX.1-Turbo-Alpha:1:1:on']);
    assert.deepEqual(await resaveIsIdempotent(host, TYPES.stacker, lorasInputs(), saved, entry), [text, expected]);
    assert.deepEqual(host.record.packerrors, []);
    return { rows: rowsSummary(expected) };
  });

  await test(`M4.${delivery}`, `r4a (${delivery}): older-format saves (nunchaku-flux.1-dev.json Loader 48, Stacker 55) are not migrated`, async () => {
    const host = createHost({ model: 'r4a', delivery });
    rev10.registerLoraManagerFrontends(host.comfy);
    const evidence = {};
    for (const [id, type, inputs] of [[48, TYPES.loader, loaderInputs()], [55, TYPES.stacker, lorasInputs()]]) {
      const saved = nodeOf(workflows['nunchaku-flux.1-dev.json'], id);
      const [text, rows] = saved.widgets_values;
      const entry = await host.load(type, { inputs }, saved);
      assert.deepEqual(entry.placed, { text, loras: rows }, 'aligned as placed');
      await quiesce();
      assert.equal(valueOf(entry, 'text'), text);
      assert.deepEqual(sinceLoad(entry, 'text'), [], 'the text is never written');
      // Only the existing re-merge applies (the native loadedGraphNode merge): row strengths win over the text's.
      assert.deepEqual(valueOf(entry, 'loras'), normalizeRows(mergeLoras(text, normalizeRows(rows))));
      await resaveIsIdempotent(host, type, inputs, saved, entry);
      evidence[id] = rowsSummary(valueOf(entry, 'loras'));
    }
    assert.deepEqual(host.record.packerrors, []);
    return evidence;
  });
}

await test('M5', 'live: the migration is inert (no widget types): original-format saves load as sockets without errors', async () => {
  const host = createHost({ model: 'live' });
  rev10.registerLoraManagerFrontends(host.comfy);
  const loader = await host.load(TYPES.loader, { inputs: loaderInputs() }, nodeOf(workflows['Lora_Manager_Basic.json'], 56));
  const prompt = await host.load(TYPES.prompt, { inputs: promptInputs() }, nodeOf(workflows['Lora_Manager_Basic.json'], 78));
  await quiesce();
  assert.deepEqual(loader.node.widgets.names(), []);
  assert.deepEqual(prompt.node.widgets.names(), []);
  assert.deepEqual(slotNames(loader), ['model', 'text', 'loras', 'clip', 'lora_stack']);
  assert.deepEqual(slotNames(prompt), ['text', 'clip', 'trigger_words1']);
  assert.deepEqual(host.record.packerrors, []);
  return { loader: slotNames(loader), prompt: slotNames(prompt) };
});

await test('M6', 'r4a: near-miss layouts are not migrated: left as placed and refused visibly', async () => {
  const saved = nodeOf(workflows['Lora_Manager_Basic.json'], 56);
  const [, text, rows] = saved.widgets_values;
  const variants = {
    version2: [{ version: 2, textWidgetName: 'text' }, text, rows],
    noTextWidgetName: [{ version: 1 }, text, rows],
    numericTextWidgetName: [{ version: 1, textWidgetName: 7 }, text, rows],
    extraKey: [{ version: 1, textWidgetName: 'text', extra: true }, text, rows],
    twoValues: [{ ...META }, text],
    rowsNotArray: [{ ...META }, text, 'rows'],
  };
  const host = createHost({ model: 'r4a' });
  rev10.registerLoraManagerFrontends(host.comfy);
  for (const [name, values] of Object.entries(variants)) {
    const entry = await host.load(TYPES.loader, { inputs: loaderInputs() }, { ...saved, widgets_values: values });
    await quiesce();
    assert.deepEqual(valueOf(entry, 'text'), values[0], name + ': text left as placed');
    assert.deepEqual(sinceLoad(entry, 'text'), [], name);
    assert.deepEqual(sinceLoad(entry, 'loras'), [], name);
    assert.match(renderOf(entry, 'text').text(), /262144-byte owned profile/, name + ': refused visibly');
  }
  assert.deepEqual(host.record.packerrors, []);
  return { variants: Object.keys(variants) };
});

// =====================================================================================================================
// H, X, V (r3, review LORA10-B1): Create Hook LoRA, Text and WanVideo Lora Select saved layouts.
// The pack's examples hold no current-format save of these nodes. The layouts are the source-proven ones: the original's
// widget factory puts the metadata slot before every autocomplete text (lora-manager-widgets.js 16723-16758, 16852-16860).
// The values are real saved values, so these fixtures are disclosed as derived, like M3:
// - Basic Loader node 56's text and rows;
// - Basic Prompt node 78's text;
// - the Wan example node 107's text and rows.
// The Wan example itself (an older original, before merge_loras) is a real negative case.
// =====================================================================================================================
const BASIC_56 = nodeOf(workflows['Lora_Manager_Basic.json'], 56).widgets_values;
const BASIC_TEXT = BASIC_56[1], BASIC_ROWS = BASIC_56[2];
const PROMPT_TEXT = nodeOf(workflows['Lora_Manager_Basic.json'], 78).widgets_values[1];
const WAN_107 = nodeOf(workflows['wanvideo_1_3B_control_lora_example_01.json'], 107);
const [WAN_LOW_MEM, WAN_TEXT, WAN_ROWS] = WAN_107.widgets_values;
const derived = (type, widgets_values) => ({ id: 900, type, widgets_values });
const textInputs = () => [promptInputs()[0]];
const loraRows = (text, rows) => normalizeRows(mergeLoras(text, normalizeRows(rows))); // the LORAS widget's native load merge
// r4: the original Hook loadedGraphNode (create_hook_lora.js 117-135) merges the raw saved array (getWidgetSerializedValue
// reads widgets_values) and assigns the result through the shared LORAS setter (loras_widget.js 812-834).
const hookRows = (text, rows) => normalizeRows(mergeLoras(text, rows));
const noWrites = (entry, label) => { for (const name of Object.keys(entry.placedWrites)) assert.deepEqual(sinceLoad(entry, name), [], `${label}: ${name} written`); };

for (const delivery of ['sync', 'async']) {
  await test(`H1.${delivery}`, `r4a (${delivery}): Create Hook LoRA, original layout [meta, text, rows] (derived): restored by onConfigured with the native merge; re-save idempotent`, async () => {
    const host = createHost({ model: 'r4a', delivery });
    const { registered } = rev10.registerLoraManagerFrontends(host.comfy);
    const saved = derived(TYPES.hook, [{ ...META }, BASIC_TEXT, BASIC_ROWS]);
    const entry = await host.load(TYPES.hook, { inputs: lorasInputs() }, saved);
    assert.deepEqual(entry.placed, { text: META, loras: BASIC_TEXT }, 'before: shifted by core');
    await quiesce();
    const expected = hookRows(BASIC_TEXT, BASIC_ROWS); // r4 correction: through the LORAS setter, not raw mergeLoras
    assert.deepEqual(expected, BASIC_ROWS, 'these saved rows are already setter-normal, so they round-trip exactly');
    assert.equal(valueOf(entry, 'text'), BASIC_TEXT);
    assert.deepEqual(valueOf(entry, 'loras'), expected);
    assert.deepEqual(sinceLoad(entry, 'loras'), [expected], 'rows written once, from the saved rows');
    assert.deepEqual(sinceLoad(entry, 'text'), [BASIC_TEXT], 'text written once');
    assert.deepEqual([...registered.createHook.activeNames(entry.node)], BASIC_ROWS.filter(row => row.active).map(row => row.name));
    assert.deepEqual(slotNames(entry), ['prev_hooks']);
    assert.deepEqual(await resaveIsIdempotent(host, TYPES.hook, lorasInputs(), saved, entry), [BASIC_TEXT, expected]);
    assert.deepEqual(host.record.packerrors, []);
    return { rows: rowsSummary(expected) };
  });

  await test(`H2.${delivery}`, `r4a (${delivery}): Create Hook LoRA, older/converted layout [text, rows]: not migrated; the native load merge still runs`, async () => {
    const host = createHost({ model: 'r4a', delivery });
    rev10.registerLoraManagerFrontends(host.comfy);
    // r4: rows without `locked`, as older saves have (the nunchaku example's rows lack it too), so the setter must
    // normalize them. rev 10's own already-normal saves need no write; every re-save idempotence check covers that.
    const olderRows = BASIC_ROWS.map(({ locked, ...row }) => row);
    const saved = derived(TYPES.hook, [BASIC_TEXT, olderRows]);
    const entry = await host.load(TYPES.hook, { inputs: lorasInputs() }, saved);
    assert.deepEqual(entry.placed, { text: BASIC_TEXT, loras: olderRows }, 'aligned as placed');
    await quiesce();
    const expected = hookRows(BASIC_TEXT, olderRows);
    assert.deepEqual(expected, BASIC_ROWS, 'the setter adds locked:false and changes nothing else');
    assert.deepEqual(valueOf(entry, 'loras'), expected);
    assert.deepEqual(sinceLoad(entry, 'text'), [], 'the text is never written');
    assert.deepEqual(sinceLoad(entry, 'loras'), [expected], 'the native merge writes once');
    await resaveIsIdempotent(host, TYPES.hook, lorasInputs(), saved, entry);
    assert.deepEqual(host.record.packerrors, []);
    return { rows: rowsSummary(expected) };
  });

  await test(`H3.${delivery}`, `r4a (${delivery}): Create Hook LoRA near-miss layouts are left as placed (no writes) and refused visibly`, async () => {
    const host = createHost({ model: 'r4a', delivery });
    rev10.registerLoraManagerFrontends(host.comfy);
    const variants = {
      version2: [{ version: 2, textWidgetName: 'text' }, BASIC_TEXT, BASIC_ROWS],
      extraKey: [{ ...META, extra: true }, BASIC_TEXT, BASIC_ROWS],
      twoValues: [{ ...META }, BASIC_TEXT],
      rowsNotArray: [{ ...META }, BASIC_TEXT, 'rows'],
    };
    for (const [name, values] of Object.entries(variants)) {
      const entry = await host.load(TYPES.hook, { inputs: lorasInputs() }, derived(TYPES.hook, values));
      await quiesce();
      noWrites(entry, name);
      assert.deepEqual(valueOf(entry, 'text'), values[0], name + ': left as placed');
      assert.match(renderOf(entry, 'text').text(), /262144-byte owned profile/, name + ': refused visibly');
    }
    assert.deepEqual(host.record.packerrors, []);
    return { variants: Object.keys(variants) };
  });

  await test(`X1.${delivery}`, `r4a (${delivery}): Text, original layout [meta, text] (derived): text restored by name; re-save idempotent`, async () => {
    const host = createHost({ model: 'r4a', delivery });
    rev10.registerLoraManagerFrontends(host.comfy);
    const saved = derived(TYPES.text, [{ ...META }, PROMPT_TEXT]);
    const entry = await host.load(TYPES.text, { inputs: textInputs() }, saved);
    assert.deepEqual(entry.placed, { text: META }, 'before: shifted by core');
    await quiesce();
    assert.equal(valueOf(entry, 'text'), PROMPT_TEXT);
    assert.deepEqual(sinceLoad(entry, 'text'), [PROMPT_TEXT]);
    assert.equal(renderOf(entry, 'text').byLabel('text').value, PROMPT_TEXT);
    assert.deepEqual(await resaveIsIdempotent(host, TYPES.text, textInputs(), saved, entry), [PROMPT_TEXT]);
    assert.deepEqual(host.record.packerrors, []);
    return { textLength: PROMPT_TEXT.length };
  });

  await test(`V1.${delivery}`, `r4a (${delivery}): WanVideo Lora Select, original layout [low_mem_load, merge_loras, meta, text, rows] (derived): BOOLEANs kept, text and rows restored with the native merge; re-save idempotent`, async () => {
    const host = createHost({ model: 'r4a', delivery });
    rev10.registerLoraManagerFrontends(host.comfy);
    const saved = derived(TYPES.wan, [WAN_LOW_MEM, true, { ...META }, WAN_TEXT, WAN_ROWS]);
    const entry = await host.load(TYPES.wan, { inputs: wanInputs() }, saved);
    assert.deepEqual(entry.placed, { low_mem_load: WAN_LOW_MEM, merge_loras: true, text: META, loras: WAN_TEXT }, 'before: BOOLEANs placed, the rest shifted');
    await quiesce();
    const expected = loraRows(WAN_TEXT, WAN_ROWS); // wanvideo_lora_select.js 117-132 through the LORAS setter
    assert.deepEqual([valueOf(entry, 'low_mem_load'), valueOf(entry, 'merge_loras')], [WAN_LOW_MEM, true]);
    assert.deepEqual(sinceLoad(entry, 'low_mem_load'), [], 'BOOLEAN prefix not touched');
    assert.deepEqual(sinceLoad(entry, 'merge_loras'), [], 'BOOLEAN prefix not touched');
    assert.equal(valueOf(entry, 'text'), WAN_TEXT);
    assert.deepEqual(valueOf(entry, 'loras'), expected);
    assert.deepEqual(sinceLoad(entry, 'loras'), [expected], 'rows written once');
    assert.deepEqual(sinceLoad(entry, 'text'), [WAN_TEXT], 'text written once');
    assert.deepEqual(await resaveIsIdempotent(host, TYPES.wan, wanInputs(), saved, entry), [WAN_LOW_MEM, true, WAN_TEXT, expected]);
    assert.deepEqual(host.record.packerrors, []);
    return { rows: rowsSummary(expected) };
  });

  await test(`V2.${delivery}`, `r4a (${delivery}): WanVideo Lora Select, converted layout [low_mem_load, merge_loras, text, rows]: not migrated; the native load merge still runs`, async () => {
    const host = createHost({ model: 'r4a', delivery });
    rev10.registerLoraManagerFrontends(host.comfy);
    const saved = derived(TYPES.wan, [WAN_LOW_MEM, false, WAN_TEXT, WAN_ROWS]);
    const entry = await host.load(TYPES.wan, { inputs: wanInputs() }, saved);
    assert.deepEqual(entry.placed, { low_mem_load: WAN_LOW_MEM, merge_loras: false, text: WAN_TEXT, loras: WAN_ROWS }, 'aligned as placed');
    await quiesce();
    const expected = loraRows(WAN_TEXT, WAN_ROWS);
    assert.deepEqual(sinceLoad(entry, 'text'), [], 'the text is never written');
    assert.deepEqual(sinceLoad(entry, 'loras'), [expected], 'the native merge writes once');
    await resaveIsIdempotent(host, TYPES.wan, wanInputs(), saved, entry);
    assert.deepEqual(host.record.packerrors, []);
    return { rows: rowsSummary(expected) };
  });
}

// r4 (review of r3): Hook rows go through the shared LORAS setter's normalization on every write. The expected rows below
// are written out by hand from the setter (loras_widget.js 812-834), not computed with the code under test.
const H5_TEXT = '<lora:a:1> <lora:b:0.8> <lora:c:0.7:0.4> <lora:d:1.0:0.6>';
const H5_SAVED_ROWS = [
  { name: 'a', strength: 1, clipStrength: 0, active: true },                                 // zero clip strength
  { name: 'b', strength: 0.5, clipStrength: 0.5, active: false, expanded: false },           // duplicate: first
  { name: 'b', strength: 0.8, clipStrength: 0.8, active: true },                             // duplicate: last, kept
  { name: 'c', strength: 0.7, clipStrength: 0.4, active: true },                             // no expanded: merge sets false
];
const H5_EXPECTED = [ // a, d: clipStrength || strength; b: the last duplicate; d (text only): expanded = clip != strength; locked: false
  { name: 'a', strength: 1, active: true, expanded: false, clipStrength: 1, selected: false, locked: false },
  { name: 'b', strength: 0.8, active: true, expanded: false, clipStrength: 0.8, selected: false, locked: false },
  { name: 'c', strength: 0.7, active: true, expanded: false, clipStrength: 0.4, selected: false, locked: false },
  { name: 'd', strength: 1, active: true, clipStrength: 0.6, selected: false, expanded: true, locked: false },
];
for (const delivery of ['sync', 'async']) {
  await test(`H5.${delivery}`, `r4a (${delivery}): Create Hook restore normalizes like the original LORAS setter: zero clip strength, last duplicate, default expanded, locked:false; re-save idempotent`, async () => {
    const host = createHost({ model: 'r4a', delivery });
    rev10.registerLoraManagerFrontends(host.comfy);
    assert.deepEqual(hookRows(H5_TEXT, H5_SAVED_ROWS), H5_EXPECTED, 'the hand-written setter result');
    const saved = derived(TYPES.hook, [{ ...META }, H5_TEXT, H5_SAVED_ROWS]);
    const entry = await host.load(TYPES.hook, { inputs: lorasInputs() }, saved);
    await quiesce();
    assert.equal(valueOf(entry, 'text'), H5_TEXT);
    assert.deepEqual(valueOf(entry, 'loras'), H5_EXPECTED);
    assert.equal(valueOf(entry, 'loras')[0].clipStrength, 1, 'a saved clipStrength 0 restores as the strength, not 0');
    assert.deepEqual(sinceLoad(entry, 'loras'), [H5_EXPECTED], 'rows written once');
    assert.deepEqual(await resaveIsIdempotent(host, TYPES.hook, lorasInputs(), saved, entry), [H5_TEXT, H5_EXPECTED]);
    // The converted save of the same rows takes the same path (no migration) and restores identically.
    const converted = await host.load(TYPES.hook, { inputs: lorasInputs() }, derived(TYPES.hook, [H5_TEXT, H5_SAVED_ROWS]));
    await quiesce();
    assert.deepEqual(valueOf(converted, 'loras'), H5_EXPECTED);
    assert.deepEqual(host.record.packerrors, []);
    return { rows: rowsSummary(H5_EXPECTED) };
  });

  await test(`H6.${delivery}`, `r4a (${delivery}): Create Hook text edits also write setter-normal rows (<lora:e:1:0> gives clipStrength 1, locked:false)`, async () => {
    const host = createHost({ model: 'r4a', delivery });
    rev10.registerLoraManagerFrontends(host.comfy);
    const node = host.createNode(TYPES.hook, { inputs: lorasInputs() });
    await settle();
    typeInto(renderOf(node, 'text'), 'text', '<lora:e:1:0>');
    await quiesce();
    assert.deepEqual(valueOf(node, 'loras'), [{ name: 'e', strength: 1, active: true, clipStrength: 1, selected: false, expanded: false, locked: false }]);
    assert.equal(valueOf(node, 'text'), '<lora:e:1:0>', 'the typed text is not rewritten');
    assert.deepEqual(host.record.packerrors, []);
    return { rows: rowsSummary(valueOf(node, 'loras')) };
  });
}

