"""ORIGINAL side for Ovi WSL x86 CPU r1: the untouched 088128b nodes OviMMAudioVAELoader.loadmodel, WanVideoEncodeOviAudio.decode
and WanVideoDecodeOviAudio.decode. Every Ovi module is checked against PRISTINE_GIT_BINDINGS, and both checkpoints against CASE.

Each case gets a fresh seeded load (INPUT_TYPES first, as the UI does):
- loader cases: the returned FeaturesUtils is recorded tensor by tensor;
- encode/decode cases: the authored input feeds the consumer node; the output is recorded exactly, or the original's own error.
  Decode cases also tap the VAE decoder and the vocoder (findings only) and repeat the call on the same object as a determinism
  control.
Torch runs with one thread; the numeric environment is recorded. RNG (torch, NumPy, Python) is recorded after the seed, the
loader and the case.
"""
import gc
import json
import os
from pathlib import Path
import sys
import time
import traceback

sys.path.insert(0, '/prepared')
import common  # noqa: E402
import ovi_common  # noqa: E402

REPORT = {'status': 'RUNNING', 'route': 'original_native', 'cases': {}}
phase = common.Phases(REPORT, 'ORIGINAL')
OVI_MODULES = ('Ovi.nodes_ovi', 'Ovi.mel_converter', 'Ovi.vae.autoencoder', 'Ovi.vae.vae', 'Ovi.vae.vae_modules', 'Ovi.vae.edm2_utils',
               'Ovi.vae.distributions', 'Ovi.bigvgan.bigvgan', 'Ovi.bigvgan.models', 'Ovi.bigvgan.activations',
               'Ovi.bigvgan.alias_free_torch.act', 'Ovi.bigvgan.alias_free_torch.filter', 'Ovi.bigvgan.alias_free_torch.resample')


def main():
    case_file = common.load_json('/prepared/CASE.json')
    phase('setup')
    sys.path[:0] = ['/native-site', '/native-core', '/original']
    from comfy.cli_args import args, LatentPreviewMethod
    args.cpu = True
    args.disable_dynamic_vram = True
    args.preview_method = LatentPreviewMethod.NoPreviews
    import torch
    torch.set_num_threads(1)
    import folder_paths
    for setter, name in [('set_user_directory', 'user'), ('set_input_directory', 'input'),
                         ('set_output_directory', 'output'), ('set_temp_directory', 'temp')]:
        path = Path('/tmp/original-' + name)
        path.mkdir(parents=True, exist_ok=True)
        getattr(folder_paths, setter)(str(path))
    folder_paths.folder_names_and_paths['vae'] = (['/models/vae'], set(folder_paths.supported_pt_extensions))
    folder_paths.filename_list_cache.pop('vae', None)
    import asyncio
    import server
    from app.assets.manager import default_asset_manager
    args.front_end_root = '/tmp/original-headless-web'
    Path(args.front_end_root).mkdir(exist_ok=True)
    loop = asyncio.new_event_loop()
    asyncio.set_event_loop(loop)
    server.PromptServer(loop, default_asset_manager())
    REPORT['versions'] = common.versions(case_file['vendor_versions'])
    REPORT['cpu'] = {'torch': torch.__version__, 'threads': torch.get_num_threads(), 'capability': torch.backends.cpu.get_cpu_capability()}
    REPORT['numeric_env'] = ovi_common.numeric_env()
    import importlib
    bound = {row['path']: row['sha256'] for row in common.load_json('/original/PRISTINE_GIT_BINDINGS.json')['files']}
    modules = {}
    REPORT['original_module_sha256'] = {}
    for name in OVI_MODULES:
        module = importlib.import_module('wan_original.' + name)
        rel = os.path.relpath(module.__file__, '/original/wan_original')
        digest = common.sha_file(module.__file__)
        assert digest == bound[rel], rel
        REPORT['original_module_sha256'][rel] = digest
        modules[name] = module
    import torchaudio
    REPORT['torchaudio'] = {'version': torchaudio.__version__, 'file': os.path.relpath(torchaudio.__file__, '/')}
    REPORT['models'] = {}
    for key, spec in case_file['models'].items():
        assert os.path.getsize(spec['container_path']) == spec['bytes'], key
        REPORT['models'][key] = common.sha_file(spec['container_path'])
    nodes = modules['Ovi.nodes_ovi']
    classes = {'OviMMAudioVAELoader': nodes.OviMMAudioVAELoader, 'WanVideoEncodeOviAudio': nodes.WanVideoEncodeOviAudio,
               'WanVideoDecodeOviAudio': nodes.WanVideoDecodeOviAudio}
    assert all(nodes.NODE_CLASS_MAPPINGS[name] is cls for name, cls in classes.items())
    for case in case_file['cases']:
        name = case['name']
        phase('original-' + name)
        ovi_common.seed_all(case['seed'])
        record = {'rng_after_seed': ovi_common.rng_state()}
        started = time.monotonic()
        loader_cls = classes['OviMMAudioVAELoader']
        loader_cls.INPUT_TYPES()
        model, = loader_cls().loadmodel(vae=case_file['models']['vae']['catalogue_name'],
                                        vocoder=case_file['models']['vocoder']['catalogue_name'], precision=case['precision'])
        record['rng_after_loader'] = ovi_common.rng_state()
        if case['item'] == 'loader':
            record['model'] = ovi_common.module_meta(model)
        else:
            inputs = ovi_common.inputs_for(case)
            record['inputs'] = ovi_common.inputs_meta(inputs)
            node = classes[case['node']]()
            handles, taps = (ovi_common.decode_taps(model, 'original', name) if case.get('taps') else ([], {}))
            try:
                result = node.decode(mmaudio_vae=model, **inputs)
                record['outcome'] = {'raised': False}
                record['outputs'] = ovi_common.output_meta(case['node'], result, 'original', name)
            except Exception as error:
                result = None
                record['outcome'] = ovi_common.error_outcome(error)
                del error
            finally:
                for handle in handles:
                    handle.remove()
            record['taps'] = taps
            if case.get('repeat') and result is not None:
                captured = ovi_common.rng_state()
                second = node.decode(mmaudio_vae=model, **inputs)
                record['repeat_identical'] = ovi_common.same_output(result, second)
                record['repeat_rng_unchanged'] = ovi_common.rng_state() == captured
                del second
            del result, inputs
        record['rng_after_case'] = ovi_common.rng_state()
        record['seconds'] = round(time.monotonic() - started, 3)
        REPORT['cases'][name] = record
        del model
        gc.collect()
    REPORT['numeric_env_final'] = ovi_common.numeric_env()
    REPORT['status'] = 'ORIGINAL_OVI_DONE'


try:
    main()
except BaseException:
    REPORT['status'] = 'FAIL'
    REPORT['traceback'] = traceback.format_exc()
    print(REPORT['traceback'], file=sys.stderr)
finally:
    REPORT['pid'] = os.getpid()
    REPORT['proc_memory_final'] = common.proc_memory()
    common.save('ORIGINAL_RESULT.json', REPORT)
    print(json.dumps({'status': REPORT['status']}))
if REPORT['status'] != 'ORIGINAL_OVI_DONE':
    raise SystemExit(1)
