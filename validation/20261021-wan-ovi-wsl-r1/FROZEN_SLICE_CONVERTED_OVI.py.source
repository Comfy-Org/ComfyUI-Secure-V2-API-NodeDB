"""CONVERTED side for Ovi WSL x86 CPU r1: the registered candidate nodes OviMMAudioVAELoader, WanVideoEncodeOviAudio and
WanVideoDecodeOviAudio on the SDK in-process route.

Each case starts from a fresh seed:
- loader cases: the node returns its digest-bound recipe. A harness probe then runs the converted rebuild_ovi(recipe), the same
  function the consumer nodes use, on the same dispatch path. It returns only the module meta. The RNG is recorded after the node
  and after the probe; the probe must leave it unchanged (preserve_rng).
- encode/decode cases: the loader recipe feeds the consumer node with the same authored input as the original role. The output
  or the raised error is recorded exactly. Decode cases repeat the node call (determinism control). Tap cases then rebuild the
  model in a probe, run the node's own decode expression with passive hooks (findings only) and record whether the probe output
  equals the node output.
The numeric environment is recorded at top level and inside a dispatch scope. Module digests of the converted Ovi files are
recorded for the comparator.
"""
import asyncio
import gc
import inspect
import json
import os
from pathlib import Path
import sys
import time
import traceback

sys.path.insert(0, '/prepared')
import common  # noqa: E402
import ovi_common  # noqa: E402

CASE_FILE = common.load_json('/prepared/CASE.json')
PACKAGE = CASE_FILE['package']
PACKAGE_ROOT = '/candidate/%s/' % PACKAGE
LABEL = 'CONVERTED'
REPORT = {'status': 'RUNNING', 'route': 'registered_inprocess_sdk', 'package': PACKAGE, 'cases': {}}
phase = common.Phases(REPORT, LABEL)


async def run(case_file):
    import importlib
    import torch
    from comfy_api.latest import _sdk, io
    package = importlib.import_module(PACKAGE)
    registry = package.NODE_CLASS_MAPPINGS
    REPORT['registered_count'] = len(registry)
    REPORT['module_sha256'] = {rel: common.sha_file(PACKAGE_ROOT + rel) for rel in case_file['converted_module_pins']}
    runtime_module = importlib.import_module(PACKAGE + '.secure_ovi_runtime')
    assert runtime_module.__file__.startswith(PACKAGE_ROOT), runtime_module.__file__
    providers = _sdk.providers
    assert not providers.overlay_active and not providers.engaged
    counter = iter(range(1, 1000))

    async def dispatch(cls, inputs, call):
        plan = _sdk.ExecutionPlan(prompt_id='jack-wan-ovi-wsl-r1', node_id=str(next(counter)), node_type=cls.__name__,
                                  node_module=cls.__module__, tier='default', inputs=inputs,
                                  input_mode='refs' if cls.SDK_REFS else 'values', permissions=tuple(cls.SDK_PERMISSIONS))
        refs = providers.ref_resolver_factory()
        scope = _sdk.bind_runtime(refs, providers.ctx_provider.build(plan), providers.ops_provider)
        try:
            values = await _sdk.wrap_inputs(refs, inputs) if cls.SDK_REFS else inputs

            async def local_call():
                with scope:
                    value = call(values)
                    if inspect.isawaitable(value):
                        value = await value
                    return value
            result = await providers.execution_backend.dispatch(plan, local_call, scope.runtime)
            result = await _sdk.unwrap_outputs(refs, result)
            assert result.ui is None and result.expand is None and result.block_execution is None
            return tuple(result.result)
        finally:
            refs.clear()

    async def node(name, inputs):
        cls = registry[name]
        assert cls.SDK_REFS is False and tuple(cls.SDK_PERMISSIONS) == ('raw', 'assets'), name
        return await dispatch(cls, inputs, lambda values: cls.execute(**values))

    async def scope_env(values):
        return io.NodeOutput(ovi_common.numeric_env())
    REPORT['numeric_env_in_scope'] = (await dispatch(registry['OviMMAudioVAELoader'], {}, scope_env))[0]

    async def probe_model(recipe):
        async def rebuild(values):
            model = await runtime_module.rebuild_ovi(values['recipe'])
            meta = ovi_common.module_meta(model)
            del model
            return io.NodeOutput(meta)
        return (await dispatch(registry['OviMMAudioVAELoader'], {'recipe': recipe}, rebuild))[0]

    async def probe_decode_taps(recipe, inputs, name):
        async def tapped(values):
            model = await runtime_module.rebuild_ovi(values['recipe'])
            handles, taps = ovi_common.decode_taps(model, 'converted', name)
            try:
                latents = values['samples']['latent_ovi_audio']
                waveform = model.wrapped_decode(latents.to(device=torch.device('cpu'), dtype=model.dtype))
                output = common.tensor_meta(waveform.cpu().float())
            finally:
                for handle in handles:
                    handle.remove()
            del model
            return io.NodeOutput({'taps': taps, 'waveform': output})
        return (await dispatch(registry['WanVideoDecodeOviAudio'], dict(inputs, recipe=recipe), tapped))[0]

    models = case_file['models']
    for case in case_file['cases']:
        name = case['name']
        phase('converted-' + name)
        ovi_common.seed_all(case['seed'])
        record = {'rng_after_seed': ovi_common.rng_state()}
        started = time.monotonic()
        recipe, = await node('OviMMAudioVAELoader', {'vae': models['vae']['catalogue_name'], 'vocoder': models['vocoder']['catalogue_name'],
                                                     'precision': case['precision']})
        record['rng_after_loader'] = ovi_common.rng_state()
        record['recipe'] = recipe
        if case['item'] == 'loader':
            record['model'] = await probe_model(recipe)
            record['rng_after_probe'] = ovi_common.rng_state()
        else:
            inputs = ovi_common.inputs_for(case)
            record['inputs'] = ovi_common.inputs_meta(inputs)
            try:
                result = await node(case['node'], dict(inputs, mmaudio_vae=recipe))
                record['outcome'] = {'raised': False}
                record['outputs'] = ovi_common.output_meta(case['node'], result, 'converted', name)
            except Exception as error:
                result = None
                record['outcome'] = ovi_common.error_outcome(error)
                del error
            if case.get('repeat') and result is not None:
                captured = ovi_common.rng_state()
                second = await node(case['node'], dict(inputs, mmaudio_vae=recipe))
                record['repeat_identical'] = ovi_common.same_output(result, second)
                record['repeat_rng_unchanged'] = ovi_common.rng_state() == captured
                del second
            record['taps'] = {}
            if case.get('taps') and result is not None:
                captured = ovi_common.rng_state()
                tapped = await probe_decode_taps(recipe, inputs, name)
                record['taps'] = tapped['taps']
                record['tap_probe_output_equals_node'] = tapped['waveform'] == {
                    k: v for k, v in record['outputs']['waveform'].items() if k != 'raw_file'}
                record['tap_probe_rng_unchanged'] = ovi_common.rng_state() == captured
            del result, inputs
        record['rng_after_case'] = ovi_common.rng_state()
        record['seconds'] = round(time.monotonic() - started, 3)
        REPORT['cases'][name] = record
        gc.collect()
    REPORT['numeric_env_final'] = ovi_common.numeric_env()
    REPORT['status'] = LABEL + '_OVI_DONE'


def main():
    phase('setup')
    sys.path[:0] = ['/native-site', '/converted-site', '/native-core', '/candidate']
    from comfy.cli_args import args
    args.cpu = True
    args.disable_dynamic_vram = True
    import torch
    torch.set_num_threads(1)
    import folder_paths
    for setter, name in [('set_user_directory', 'user'), ('set_input_directory', 'input'),
                         ('set_output_directory', 'output'), ('set_temp_directory', 'temp')]:
        path = Path('/tmp/converted-' + name)
        path.mkdir(parents=True, exist_ok=True)
        getattr(folder_paths, setter)(str(path))
    folder_paths.folder_names_and_paths['vae'] = (['/models/vae'], set(folder_paths.supported_pt_extensions))
    folder_paths.filename_list_cache.pop('vae', None)
    REPORT['versions'] = common.versions(CASE_FILE['vendor_versions'])
    REPORT['cpu'] = {'torch': torch.__version__, 'threads': torch.get_num_threads(), 'capability': torch.backends.cpu.get_cpu_capability()}
    REPORT['numeric_env'] = ovi_common.numeric_env()
    import torchaudio
    REPORT['torchaudio'] = {'version': torchaudio.__version__, 'file': os.path.relpath(torchaudio.__file__, '/')}
    asyncio.run(run(CASE_FILE))


try:
    main()
except BaseException:
    REPORT['status'] = 'FAIL'
    REPORT['traceback'] = traceback.format_exc()
    print(REPORT['traceback'], file=sys.stderr)
finally:
    REPORT['pid'] = os.getpid()
    REPORT['proc_memory_final'] = common.proc_memory()
    common.save(LABEL + '_RESULT.json', REPORT)
    print(json.dumps({'status': REPORT['status']}))
if REPORT['status'] != LABEL + '_OVI_DONE':
    raise SystemExit(1)
