{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "paths": {
      "/comfy/api/v2.js": ["./types/comfy-runtime.d.ts"]
    },
    "skipLibCheck": true,
    "target": "ES2023"
  },
  "include": ["web/**/*.js", "types/**/*.d.ts"]
}
