{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "baseUrl": ".",
    "paths": {
      "/comfy/api/v2.js": ["lib/comfy-v2.d.ts"]
    },
    "skipLibCheck": true,
    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noFallthroughCasesInSwitch": true,
    "allowJs": true,
    "verbatimModuleSyntax": true,
    /* Accounting for JS files in Comfy */
    /* Notably, draggableList.js */
    "noUnusedParameters": false,
    "noImplicitAny": false
  },
  "include": [
    "comfy-api.d.ts",
    "global.d.ts",
    "lib/**/*",
  ],
}
